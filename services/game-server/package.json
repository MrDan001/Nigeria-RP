    "test:stage5": "node scripts/assemble-server.mjs && tsx src/test-stage5.ts",
    "test:stage6": "node scripts/assemble-server.mjs && tsx src/test-stage6.ts",
    "test:stage7": "node scripts/assemble-server.mjs && tsx src/test-stage7.ts",
    "test:stage8": "node scripts/assemble-server.mjs && tsx src/test-stage8.ts",
    "test:stage9": "node scripts/assemble-server.mjs && tsx src/test-stage9.ts",
    "test:stage10": "node scripts/assemble-server.mjs && tsx src/test-stage10.ts",
    "test:stage11": "node scripts/assemble-server.mjs && tsx src/test-stage11.ts",
