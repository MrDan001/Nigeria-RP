// Do not round a client-supplied fractional restock quantity down.
          const quantity = Number(message.quantity);
          const employment = session.player.life.employment;
          const workplace = findWorkplace(MARKET_WORKPLACE_ID);
          const fail = (messageText: string) => send(socket, {
            type: "marketRestockResult", requestId, ok: false, message: messageText,
          });

          if (!requestId || !workplace || employment?.workplaceId !== MARKET_WORKPLACE_ID ||
              !Number.isInteger(employment.rank) || employment.rank < 5 ||
              employment.rank > MARKET_RANKS.length || employment.onDuty !== true ||
              employment.uniformWorkplaceId !== MARKET_WORKPLACE_ID ||
              workplaceDistance(session, workplace) > 24) {
            fail("Market stock restocking requires an on-duty Market Supervisor or Market Chairman at Mile 1 Market.");
            return;
          }

          const draft = normalizeStage4State(stage4State);
          const idempotencyKey = createHash("sha256")
            .update("market-restock|" + session.player.id + "|" + requestId)
            .digest("hex");
          const result = restockMarketStock({
            state: draft.market,
            productId,
            quantity,
            managerRank: employment.rank,
            managerId: session.player.id,
            requestId,
            idempotencyKey,
            now: Date.now(),
          });
          if (!result.ok) {
            const reasons: Record<string, string> = {
              unauthorized_manager: "Only a Market Supervisor or Market Chairman can restock inventory.",
              unknown_product: "Choose a product from the market catalogue.",
              invalid_quantity: "Restock quantity must be between 1 and 100 units.",
              stock_limit: "That restock would exceed the maximum stock capacity of " + MAX_MARKET_STOCK + " units.",
              insufficient_till: "The market till does not have enough funds to purchase that stock.",
              balance_limit: "The market till reached its safe currency limit.",
              invalid_request_id: "The restock reference is invalid.",
              duplicate_restock: "This restock request has already been processed.",
            };
            fail(reasons[result.reason] ?? "The market restock was rejected.");
            send(socket, marketStatePayload(session));
            return;
          }

          const previousState = stage4State;
          stage4State = draft;
          try {
            await saveStage4State();
          } catch (error) {
            stage4State = previousState;
            try { await saveStage4State(previousState); } catch (rollbackError) {
              console.error("market-restock-rollback", rollbackError);
            }
            console.error("market-restock-persist", error);
            fail("The restock could not be saved. No stock was added; please try again.");
            return;
          }

          send(socket, {
            ...marketStatePayload(session),
            type: "marketRestockResult",
            requestId,
            ok: true,
            message: "Restocked " + result.result.productName + " × " + result.result.quantity +
              " for " + "₦" + result.result.totalCost.toLocaleString("en-NG") + ".",
            receipt: result.result,
          });
        });
        return;
      }

      if (message.type === "getBankState") {
        send(socket, bankStatePayload(session));
        return;
      }

      if (message.type === "bankTransaction") {
        await withMoneyMutation(async () => {
          const requestId = String(message.requestId ?? "").trim().slice(0, 100);
          const customerId = String(message.customerId ?? "").trim().slice(0, 100);
          const customer = players.get(customerId);
          const transactionType = String(message.transactionType ?? "");
          // Preserve the supplied numeric value; the domain engine must reject fractional money.
          const amount = Number(message.amount);
          const employment = session.player.life.employment;
          const workplace = findWorkplace(BANK_WORKPLACE_ID);
          const fail = (text: string) => send(socket, {
            type: "bankTransactionResult", requestId, ok: false, message: text,
          });

          if (!requestId || !customerId || !customer || customerId === session.player.id) {
            fail("Choose an available customer at the bank.");
            send(socket, bankStatePayload(session));
            return;
          }
          if (
            !workplace ||
            employment?.workplaceId !== BANK_WORKPLACE_ID ||
            !Number.isInteger(employment.rank) ||
            employment.rank < 2 || employment.rank > BANK_RANKS.length ||
            employment.onDuty !== true ||
            employment.uniformWorkplaceId !== BANK_WORKPLACE_ID
          ) {
            fail("A bank teller ranked Teller or higher must be on duty and in uniform.");
            return;
          }
          if (workplaceDistance(session, workplace) > 24 || workplaceDistance(customer, workplace) > 24) {
            fail("The teller and customer must both be at the bank.");
            return;
          }
          if (transactionType !== "deposit" && transactionType !== "withdrawal") {
            fail("Choose either deposit or withdrawal.");
            return;
          }

          const draft = normalizeStage4State(stage4State);
          const customerMoney = { cash: customer.player.cash, bank: customer.player.bank };
          const idempotencyKey = createHash("sha256")
            .update("bank|" + session.player.id + "|" + requestId)
            .digest("hex");
          const result = settleBankTransaction({
            state: draft.bank,
            requestId,
            idempotencyKey,
            customerId: customer.player.id,
            tellerId: session.player.id,
            tellerRank: employment.rank,
            customer: customerMoney,
            type: transactionType,
            amount,
            now: Date.now(),
          });
          if (!result.ok) {
            const reasons: Record<string, string> = {
              duplicate_transaction: "This transaction reference has already been processed.",
              unauthorized_teller: "A teller ranked Teller or higher is required.",
              invalid_participants: "The customer and teller must be different players.",
              invalid_amount: "Enter a whole amount between ₦1 and ₦10,000,000.",
              insufficient_cash: "The customer does not have enough cash for this deposit.",
              insufficient_bank_balance: "The customer does not have enough money in the bank for this withdrawal.",
              invalid_request_id: "The transaction reference is invalid.",
              invalid_transaction_type: "Choose either deposit or withdrawal.",
              balance_limit: "The transaction exceeds a safe balance limit and was rejected.",
            };
            fail(reasons[result.reason] ?? "The bank transaction was rejected.");
            send(socket, bankStatePayload(session));
            return;
          }

          const previousState = stage4State;
          const previousCash = customer.player.cash;
          const previousBank = customer.player.bank;
          customer.player.cash = customerMoney.cash;
          customer.player.bank = customerMoney.bank;
          try {
            await persistSession(customer);
            stage4State = draft;
            await saveStage4State();
          } catch (error) {
            stage4State = previousState;
            customer.player.cash = previousCash;
            customer.player.bank = previousBank;
            try { await persistSession(customer); } catch (rollbackError) {
              console.error("bank-transaction-rollback", rollbackError);
            }
            try { await saveStage4State(previousState); } catch (rollbackError) {
              console.error("bank-state-rollback", rollbackError);
            }
            console.error("bank-transaction-persist", error);
            fail("The transaction could not be saved. No receipt was issued; please retry.");
            return;
          }

          const receipt = {
            ...result.result.transaction,
            customerName: customer.player.name,
            tellerName: session.player.name,
            receiptNumber: result.result.transaction.id,
            customerCash: customer.player.cash,
            customerBank: customer.player.bank,
          };
          send(socket, {
            ...bankStatePayload(session),
            type: "bankTransactionResult", requestId, ok: true,
            message: (transactionType === "deposit" ? "Deposit" : "Withdrawal") +
              " completed. Receipt " + receipt.receiptNumber + ".",
            receipt,
          });
          send(customer.socket, {
            type: "bankReceipt", ok: true, receipt,
            cash: customer.player.cash, bank: customer.player.bank,
            message: (transactionType === "deposit" ? "Deposit" : "Withdrawal") +
              " completed at Port Harcourt Bank.",
          });
        });
        return;
      }

      if (message.type === "getHospitalState") {
        const hospitalId = isHospitalId(String(message.hospitalId ?? "")) ? String(message.hospitalId) : undefined;
        send(socket, hospitalStatePayload(session, hospitalId));
        return;
      }

      if (message.type === "requestHospitalCare" || message.type === "requestAmbulance") {
        await withMoneyMutation(async () => {
          const ambulance = message.type === "requestAmbulance";
          const hospitalId = String(message.hospitalId ?? "");
          const requestId = String(message.requestId ?? "").trim().slice(0, 100);
          const fail = (messageText: string) => send(socket, {
            type: "hospitalActionResult", action: ambulance ? "requestAmbulance" : "requestCare",
            hospitalId, ok: false, message: messageText,
          });
          if (!isHospitalId(hospitalId)) {
            fail("Choose Mile One General Hospital or Princess Hospital.");
            return;
          }
          if (ambulance) {
            if (stage5PrivateContext(session) || session.inWorkplaceInterior) {
              fail("Step outside private rooms and workplace lobbies before requesting an ambulance.");
              return;
            }
            if (session.player.hp >= 100) {
              fail("Your health is full. You do not need an ambulance right now.");
              return;
            }
            if (session.player.hp > 80) {
              fail("You are not critically injured. Visit a hospital for regular treatment instead.");
              return;
            }
          } else if (!stage5PlayerAtHospital(session, hospitalId)) {
            fail("Walk to the hospital entrance or reception before requesting care.");
            return;
          }
          const draft = normalizeStage5State(stage5State);
          const idempotencyKey = createHash("sha256")
            .update("hospital-request|" + session.player.id + "|" + (ambulance ? "ambulance|" : "care|") + requestId)
            .digest("hex");
          const created = createHospitalRequest({
            state: draft,
            requestId,
            idempotencyKey,
            hospitalId,
            kind: ambulance ? "ambulance" : "care",
            patientId: session.player.id,
            patientX: session.player.x,
            patientZ: session.player.z,
            patientHp: session.player.hp,
            now: Date.now(),
          });
          if (!created.ok) {
            const reasons: Record<string, string> = {
              invalid_request_id: "The request reference is invalid. Refresh and try again.",
              duplicate_request: "This request has already been received.",
              unknown_hospital: "Choose one of the listed hospitals.",
              invalid_request_kind: "Choose hospital treatment or ambulance assistance.",
              invalid_patient: "Your player session could not be verified. Reconnect and try again.",
              no_treatment_needed: "Your health is already full or unavailable for treatment.",
              ambulance_not_needed: "Ambulance dispatch is reserved for serious injuries.",
              invalid_timestamp: "The request could not be timestamped. Please retry.",
              request_already_open: "You already have an open request. A worker can see it in the hospital queue.",
            };
            fail(reasons[created.reason] ?? "The hospital request was rejected.");
            return;
          }
          try {
            await saveStage5State(draft);
            stage5State = draft;
          } catch (error) {
            console.error("stage5-hospital-request-persist", error);
            fail("Your request could not be saved. No request was added; please try again.");
            return;
          }
          send(socket, {
            type: "hospitalActionResult",
            action: ambulance ? "requestAmbulance" : "requestCare",
            hospitalId,
            ok: true,
            request: created.request,
            message: ambulance
              ? "Ambulance request sent. A hospital responder will be assigned; keep the game open and stay in a public area."
              : "Your care request is in the patient queue. An authorised nurse or doctor can now triage and treat you.",
          });
          send(socket, hospitalStatePayload(session, hospitalId));
          for (const worker of players.values()) {
            if (worker.player.id !== session.player.id &&
                worker.player.life.employment?.workplaceId === hospitalId &&
                worker.player.life.employment.onDuty === true &&
                worker.player.life.employment.uniformWorkplaceId === hospitalId) {
              send(worker.socket, hospitalStatePayload(worker, hospitalId));
              send(worker.socket, {
                type: "hospitalRequestNotice",
                message: ambulance
                  ? "🚑 New ambulance request from " + session.player.name + ". Check the emergency queue."
                  : "🩺 New patient care request from " + session.player.name + ". Check the patient queue.",
              });
            }
          }
        });
        return;
      }

      if (message.type === "triageHospitalRequest") {
        await withMoneyMutation(async () => {
          const hospitalId = String(message.hospitalId ?? "");
          const requestId = String(message.requestId ?? "").trim().slice(0, 100);
          const employment = session.player.life.employment;
          const fail = (messageText: string) => send(socket, {
            type: "hospitalActionResult", action: "triage", hospitalId, requestId, ok: false, message: messageText,
          });
          if (!isHospitalId(hospitalId) || employment?.workplaceId !== hospitalId) {
            fail("You must belong to the hospital assigned to this request.");
            return;
          }
          const draft = normalizeStage5State(stage5State);
          const request = draft.hospital.requests.find(item => item.id === requestId);
          const patient = request ? players.get(request.patientId) : undefined;
          const triaged = triageHospitalRequest({
            state: draft,
            requestId,
            workerId: session.player.id,
            workerRank: Number(employment.rank),
            hospitalId,
            onDuty: employment.onDuty === true,
            uniform: employment.uniformWorkplaceId === hospitalId,
            atHospital: stage5PlayerAtHospital(session, hospitalId),
            patientAtHospital: !!patient && stage5PlayerAtHospital(patient, hospitalId),
            now: Date.now(),
          });
          if (!triaged.ok) {
            const reasons: Record<string, string> = {
              unknown_hospital: "Choose a valid hospital.",
              unauthorized_clinician: "Triage requires a rank 2 or higher hospital worker who is on duty, in uniform and at the hospital.",
              request_unavailable: "That patient request is no longer available.",
              patient_not_at_hospital: "The patient must be present at this hospital before triage.",
              already_triaged: "This patient has already been triaged. A nurse or doctor can continue with treatment.",
              invalid_timestamp: "The triage action could not be recorded. Please retry.",
            };
            fail(reasons[triaged.reason] ?? "Triage was rejected.");
            return;
          }
          try {
            await saveStage5State(draft);
            stage5State = draft;
          } catch (error) {
            console.error("stage5-triage-persist", error);
            fail("Triage could not be saved. No triage record was issued.");
            return;
          }
          const patientName = patient?.player.name ?? request!.patientId.slice(0, 8);
          const messageText = "Triage recorded for " + patientName + ". A Nurse or higher rank can complete treatment.";
          send(socket, { type: "hospitalActionResult", action: "triage", hospitalId, requestId, ok: true, message: messageText });
          if (patient) {
            send(patient.socket, {
              type: "hospitalActionResult", action: "triaged", hospitalId, requestId, ok: true,
              message: session.player.name + " completed your triage. A nurse or doctor can continue your treatment.",
            });
            send(patient.socket, hospitalStatePayload(patient, hospitalId));
          }
          send(socket, hospitalStatePayload(session, hospitalId));
          broadcastHospitalStaffState(hospitalId, [session.player.id, ...(patient ? [patient.player.id] : [])]);
        });
        return;
      }

      if (message.type === "dispatchHospitalAmbulance") {
        await withMoneyMutation(async () => {
          const hospitalId = String(message.hospitalId ?? "");
          const requestId = String(message.requestId ?? "").trim().slice(0, 100);
          const employment = session.player.life.employment;
          const fail = (messageText: string) => send(socket, {
            type: "hospitalActionResult", action: "dispatchAmbulance", hospitalId, requestId, ok: false, message: messageText,
          });
          if (!isHospitalId(hospitalId) || employment?.workplaceId !== hospitalId) {
            fail("You must be rostered at the hospital handling this emergency.");
            return;
          }
          const draft = normalizeStage5State(stage5State);
          const request = draft.hospital.requests.find(item => item.id === requestId);
          const patient = request ? players.get(request.patientId) : undefined;
          const dispatched = dispatchHospitalAmbulance({
            state: draft,
            requestId,
            workerId: session.player.id,
            workerRank: Number(employment.rank),
            hospitalId,
            onDuty: employment.onDuty === true,
            uniform: employment.uniformWorkplaceId === hospitalId,
            atHospital: stage5PlayerAtHospital(session, hospitalId),
            now: Date.now(),
          });
          if (!dispatched.ok) {
            const reasons: Record<string, string> = {
              unknown_hospital: "Choose a valid hospital.",
              unauthorized_dispatcher: "Ambulance dispatch requires a Nurse or higher rank on duty, in uniform and at the hospital.",
              request_unavailable: "This emergency is no longer available for dispatch.",
              invalid_timestamp: "The dispatch could not be recorded. Please retry.",
            };
            fail(reasons[dispatched.reason] ?? "Ambulance dispatch was rejected.");
            return;
          }
          try {
            await saveStage5State(draft);
            stage5State = draft;
          } catch (error) {
            console.error("stage5-ambulance-dispatch-persist", error);
            fail("Ambulance dispatch could not be saved. Please retry.");
            return;
          }
          const patientName = patient?.player.name ?? request!.patientId.slice(0, 8);
          const messageText = "Ambulance dispatched to " + patientName + ". Proceed to the patient's live location, then complete field treatment when close enough.";
          send(socket, { type: "hospitalActionResult", action: "dispatchAmbulance", hospitalId, requestId, ok: true, message: messageText });
          if (patient) {
            send(patient.socket, {
              type: "hospitalActionResult", action: "ambulanceDispatched", hospitalId, requestId, ok: true,
              message: session.player.name + " has been assigned to your ambulance request.",
              workerName: session.player.name,
            });
            send(patient.socket, hospitalStatePayload(patient, hospitalId));
          }
          send(socket, hospitalStatePayload(session, hospitalId));
          broadcastHospitalStaffState(hospitalId, [session.player.id, ...(patient ? [patient.player.id] : [])]);
        });
        return;
      }

      if (message.type === "completeHospitalTreatment") {
        await withMoneyMutation(async () => {
          const requestId = String(message.requestId ?? "").trim().slice(0, 100);
          const storedRequest = stage5State.hospital.requests.find(item => item.id === requestId);
          const hospitalId = String(storedRequest?.hospitalId ?? message.hospitalId ?? "");
          const employment = session.player.life.employment;
          const fail = (messageText: string) => send(socket, {
            type: "hospitalActionResult", action: "treatment", hospitalId, requestId, ok: false, message: messageText,
          });
          if (!isHospitalId(hospitalId) || employment?.workplaceId !== hospitalId) {
            fail("You must belong to the hospital assigned to this patient request.");
            return;
          }
          const initialRequest = stage5State.hospital.requests.find(item => item.id === requestId);
          const patient = initialRequest ? players.get(initialRequest.patientId) : undefined;
          if (!patient || patient.player.id === session.player.id) {
            fail("The patient must be online and different from the treating worker.");
            return;
          }
          const careAtHospital = initialRequest?.kind === "care";
          const ambulanceProximityValid = !!patient &&
            !stage5PrivateContext(patient) && !patient.inWorkplaceInterior &&
            !stage5PrivateContext(session) && !session.inWorkplaceInterior &&
            Math.hypot(session.player.x - patient.player.x, session.player.z - patient.player.z) <= 8;
          const draft = normalizeStage5State(stage5State);
          const condition = { hp: patient.player.hp, cash: patient.player.cash };
          const treated = completeHospitalTreatment({
            state: draft,
            requestId,
            patientId: patient.player.id,
            workerId: session.player.id,
            workerRank: Number(employment.rank),
            hospitalId,
            onDuty: employment.onDuty === true,
            uniform: employment.uniformWorkplaceId === hospitalId,
            atHospital: stage5PlayerAtHospital(session, hospitalId),
            patientAtHospital: stage5PlayerAtHospital(patient, hospitalId),
            ambulanceProximityValid,
            patient: condition,
            now: Date.now(),
          });
          if (!treated.ok) {
            const reasons: Record<string, string> = {
              unknown_hospital: "Choose a valid hospital.",
              unauthorized_clinician: "Treatment requires a Nurse or higher rank who is on duty and in the authorised uniform.",
              request_unavailable: "This request is already completed, cancelled or assigned to another worker.",
              patient_not_at_hospital: "The patient and clinician must both be at the selected hospital for regular treatment.",
              triage_required: "Complete patient triage before starting regular treatment.",
              ambulance_not_at_patient: "Reach the assigned patient in a public area and come within 8 metres before completing field treatment.",
              no_treatment_needed: "The patient's health is already full. No fee was charged.",
              insufficient_cash: "The patient needs ₦" + (careAtHospital ? "500" : "1,200") + " cash for this treatment.",
              invalid_timestamp: "The treatment could not be recorded. Please retry.",
            };
            fail(reasons[treated.reason] ?? "Treatment was rejected.");
            send(socket, hospitalStatePayload(session, hospitalId));
            return;
          }
          const previousState = stage5State;
          const previousHp = patient.player.hp;
          const previousCash = patient.player.cash;
          patient.player.hp = treated.newHp;
          patient.player.cash = treated.newCash;
          try {
            await persistSession(patient);
            await saveStage5State(draft);
            stage5State = draft;
          } catch (error) {
            patient.player.hp = previousHp;
            patient.player.cash = previousCash;
            stage5State = previousState;
            try { await persistSession(patient); } catch (rollbackError) {
              console.error("stage5-treatment-account-rollback", rollbackError);
            }
            try { await saveStage5State(previousState); } catch (rollbackError) {
              console.error("stage5-treatment-state-rollback", rollbackError);
            }
            console.error("stage5-treatment-persist", error);
            fail("Treatment could not be saved. No receipt was issued; please retry.");
            return;
          }
          const record = draft.hospital.history[draft.hospital.history.length - 1];
          const receipt = {
            ...record,
            patientName: patient.player.name,
            workerName: session.player.name,
            cashRemaining: patient.player.cash,
            healthNow: patient.player.hp,
          };
          const textResult = (record.kind === "ambulance-treatment" ? "Emergency field treatment" : "Hospital treatment") +
            " completed for " + patient.player.name + ". ₦" + treated.amount.toLocaleString("en-NG") +
            " paid; health restored by " + treated.healthRestored + ".";
          send(socket, { type: "hospitalActionResult", action: "treatment", hospitalId, requestId, ok: true, message: textResult, receipt });
          send(patient.socket, {
            type: "hospitalActionResult", action: "treated", hospitalId, requestId, ok: true,
            message: session.player.name + " treated you. ₦" + treated.amount.toLocaleString("en-NG") +
              " paid; health restored by " + treated.healthRestored + ".",
            receipt,
            hp: patient.player.hp,
            cash: patient.player.cash,
          });
          send(socket, hospitalStatePayload(session, hospitalId));
          send(patient.socket, hospitalStatePayload(patient, hospitalId));
          broadcastHospitalStaffState(hospitalId, [session.player.id, patient.player.id]);
        });
        return;
      }

      if (message.type === "purchaseHospitalMedicine") {
        await withMoneyMutation(async () => {
          const hospitalId = String(message.hospitalId ?? "");
          const requestId = String(message.requestId ?? "").trim().slice(0, 100);
          const workerId = String(message.workerId ?? "").trim().slice(0, 160);
          const quantity = Number(message.quantity);
          const medicineId = String(message.medicineId ?? "");
          const worker = players.get(workerId);
          const employment = worker?.player.life.employment;
          const fail = (messageText: string) => send(socket, {
            type: "hospitalActionResult", action: "pharmacy", hospitalId, requestId, ok: false, message: messageText,
          });
          if (!isHospitalId(hospitalId) || !requestId || !worker || workerId === session.player.id) {
            fail("Choose an available hospital pharmacy worker.");
            return;
          }
          if (!stage5PlayerAtHospital(session, hospitalId) || !stage5PlayerAtHospital(worker, hospitalId)) {
            fail("You and the pharmacy worker must both be at the same hospital.");
            return;
          }
          if (employment?.workplaceId !== hospitalId || employment.onDuty !== true ||
              employment.uniformWorkplaceId !== hospitalId) {
            fail("That pharmacy worker is not rostered, clocked in and wearing the hospital uniform.");
            return;
          }
          const draft = normalizeStage5State(stage5State);
          const inventory = { ...session.player.inventory };
          const idempotencyKey = createHash("sha256")
            .update("hospital-pharmacy|" + session.player.id + "|" + requestId)
            .digest("hex");
          const purchase = purchaseHospitalMedicine({
            state: draft,
            requestId,
            idempotencyKey,
            hospitalId,
            customerId: session.player.id,
            workerId,
            workerRank: Number(employment.rank),
            onDuty: employment.onDuty === true,
            uniform: employment.uniformWorkplaceId === hospitalId,
            medicineId,
            quantity,
            customerCash: session.player.cash,
            inventory,
            now: Date.now(),
          });
          if (!purchase.ok) {
            const reasons: Record<string, string> = {
              unknown_hospital: "Choose a valid hospital.",
              unauthorized_pharmacy_worker: "Pharmacy sales require another on-duty hospital worker of rank 2 or higher.",
              invalid_request_id: "The purchase reference is invalid. Refresh and try again.",
              duplicate_order: "This pharmacy order has already been processed.",
              unknown_medicine: "Choose a medicine from the hospital pharmacy list.",
              invalid_quantity: "Choose a whole quantity between 1 and 10.",
              invalid_balance: "Your balance or inventory is invalid. Reconnect and try again.",
              insufficient_stock: "The pharmacy does not have enough stock for this purchase.",
              inventory_limit: "Your backpack cannot hold any more of this medicine.",
              insufficient_cash: "You do not have enough cash for this medicine.",
              invalid_timestamp: "The pharmacy could not record the purchase time.",
            };
            fail(reasons[purchase.reason] ?? "The pharmacy purchase was rejected.");
            send(socket, hospitalStatePayload(session, hospitalId));
            return;
          }
          const previousState = stage5State;
          const previousCash = session.player.cash;
          const previousInventory = { ...session.player.inventory };
          session.player.cash = purchase.newCash;
          session.player.inventory = purchase.inventory;
          try {
            await persistSession(session);
            await saveStage5State(draft);
            stage5State = draft;
          } catch (error) {
            session.player.cash = previousCash;
            session.player.inventory = previousInventory;
            stage5State = previousState;
            try { await persistSession(session); } catch (rollbackError) {
              console.error("stage5-pharmacy-account-rollback", rollbackError);
            }
            try { await saveStage5State(previousState); } catch (rollbackError) {
              console.error("stage5-pharmacy-state-rollback", rollbackError);
            }
            console.error("stage5-pharmacy-persist", error);
            fail("The pharmacy purchase could not be saved. No purchase was confirmed.");
            return;
          }
          const receipt = {
            ...purchase.receipt,
            customerName: session.player.name,
            workerName: worker.player.name,
            cashRemaining: session.player.cash,
          };
          send(socket, {
            type: "hospitalActionResult", action: "pharmacy", hospitalId, requestId, ok: true,
            message: "Purchased " + purchase.receipt.medicineName + " × " + purchase.receipt.quantity +
              " for ₦" + purchase.receipt.total.toLocaleString("en-NG") + ". Added to your backpack.",
            receipt, cash: session.player.cash, inventory: session.player.inventory,
          });
          send(worker.socket, {
            type: "hospitalPharmacySaleNotice",
            message: "Pharmacy sale: " + purchase.receipt.medicineName + " × " + purchase.receipt.quantity +
              " sold to " + session.player.name + ". Receipt " + purchase.receipt.id + ".",
          });
          send(socket, hospitalStatePayload(session, hospitalId));
          send(worker.socket, hospitalStatePayload(worker, hospitalId));
          broadcastHospitalStaffState(hospitalId, [session.player.id, worker.player.id]);
        });
        return;
      }

      if (message.type === "getParkState") {
        send(socket, parkStatePayload(session));
        return;
      }

      if (message.type === "buyParkTicket") {
        await withMoneyMutation(async () => {
          const requestId = String(message.requestId ?? "").trim().slice(0, 100);
          const sellerId = String(message.sellerId ?? "").trim().slice(0, 160);
          const seller = players.get(sellerId);
          const employment = seller?.player.life.employment;
          const fail = (messageText: string) => send(socket, {
            type: "parkActionResult", action: "buyTicket", requestId, ok: false, message: messageText,
          });
          if (!requestId || !seller || sellerId === session.player.id) {
            fail("Choose an available ticket seller who is different from you.");
            return;
          }
          if (!stage5AtWorkplace(session, PARK_WORKPLACE_ID) ||
              !stage5AtWorkplace(seller, PARK_WORKPLACE_ID)) {
            fail("You and the ticket seller must both be at City Park.");
            return;
          }
          if (employment?.workplaceId !== PARK_WORKPLACE_ID || Number(employment.rank) < 3 ||
              Number(employment.rank) > 6 || employment.onDuty !== true ||
              employment.uniformWorkplaceId !== PARK_WORKPLACE_ID) {
            fail("That park employee cannot sell tickets right now. A Ticket Seller or higher must be on duty and in uniform.");
            return;
          }
          const draft = normalizeStage5State(stage5State);
          const idempotencyKey = createHash("sha256")
            .update("park-ticket|" + session.player.id + "|" + requestId)
            .digest("hex");
          const purchased = buyParkTicket({
            state: draft,
            requestId,
            idempotencyKey,
            visitorId: session.player.id,
            sellerId,
            sellerRank: Number(employment.rank),
            sellerOnDuty: employment.onDuty === true,
            sellerUniform: employment.uniformWorkplaceId === PARK_WORKPLACE_ID,
            visitorAtPark: stage5AtWorkplace(session, PARK_WORKPLACE_ID),
            sellerAtPark: stage5AtWorkplace(seller, PARK_WORKPLACE_ID),
            visitorCash: session.player.cash,
            dayKey: clock.dayKey(),
            now: Date.now(),
          });
          if (!purchased.ok) {
            const reasons: Record<string, string> = {
              invalid_request_id: "The ticket purchase reference is invalid. Refresh and try again.",
              duplicate_ticket_sale: "This ticket purchase has already been processed.",
              invalid_participants: "A visitor cannot sell a ticket to themselves.",
              unauthorized_ticket_seller: "Ticket sales require a rank 3 or higher park employee on duty and in uniform.",
              visitor_not_at_park: "Walk to City Park before buying an entry pass.",
              invalid_day: "The park ticket could not be linked to today's game date.",
              invalid_timestamp: "The ticket time could not be recorded.",
              ticket_already_valid: "You already have a valid City Park pass for today.",
              insufficient_cash: "City Park entry costs ₦" + PARK_TICKET_PRICE.toLocaleString("en-NG") + ".",
              balance_limit: "The park till is at its safe balance limit. Please contact park management.",
            };
            fail(reasons[purchased.reason] ?? "The ticket purchase was rejected.");
            return;
          }
          const previousState = stage5State;
          const previousCash = session.player.cash;
          session.player.cash = purchased.newCash;
          try {
            await persistSession(session);
            await saveStage5State(draft);
            stage5State = draft;
          } catch (error) {
            session.player.cash = previousCash;
            stage5State = previousState;
            try { await persistSession(session); } catch (rollbackError) {
              console.error("stage5-park-ticket-account-rollback", rollbackError);
            }
            try { await saveStage5State(previousState); } catch (rollbackError) {
              console.error("stage5-park-ticket-state-rollback", rollbackError);
            }
            console.error("stage5-park-ticket-persist", error);
            fail("Your ticket could not be saved. No ticket was confirmed; please retry.");
            return;
          }
          const receipt = {
            ...purchased.ticket,
            visitorName: session.player.name,
            sellerName: seller.player.name,
            cashRemaining: session.player.cash,
            till: purchased.till,
          };
          send(socket, {
            type: "parkActionResult", action: "buyTicket", requestId, ok: true,
            message: "City Park visitor pass issued for today. ₦" + PARK_TICKET_PRICE.toLocaleString("en-NG") + " paid.",
            receipt, cash: session.player.cash,
          });
          send(seller.socket, {
            type: "parkTicketSaleNotice",
            message: "City Park ticket sold to " + session.player.name + ". Receipt " + receipt.id + ".",
            receipt,
          });
          send(socket, parkStatePayload(session));
          send(seller.socket, parkStatePayload(seller));
          broadcastParkStaffState([session.player.id, seller.player.id]);
        });
        return;
      }

      if (message.type === "requestParkHelp") {
        await withMoneyMutation(async () => {
          const requestId = String(message.requestId ?? "").trim().slice(0, 100);
          const kind = String(message.kind ?? "");
          const fail = (messageText: string) => send(socket, {
            type: "parkActionResult", action: "requestHelp", requestId, ok: false, message: messageText,
          });
          if (!stage5AtWorkplace(session, PARK_WORKPLACE_ID)) {
            fail("Walk to City Park before asking the park team for help.");
            return;
          }
          const draft = normalizeStage5State(stage5State);
          const idempotencyKey = createHash("sha256")
            .update("park-help|" + session.player.id + "|" + requestId)
            .digest("hex");
          const created = createParkHelpRequest({
            state: draft,
            requestId,
            idempotencyKey,
            visitorId: session.player.id,
            kind,
            atPark: stage5AtWorkplace(session, PARK_WORKPLACE_ID),
            now: Date.now(),
          });
          if (!created.ok) {
            const reasons: Record<string, string> = {
              invalid_request_id: "The visitor request reference is invalid.",
              duplicate_request: "This request has already been recorded.",
              invalid_visitor: "Your player session could not be verified.",
              invalid_help_kind: "Choose one of the listed visitor assistance options.",
              visitor_not_at_park: "Walk to City Park before asking for assistance.",
              request_already_open: "You already have an open park assistance request. The park team can see it.",
              invalid_timestamp: "The request time could not be recorded.",
            };
            fail(reasons[created.reason] ?? "The park request was rejected.");
            return;
          }
          try {
            await saveStage5State(draft);
            stage5State = draft;
          } catch (error) {
            console.error("stage5-park-help-persist", error);
            fail("Your request could not be saved. Please retry.");
            return;
          }
          send(socket, {
            type: "parkActionResult", action: "requestHelp", requestId, ok: true,
            request: created.request,
            message: created.request.kind === "first-aid"
              ? "Your first-aid request has been sent to the park team. For severe injuries, request an ambulance from a hospital."
              : "Your request is now in the park team's visitor queue.",
          });
          send(socket, parkStatePayload(session));
          for (const worker of players.values()) {
            if (worker.player.id !== session.player.id &&
                worker.player.life.employment?.workplaceId === PARK_WORKPLACE_ID &&
                worker.player.life.employment.onDuty === true &&
                worker.player.life.employment.uniformWorkplaceId === PARK_WORKPLACE_ID &&
                stage5AtWorkplace(worker, PARK_WORKPLACE_ID)) {
              send(worker.socket, parkStatePayload(worker));
              send(worker.socket, {
                type: "parkRequestNotice",
                message: "🌳 New City Park visitor assistance request from " + session.player.name + ".",
              });
            }
          }
        });
        return;
      }

      if (message.type === "resolveParkHelpRequest") {
        await withMoneyMutation(async () => {
          const requestId = String(message.requestId ?? "").trim().slice(0, 100);
          const employment = session.player.life.employment;
          const fail = (messageText: string) => send(socket, {
            type: "parkActionResult", action: "resolveHelp", requestId, ok: false, message: messageText,
          });
          if (employment?.workplaceId !== PARK_WORKPLACE_ID) {
            fail("You must belong to City Park Authority to handle visitor requests.");
            return;
          }
          const stored = stage5State.park.helpRequests.find(request => request.id === requestId);
          const visitor = stored ? players.get(stored.visitorId) : undefined;
          if (!visitor || !stage5AtWorkplace(visitor, PARK_WORKPLACE_ID)) {
            fail("The visitor must be online and present at City Park.");
            return;
          }
          if (Math.hypot(session.player.x - visitor.player.x, session.player.z - visitor.player.z) > 24) {
            fail("Move closer to the visitor before marking the request handled.");
            return;
          }
          const draft = normalizeStage5State(stage5State);
          const resolved = resolveParkHelpRequest({
            state: draft,
            requestId,
            workerId: session.player.id,
            workerRank: Number(employment.rank),
            onDuty: employment.onDuty === true,
            uniform: employment.uniformWorkplaceId === PARK_WORKPLACE_ID,
            atPark: stage5AtWorkplace(session, PARK_WORKPLACE_ID),
            now: Date.now(),
          });
          if (!resolved.ok) {
            const reasons: Record<string, string> = {
              unauthorized_park_worker: "Visitor assistance requires a rank 2 or higher park employee who is on duty, in uniform and at the park.",
              request_unavailable: "This visitor request is already handled or unavailable.",
              invalid_timestamp: "The completed request could not be recorded.",
            };
            fail(reasons[resolved.reason] ?? "The visitor request could not be completed.");
            return;
          }
          try {
            await saveStage5State(draft);
            stage5State = draft;
          } catch (error) {
            console.error("stage5-park-help-resolution-persist", error);
            fail("The completed request could not be saved. Please retry.");
            return;
          }
          const kind = PARK_HELP_CATEGORIES.find(item => item.id === resolved.request.kind)?.title ?? "Visitor assistance";
          send(socket, {
            type: "parkActionResult", action: "resolveHelp", requestId, ok: true,
            message: kind + " completed for " + visitor.player.name + ".",
          });
          send(visitor.socket, {
            type: "parkActionResult", action: "helpResolved", requestId, ok: true,
            message: session.player.name + " has handled your " + kind.toLowerCase() + " request.",
          });
          send(socket, parkStatePayload(session));
          send(visitor.socket, parkStatePayload(visitor));
          broadcastParkStaffState([session.player.id, visitor.player.id]);
        });
        return;
      }


      if (message.type === "getGovernmentState") { send(socket,governmentStatePayload(session)); return; }
      if (message.type === "claimGovernmentPayroll") {
        await withMoneyMutation(async()=>{
          const failure=governmentWorkplaceFailure(session);
          if(failure){sendGovernmentResult(session,"payroll",false,failure);return;}
          const e=session.player.life.employment!;
          const r=claimGovernmentPayroll(stage6State,{actorId:session.player.id,actorName:session.player.name,rank:Number(e.rank),dayKey:clock.dayKey(),now:Date.now()});
          if(!r.ok||!r.transaction){sendGovernmentResult(session,"payroll",false,r.message);return;}
          stage6State=r.state;session.player.cash+=r.transaction.amount;
          await saveStage6State();await persistSession(session);
          sendGovernmentResult(session,"payroll",true,r.message);broadcastGovernmentStates();
        });return;
      }
      if (message.type === "publishGovernmentAnnouncement") {
        await withMoneyMutation(async()=>{
          const failure=governmentWorkplaceFailure(session,{requiredRank:2});
          if(failure){sendGovernmentResult(session,"announcement",false,failure);return;}
          const r=publishGovernmentAnnouncement(stage6State,{requestId:String(message.requestId??""),authorId:session.player.id,authorName:session.player.name,rank:Number(session.player.life.employment?.rank),text:String(message.text??""),now:Date.now()});
          if(!r.ok){sendGovernmentResult(session,"announcement",false,r.message);return;}
          stage6State=r.state;await saveStage6State();sendGovernmentResult(session,"announcement",true,r.message);broadcastGovernmentStates();
        });return;
      }
      if (message.type === "approveGovernmentSpending") {
        await withMoneyMutation(async()=>{
          const failure=governmentWorkplaceFailure(session,{governorOnly:true,requiredRank:BOSS_RANK});
          if(failure){sendGovernmentResult(session,"spending",false,failure);return;}
          const r=approveGovernmentSpending(stage6State,{requestId:String(message.requestId??""),actorId:session.player.id,actorName:session.player.name,amount:Number(message.amount),memo:String(message.memo??""),now:Date.now()});
          if(!r.ok){sendGovernmentResult(session,"spending",false,r.message);return;}
          stage6State=r.state;await saveStage6State();sendGovernmentResult(session,"spending",true,"Authorized expenditure recorded in the state treasury ledger.");broadcastGovernmentStates();
        });return;
      }



      if (message.type === "getStage11State") { send(socket,stage11Payload(session)); return; }
      if (message.type === "stage11BuyFuel") { await withMoneyMutation(async()=>{const worker=players.get(String(message.workerId??"")),v=stage11Vehicle(session,String(message.vehicleId??""));if(!worker||worker.player.id===session.player.id||!v){stage11Result(session,"fuel",{ok:false,reason:"invalid_participants"});return;}const r=buyStage11Fuel({state:stage11State,requestId:String(message.requestId??""),customerId:session.player.id,vehicleId:v.id,litres:Number(message.litres),customerCash:session.player.cash,actor:stage11Actor(worker),now:Date.now()});if(!r.ok){stage11Result(session,"fuel",r);return;}const old=session.player.cash;session.player.cash-=r.result.total;session.player.fuel[v.id]=r.result.fuelRemaining;try{await persistSession(session);await saveStage11State();stage11Result(session,"fuel",r);broadcastStage11States();}catch(e){session.player.cash=old;stage11Result(session,"fuel",{ok:false,reason:"persist_failed"});}});return;}
      if (message.type === "stage11OpenService") {const x=STAGE11_SERVICES.find(v=>v.id===String(message.serviceId??"")),b=x&&stage11State.businesses[x.businessId];if(!x||!b||Math.hypot(session.player.x-b.x,session.player.z-b.z)>24){stage11Result(session,"service-open",{ok:false,reason:"customer_not_at_business"});return;}if(x.requiresVehicle&&!stage11Vehicle(session,String(message.vehicleId??""))){stage11Result(session,"service-open",{ok:false,reason:"vehicle_not_owned"});return;}const r=openStage11ServiceOrder({state:stage11State,requestId:String(message.requestId??""),customerId:session.player.id,serviceId:x.id,targetVehicleId:x.requiresVehicle?String(message.vehicleId??""):null,now:Date.now()});if(r.ok)await saveStage11State();stage11Result(session,"service-open",r);return;}
      if (message.type === "stage11AssignService") {const t=players.get(String(message.workerId??""));const r=t?assignStage11ServiceOrder({state:stage11State,orderId:String(message.orderId??""),supervisor:stage11Actor(session),assignee:stage11Actor(t)}):{ok:false,reason:"invalid_assignee"};if(r.ok)await saveStage11State();stage11Result(session,"service-assign",r);return;}
      if (message.type === "stage11CompleteService") {await withMoneyMutation(async()=>{const o=stage11State.serviceOrders.find(v=>v.id===String(message.orderId??"")),c=o?players.get(o.customerId):null;if(!c){stage11Result(session,"service-complete",{ok:false,reason:"customer_offline"});return;}const r=completeStage11ServiceOrder({state:stage11State,orderId:o!.id,customerCash:c.player.cash,actor:stage11Actor(session),now:Date.now()});if(!r.ok){stage11Result(session,"service-complete",r);return;}const old=c.player.cash;c.player.cash-=r.result.total;try{await persistSession(c);await saveStage11State();stage11Result(session,"service-complete",r);broadcastStage11States();}catch(e){c.player.cash=old;stage11Result(session,"service-complete",{ok:false,reason:"persist_failed"});}});return;}
      if (message.type === "stage11OpenRepair") {const p=stage11Property(session);if(!p){stage11Result(session,"repair-open",{ok:false,reason:"property_access_denied"});return;}const r=openStage11RepairCall({state:stage11State,requestId:String(message.requestId??""),customerId:session.player.id,propertyId:p.id,kind:String(message.kind??"") as any,description:String(message.description??""),now:Date.now()});if(r.ok)await saveStage11State();stage11Result(session,"repair-open",r);return;}
      if (message.type === "stage11AssignRepair") {const t=players.get(String(message.workerId??""));const r=t?assignStage11RepairCall({state:stage11State,callId:String(message.callId??""),supervisor:stage11Actor(session),assignee:stage11Actor(t)}):{ok:false,reason:"invalid_assignee"};if(r.ok)await saveStage11State();stage11Result(session,"repair-assign",r);return;}
      if (message.type === "stage11CompleteRepair") {await withMoneyMutation(async()=>{const q=stage11State.repairCalls.find(v=>v.id===String(message.callId??"")),c=q?players.get(q.customerId):null;if(!c){stage11Result(session,"repair-complete",{ok:false,reason:"customer_offline"});return;}const r=completeStage11RepairCall({state:stage11State,callId:q!.id,customerCash:c.player.cash,actor:stage11Actor(session),now:Date.now()});if(!r.ok){stage11Result(session,"repair-complete",r);return;}const old=c.player.cash;c.player.cash-=r.result.price;try{await persistSession(c);await saveStage11State();stage11Result(session,"repair-complete",r);broadcastStage11States();}catch(e){c.player.cash=old;stage11Result(session,"repair-complete",{ok:false,reason:"persist_failed"});}});return;}
      if (message.type === "stage11PayUtility") {const p=stage11Property(session);if(!p){stage11Result(session,"utility",{ok:false,reason:"property_access_denied"});return;}await withMoneyMutation(async()=>{const r=payStage11UtilityBill({state:stage11State,requestId:String(message.requestId??""),customerId:session.player.id,propertyId:p.id,utility:String(message.utility??"") as any,customerCash:session.player.cash,now:Date.now()});if(!r.ok){stage11Result(session,"utility",r);return;}const old=session.player.cash;session.player.cash-=r.result.amount;try{await persistSession(session);await saveStage11State();stage11Result(session,"utility",r);}catch(e){session.player.cash=old;stage11Result(session,"utility",{ok:false,reason:"persist_failed"});}});return;}
      if (message.type === "stage11OpenCourier") {const h=stage11State.businesses["courier-hub-main"];if(!h||Math.hypot(session.player.x-h.x,session.player.z-h.z)>24){stage11Result(session,"courier-open",{ok:false,reason:"customer_not_at_hub"});return;}const r=openStage11CourierDelivery({state:stage11State,requestId:String(message.requestId??""),customerId:session.player.id,recipientName:String(message.recipientName??""),parcelDescription:String(message.parcelDescription??""),dropoffX:Number(message.dropoffX),dropoffZ:Number(message.dropoffZ),now:Date.now()});if(r.ok)await saveStage11State();stage11Result(session,"courier-open",r);return;}
      if (message.type === "stage11AssignCourier") {const t=players.get(String(message.workerId??""));const r=t?assignStage11CourierDelivery({state:stage11State,deliveryId:String(message.deliveryId??""),supervisor:stage11Actor(session),assignee:stage11Actor(t)}):{ok:false,reason:"invalid_assignee"};if(r.ok)await saveStage11State();stage11Result(session,"courier-assign",r);return;}
      if (message.type === "stage11PickupCourier") {const r=pickupStage11CourierDelivery({state:stage11State,deliveryId:String(message.deliveryId??""),actor:stage11Actor(session),now:Date.now()});if(r.ok)await saveStage11State();stage11Result(session,"courier-pickup",r);return;}
      if (message.type === "stage11CompleteCourier") {await withMoneyMutation(async()=>{const d=stage11State.deliveries.find(v=>v.id===String(message.deliveryId??"")),c=d?players.get(d.customerId):null;if(!c){stage11Result(session,"courier-complete",{ok:false,reason:"customer_offline"});return;}const r=completeStage11CourierDelivery({state:stage11State,deliveryId:d!.id,customerCash:c.player.cash,actor:stage11Actor(session),now:Date.now()});if(!r.ok){stage11Result(session,"courier-complete",r);return;}const old=c.player.cash;c.player.cash-=r.result.price;try{await persistSession(c);await saveStage11State();stage11Result(session,"courier-complete",r);broadcastStage11States();}catch(e){c.player.cash=old;stage11Result(session,"courier-complete",{ok:false,reason:"persist_failed"});}});return;}

      if (message.type === "getStage9State") { send(socket,stage9StatePayload(session)); return; }
      if (message.type === "checkoutStage9Vehicle") {
        await withMoneyMutation(async()=>{const r=checkoutStage9Vehicle(stage9State,{requestId:String(message.requestId??""),actor:stage9Actor(session),vehicleId:String(message.vehicleId??""),nearDepot:Math.hypot(session.player.x-STAGE9_DEPOT.x,session.player.z-STAGE9_DEPOT.z)<=18,now:Date.now()});
          if(!await persistStage9Action(session,"checkout",r))return;sendStage9Result(session,"checkout",r);broadcastStage9States();});return;
      }
      if (message.type === "returnStage9Vehicle") {
        await withMoneyMutation(async()=>{const r=returnStage9Vehicle(stage9State,{requestId:String(message.requestId??""),actor:stage9Actor(session),nearDepot:Math.hypot(session.player.x-STAGE9_DEPOT.x,session.player.z-STAGE9_DEPOT.z)<=18,now:Date.now()});
          if(!await persistStage9Action(session,"return",r))return;stage9FuelProgress.delete(session.player.id);sendStage9Result(session,"return",r);broadcastStage9States();});return;
      }
      if (message.type === "refuelStage9Vehicle") {
        await withMoneyMutation(async()=>{const oldCash=session.player.cash;
          const r=refuelStage9Vehicle(stage9State,{requestId:String(message.requestId??""),actor:stage9Actor(session),litres:Number(message.litres),nearFuelPoint:Math.hypot(session.player.x-STAGE9_DEPOT.x,session.player.z-STAGE9_DEPOT.z)<=18,cash:oldCash,now:Date.now()});
          if(!r.ok){sendStage9Result(session,"refuel",r);return;}
          try{session.player.cash=oldCash-(r.cost??0);await persistSession(session);await saveStage9State(r.state);stage9State=r.state;sendStage9Result(session,"refuel",r);broadcastStage9States();}
          catch(error){session.player.cash=oldCash;await persistSession(session).catch(()=>undefined);console.error("stage9-refuel-save",error);sendStage9Result(session,"refuel",{ok:false,state:stage9State,message:"Fuel purchase could not be saved; your cash has been restored."});}
        });return;
      }
      if (message.type === "requestStage9Ride") {
        await withMoneyMutation(async()=>{const r=requestStage9Ride(stage9State,{requestId:String(message.requestId??""),actor:stage9Actor(session),pickupStopId:String(message.pickupStopId??""),destinationStopId:String(message.destinationStopId??""),vehicleType:message.vehicleType,passengerCash:session.player.cash,now:Date.now()});
          if(!await persistStage9Action(session,"request-ride",r))return;sendStage9Result(session,"request-ride",r);broadcastStage9States();});return;
      }
      if (message.type === "acceptStage9Ride") {
        await withMoneyMutation(async()=>{const r=acceptStage9Ride(stage9State,{requestId:String(message.requestId??""),actor:stage9Actor(session),rideId:String(message.rideId??""),now:Date.now()});
          if(!await persistStage9Action(session,"accept-ride",r))return;sendStage9Result(session,"accept-ride",r);broadcastStage9States();});return;
      }
      if (message.type === "pickupStage9Ride") {
        await withMoneyMutation(async()=>{const ride=stage9State.rides.find(item=>item.id===String(message.rideId??"")),passenger=ride?players.get(ride.passengerId):undefined;
          if(!ride||!passenger){sendStage9Result(session,"pickup",{ok:false,state:stage9State,message:"The passenger is offline. Cancel the assignment and try again."});return;}
