function apartmentRoomLockButton(buildingId,roomNumber,locked){
 return '<button data-apartment-lock="'+(!locked)+'" data-apartment-building="'+buildingId+'" data-apartment-room="'+roomNumber+'">'+(locked?'🔓 Unlock room':'🔒 Lock room')+'</button>';
}
function openApartmentRoomMenu(p){
 const state=inside?.apartmentRooms?.find(r=>Number(r.roomNumber)===Number(p.roomNumber));
 if(!inside?.isApartmentBuilding||!state){sys("Apartment room information is still loading. Try the numbered door again.");return;}
 const occupied=!state.vacant,own=state.occupiedByMe===true,locked=state.locked===true,life=window.NRS?.life||{},canRent=own||!life.homeId;
 const days=Array.from({length:7},(_,i)=>'<option value="'+(i+1)+'">'+(i+1)+' day'+(i?'s':'')+' · ₦'+((i+1)*1500).toLocaleString('en-NG')+'</option>').join('');
 const status=own?'This is your private apartment. You can lock it to prevent visitors entering.':locked?'🔒 The tenant has locked this room. Visitors cannot enter until it is unlocked.':occupied?'This apartment is rented but unlocked. You may enter and look around; please respect the tenant’s property.':'This apartment is vacant and open for viewing. You can inspect it before renting.';
 const visit=own?'<button data-apartment-enter="'+p.roomNumber+'" data-apartment-building="'+p.buildingId+'">🚪 Enter my room</button>':
  locked?'<button disabled>🔒 Room locked by tenant</button>':
  '<button data-apartment-enter="'+p.roomNumber+'" data-apartment-building="'+p.buildingId+'">👀 '+(occupied?'Visit apartment':'Preview apartment')+'</button>';
 const rental=own?'<p><label>Extend tenancy <select id="apartmentRentDays">'+days+'</select></label></p><button data-apartment-rent="'+p.roomNumber+'" data-apartment-building="'+p.buildingId+'">Extend rent</button>':
  !occupied?'<p><label>Rent duration <select id="apartmentRentDays">'+days+'</select></label></p><button data-apartment-rent="'+p.roomNumber+'" data-apartment-building="'+p.buildingId+'" '+(canRent?'':'disabled')+'>Rent & enter room '+p.roomNumber+'</button>':'';
 panel('<div class="wm-head"><span>🏠</span><div><small>BLOCK '+safeText(inside.apartmentBuildingName.replace('Apartment Block #',''))+' · FLOOR '+inside.apartmentFloor+'</small><h2>Apartment Room #'+p.roomNumber+'</h2><p>'+safeText(inside.apartmentBuildingName)+' · '+(inside.apartmentFloors*APARTMENT_ROOMS_PER_FLOOR)+' total units</p></div></div>'+
  '<p class="wm-note">'+status+' Rooms on this floor are '+((inside.apartmentFloor-1)*APARTMENT_ROOMS_PER_FLOOR+1)+'–'+(inside.apartmentFloor*APARTMENT_ROOMS_PER_FLOOR)+'. This block has '+(inside.apartmentFloors*APARTMENT_ROOMS_PER_FLOOR)+' units in total.</p>'+
  '<div class="hm-price"><div><small>DAILY RENT</small><strong>₦1,500</strong></div><span>PER DAY</span></div>'+
  visit+rental+(own?apartmentRoomLockButton(p.buildingId,p.roomNumber,locked):'')+
  (!own&&!occupied&&!canRent?'<p>You already rent a separate house or apartment, so you cannot rent this room.</p>':''));
 modal.classList.add('apartment-menu');
}
function openApartmentElevatorMenu(){
 if(!inside?.isApartmentBuilding)return;
 const floor=inside.apartmentFloor,floors=inside.apartmentFloors;
 const buttons=Array.from({length:floors},(_,i)=>{
  const target=i+1,current=target===floor,label=target===1?'Ground Floor · Floor 1':'Floor '+target;
  return '<button data-apartment-floor="'+target+'" '+(current?'disabled':'')+'>'+label+(current?' · Current floor':'')+'</button>';
 }).join('');
 panel('<div class="wm-head"><span>🛗</span><div><small>'+safeText(inside.apartmentBuildingName)+'</small><h2>Elevator</h2><p>Currently on '+(floor===1?'Ground Floor':'Floor '+floor)+' of '+floors+'</p></div></div><p class="wm-note">Choose any floor directly. The street exit is only available on the Ground Floor (Floor 1).</p><div class="wm-buttons">'+buttons+'</div>');
 modal.classList.add('apartment-menu');
}
function openApartmentRoomSettings(){
 if(!inside?.isApartmentRoom||!inside.isApartmentRoomOwner)return;
 const locked=inside.apartmentRoomLocked===true;
 panel('<div id="apartmentRoomSettingsPanel"><div class="wm-head"><span>🔐</span><div><small>YOUR RENTED APARTMENT</small><h2>Room '+inside.apartmentRoomNumber+' access</h2><p>'+safeText(inside.apartmentBuildingName)+'</p></div></div><p class="wm-note">'+(locked?'Your room is locked. Visitors are blocked from entering.':'Your room is unlocked. Other players can enter and look around.')+'</p>'+apartmentRoomLockButton(inside.apartmentBuildingId,inside.apartmentRoomNumber,locked)+'</div>');
 modal.classList.add('apartment-menu');
}

refreshApartmentPOIs();
function openHouseMenu(h){
 const N=window.NRS||{},houses=N.houses||[],latest=houses.find(q=>q.id===h?.id)||h;
 if(!latest)return;h=latest;
 const life=N.life||{},own=!!h.occupiedByMe,vacant=!!h.vacant,locked=!!h.locked;
 const canVisit=own||vacant||!locked,canRent=vacant&&(!life.homeId||life.homeId===h.id);
 const daysLeft=Math.max(1,7-(own?Number(life.rentDays||0):0));
 const days=Array.from({length:Math.min(7,daysLeft)},(_,i)=>'<option value="'+(i+1)+'">'+(i+1)+' day'+(i?'s':'')+'</option>').join('');
 const state=own?(locked?'LOCKED · OWNER ACCESS':'YOUR HOME · OPEN'):vacant?'VACANT · OPEN FOR VIEWING':locked?'LOCKED BY OWNER':'OCCUPIED · VISITORS ALLOWED';
 const gate=own?'<button data-house-lock="'+h.id+'" data-house-lock-to="'+(!locked)+'">'+(locked?'🔓 Unlock house':'🔒 Lock house')+'</button>':'';
 const visit=canVisit?'<button data-house-visit="'+h.id+'">🚪 Enter and inspect</button>':'<button disabled>🔒 House locked</button><p>Only the owner can unlock this house.</p>';
 const rent=vacant?'<p><label>Rent duration <select id="houseRentDays">'+days+'</select></label></p><button data-house-rent="'+h.id+'" '+(canRent?'':'disabled')+'>🏠 Rent this house</button>'+(canRent?'':'<p>You already rent another house or have reached the prepaid-rent limit.</p>'):'';
 panel('<div class="hm-head"><span class="hm-icon">⌂</span><div class="hm-title"><small>PROPERTY DETAILS</small><h2>'+(h.name||'House')+'</h2><p>'+String(h.zone||'Port Harcourt')+' · '+h.id+'</p></div><span class="hm-closehint">HOME</span></div><div class="hm-status '+(own?'is-owned':vacant?'is-vacant':'is-occupied')+'"><i></i>'+state+'</div><div class="hm-price"><div><small>DAILY RENT</small><strong>₦'+Number(h.rentPerDay||0).toLocaleString('en-NG')+'</strong></div><span>PER DAY</span></div><div class="hm-actions">'+visit+gate+rent+'</div>');
 modal.classList.add('house-menu');
}
function poiAct(){let b=null,bd=3.4;if(!driving)for(const p of(inside?inside.pois:POI)){const d=Math.hypot(p.x-pos.x,p.z-pos.z);if(d<bd&&d<(p.r||9)){bd=d;b=p;}}
 if(b!==curPoi){curPoi=b;act2.style.display=b?'block':'none';if(b){
  if(b.t==='apartment-room')act2.textContent='Enter Room '+b.roomNumber;
  else if(b.t==='apartment-elevator')act2.textContent='Use Elevator';
  else if(b.t==='apartment-building-exit')act2.textContent='Exit to Street';
  else if(b.apartmentBuildingPoi)act2.textContent='Enter '+b.apartmentBuilding.buildingName;
  else act2.textContent=b.k+' · '+b.name;
 }}}
function openWorkplaceReceptionMenu(workplaceId){
 workplaceMenuOpen=false;
 const places=window.NRS?.workplaceState?.workplaces||window.NRS?.workplaces||[];
 const workplace=places.find(w=>w.id===workplaceId);
 if(!workplace){openWorkplaceMenuFor(workplaceId);return;}
 const name=safeText(workplace.name),kind=String(workplace.kind||'');
 const guidance=kind==='hospital'?'For treatment, approach a real on-duty medical worker wearing this hospital uniform.':
  ['police','frsc','fire','military'].includes(kind)?'For assistance, approach an on-duty uniformed officer or responder.':
  kind==='school'?'For school enquiries, the secretary can direct visitors to available staff.':
  'The secretary can direct visitors and staff requests to the right department.';
 panel('<div class="wm-head"><span>🏢</span><div><small>FRONT DESK · RECEPTION</small><h2>'+name+'</h2><p>Secretary / Reception</p></div></div><p>Welcome. Please tell the reception desk what you need.</p><p class="wm-note">'+guidance+'</p><div class="wm-buttons"><button data-reception-career="'+workplaceId+'">Workplace & staff services</button></div>');
 modal.classList.add('work-menu');modal.style.display='flex';
}
act2.onclick=()=>{const p=curPoi;if(!p)return;if(p.t==='forbes'){openForbesBoard();return;}if(p.t==='workplace'){window.NRS?.enterWorkplaceInterior(p.workplaceId);return;}if(p.t==='workplace-service'){openWorkplaceReceptionMenu(p.workplaceId);return;}if(p.t==='workplace-staff-room'){window.NRS?.enterStaffRoom(p.workplaceId);return;}if(p.t==='workplace-exit'){window.NRS?.exitWorkplaceInterior();return;}if(p.t==='uniform'){window.NRS?.changeWorkUniform(p.workplaceId);return;}if(p.t==='staffroom-exit'){window.NRS?.exitStaffRoom();return;}if(p.t==='apartment-elevator'){openApartmentElevatorMenu();return;}if(p.t==='apartment-room'){openApartmentRoomMenu(p);return;}if(p.t==='apartment-room-settings'){openApartmentRoomSettings();return;}if(p.t==='apartment-room-exit'){window.NRS?.exitApartmentRoom();return;}if(p.t==='apartment-building-exit'){window.NRS?.exitApartmentBuilding();return;}if(p.apartmentBuildingPoi){window.NRS?.enterApartmentBuilding(p.apartmentBuilding);return;}if(p.housePoi){const h=(window.NRS?.houses||[]).find(q=>q.id===p.houseId)||p.house;if(h){openHouseMenu(h);return;}sys('House details are still loading. Please try again.');return;}if(p.k==='Enter')return enterRoom(p);if(p.k==='Exit')return leaveRoom();
 shopP=p;pMsg='';if(p.t==='job')jobUI();else if(p.t==='bank'||p.t==='atm')bankUI();else shopUI();};
/* bank + ATM */
function bankUI(){
 panel('<div class="wm-head"><span>🏦</span><div><small>IN-GAME BANKING</small><h2>'+shopP.name+'</h2><p>Cash: ₦'+f(cash)+' · Bank: ₦'+f(bank)+'</p></div></div>'+
  '<p>Deposit and withdraw game currency, or send money to another player by their username.</p>'+
  '<div class="bank-actions">'+['d','w'].map(m=>[1000,5000,'all'].map(v=>'<button data-a="'+m+v+'">'+(m==='d'?'Deposit ':'Withdraw ')+(v==='all'?'all':'₦'+f(v))+'</button>').join(' ')).join('<br>')+'</div>'+
  '<div class="bank-transfer"><h3>Transfer game currency</h3><p>In-game bank balance only. This feature does not send or accept real money.</p>'+
  '<label>Player username<input id="moneyTransferUsername" maxlength="31" autocomplete="off" placeholder="Firstname_lastname"></label>'+
  '<label>Amount to transfer (₦)<input id="moneyTransferAmount" type="number" min="1" step="1" inputmode="numeric" placeholder="e.g. 2500"></label>'+
  '<button data-money-transfer="1">Transfer from bank</button></div>'+
  (pMsg?'<p><i>'+pMsg+'</i></p>':''));
 modal.classList.add('bank-menu');
}
/* Job Center — routes are generated from Port Harcourt's residential catalogue and registered building entrances. */
function deliveryText(value){return String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])).replace(/\s+/g,' ').trim().slice(0,120);}
const COURIER_FIXED_POINTS=[
 [-9.55,6],[-9.55,32],[-9.55,-52],[9.55,2],[9.55,28],[-20.55,-90],[20.55,-96],
 [-79,106],[155,-126],[180,144],[215,144],
 [-60,40],[-12,-20],[-30,20],[20,-52],[36,-8],[-28,-132],[30,100],[-50.5,-132],[185,-150],[16,54],
 [-8.4,-1],[-8.4,32],[-8.4,-52],[8.4,-24],[8.4,2],[8.4,28],[-8.4,-20]
];
function isKnownGeneratedApartmentPoint(x,z,meta){
 if(!meta||meta.generatedApartment!==true)return false;
 const cx=Number(meta.centerX),cz=Number(meta.centerZ),w=Number(meta.width),d=Number(meta.depth),h=Number(meta.height),axis=meta.entryAxis,sign=Number(meta.entrySign),id=String(meta.buildingId||'');
 if(![cx,cz,w,d,h].every(Number.isFinite)||Math.abs(cx)>270||Math.abs(cz)>270||w<8||w>40||d<8||d>40||h<5||h>60||(axis!=='x'&&axis!=='z')||(sign!==1&&sign!==-1)||id!=='apt-'+Math.round(cx*10)+'-'+Math.round(cz*10))return false;
 let gxOK=false,gzOK=false;for(let gx=-228;gx<=228;gx+=24)if(Math.abs(cx-gx)<=3.001){gxOK=true;break;}for(let gz=-228;gz<=180;gz+=24)if(Math.abs(cz-gz)<=3.001){gzOK=true;break;}if(!gxOK||!gzOK)return false;
 const ex=axis==='x'?cx+sign*(w/2+1.45):cx,ez=axis==='z'?cz+sign*(d/2+1.45):cz;
 return Math.hypot(Number(x)-ex,Number(z)-ez)<=.85;
}
function isKnownCourierHousePoint(x,z){
 const px=Number(x),pz=Number(z);
 if(!Number.isFinite(px)||!Number.isFinite(pz))return false;
 // Mirror the server's HOUSES entrance calculation so valid house and hut routes remain available.
 for(const h of HOUSE_PLOTS){
  const cls=String(h.cls||'flat'),size=HOUSE_SIZES[cls]||HOUSE_SIZES.flat;
  const front=cls==='hut'?size.w*.48:size.d/2;
  if(Math.hypot(px-Number(h.x),pz-(Number(h.z)+front+2.15))<=.85)return true;
 }
 return false;
}
function isKnownCourierPoint(x,z,meta){return COURIER_FIXED_POINTS.some(([px,pz])=>Math.hypot(Number(x)-px,Number(z)-pz)<=.85)||isKnownCourierHousePoint(x,z)||isKnownGeneratedApartmentPoint(x,z,meta);}
function deliveryLocations(){
 const locations=[],ids=new Set();
 const add=(id,name,x,z,kind='building',meta=null)=>{
  const px=Number(x),pz=Number(z),key=String(id??'');
  if(!key||!Number.isFinite(px)||!Number.isFinite(pz)||Math.abs(px)>270||Math.abs(pz)>270||ids.has(key))return;
  // Never show a job address unless the authoritative server validates this exact entrance.
  if(!isKnownCourierPoint(px,pz,meta||undefined))return;
  const label=deliveryText(name);
  if(!label)return;
  // Multiple systems can describe the same doorway (for example an apartment POI and its building collider).
  if(locations.some(v=>Math.hypot(v.x-px,v.z-pz)<2.2))return;
  ids.add(key);locations.push({id:key,name:label,x:px,z:pz,kind,...(meta?{meta}:{})});
 };
 // Start with every authored house/hut/compound/apartment-style home, then overlay live server records.
 const homes=new Map();
 if(Array.isArray(HOUSE_PLOTS))HOUSE_PLOTS.forEach(h=>{if(h?.id)homes.set(String(h.id),h);});
 if(Array.isArray(window.NRS?.houses))window.NRS.houses.forEach(h=>{if(h?.id)homes.set(String(h.id),h);});
 for(const h of homes.values()){
  const cls=String(h.cls||'flat'),size=HOUSE_SIZES[cls]||HOUSE_SIZES.flat;
  const visual=HOUSE_VISUALS[h.id],frontDepth=cls==='hut'?size.w*.48:size.d/2;
  const door=visual?.entrance||{x:Number(h.x),z:Number(h.z)+frontDepth+2.15};
  const kindLabel=HOUSE_LABELS[cls]||'HOME';
  const specific=String(h.name||(kindLabel+' '+String(h.id).replace(/[-_]+/g,' '))).trim();
  add('home:'+h.id,specific+' · '+String(h.zone||'Port Harcourt'),door.x,door.z,'home');
 }
 // Include every registered apartment entrance, shop, bank, Job Center and named workplace/public building.
 for(const p of (Array.isArray(POI)?POI:[])){
  if(!p||p.housePoi)continue;
  const kind=String(p.t||'');
  if(!(p.apartmentBuildingPoi||kind==='workplace'||kind==='shop'||kind==='bank'||kind==='job'))continue;
  const rawName=String(p.name||'Port Harcourt building').replace(/^(?:Enter|Inspect)\s+/i,'').trim();
  if(p.apartmentBuildingPoi){
   const apt=p.apartmentBuilding||{};
   const meta=apt.generated===true?{generatedApartment:true,centerX:Number(apt.x),centerZ:Number(apt.z),width:Number(apt.width),depth:Number(apt.depth),height:Number(apt.height),entryAxis:apt.entryAxis,entrySign:Number(apt.entrySign),buildingId:String(apt.buildingId||'')}:undefined;
   if(!isKnownCourierPoint(p.x,p.z,meta))continue;
   add('apartment:'+(apt.buildingId||apt.buildingName||rawName),apt.buildingName||rawName,p.x,p.z,'apartment',meta);
  }else if(kind==='workplace'){
   if(!isKnownCourierPoint(p.x,p.z))continue;
   add('workplace:'+(p.workplaceId||rawName),rawName,p.x,p.z,'workplace');
  }else{
   if(!isKnownCourierPoint(p.x,p.z))continue;
   add('poi:'+kind+':'+(p.shopId||rawName),rawName,p.x,p.z,kind);
  }
 }
 // Catch registered city structures that do not have a separate interaction POI.
 (Array.isArray(bld)?bld:[]).forEach((b,index)=>{
  if(!b||b.gen)return; // Procedurally seeded blocks need a server-shared world seed before paid routes can target them.
  const cx=Number(b.x),cz=Number(b.z);
  if(!Number.isFinite(cx)||!Number.isFinite(cz))return;
  const ex=Number.isFinite(Number(b.entryX))?Number(b.entryX):cx;
  const ez=Number.isFinite(Number(b.entryZ))?Number(b.entryZ):cz+Math.max(1,Number(b.hd)||0)+1.8;
  const id='structure:'+Math.round(cx*10)+':'+Math.round(cz*10);
  const label=(b.apartmentCandidate||b.gen)?'Residential apartment block '+(index+1):'Port Harcourt building '+(index+1);
  add(id,label,ex,ez,(b.apartmentCandidate||b.gen)?'apartment':'building');
 });
 // Keep the order stable so completing one run advances through the full address pool.
 locations.sort((a,b)=>a.id.localeCompare(b.id));
 return locations;
}
function buildDeliveryJobs(){
 const targets=deliveryLocations();
 if(targets.length<2)return [];
 const offset=Math.max(1,Math.floor(targets.length/2));
 return targets.map((destination,index)=>{
  let pickup=targets[(index+offset)%targets.length];
  let distance=Math.hypot(destination.x-pickup.x,destination.z-pickup.z);
  if(distance<8){for(let step=1;step<targets.length;step++){const candidate=targets[(index+offset+step)%targets.length],d=Math.hypot(destination.x-candidate.x,destination.z-candidate.z);if(d>=8&&d<=650){pickup=candidate;distance=d;break;}}}
  if(distance<8||distance>650)return null;
  const pay=Math.max(4500,Math.min(20000,Math.round((4000+distance*35)/500)*500));
  return {id:pickup.id+'->'+destination.id,name:('Delivery: '+pickup.name+' to '+destination.name).slice(0,160),pickup,destination,pay,addressCount:targets.length};
 }).filter(Boolean);
}
function nrsDeliveryWaypoint(){
 if(!job)return null;
 if(!job.pickedUp)return {x:Number(job.pickupX),z:Number(job.pickupZ),name:job.pickupName||'Pickup location',action:'Pickup'};
 return {x:Number(job.x),z:Number(job.z),name:job.destinationName||job.n||'Delivery address',action:'Drop-off'};
}
function jobUI(){
 const feedback=jobAcceptanceFeedback
  ?'<div class="jc-feedback" role="alert"><span aria-hidden="true">!</span><div><b>Delivery request not confirmed</b><small>'+deliveryText(jobAcceptanceFeedback)+'</small></div></div>'
  :'';
 if(job){
  const pickup=deliveryText(job.pickupName||'Pickup location');
  const destination=deliveryText(job.destinationName||job.n||'Delivery address');
  const status=job.pickedUp?'DELIVERY IN PROGRESS':'PICKUP REQUIRED';
  panel('<div class="jc-head"><div class="jc-emblem" aria-hidden="true">📦</div><div class="jc-heading"><small class="jc-eyebrow">PORT HARCOURT · COURIER NETWORK</small><h2>Job Center</h2><p>Your active delivery contract</p></div><span class="jc-status jc-active">IN PROGRESS</span></div>'+
   '<div class="jc-quote"><strong>'+(job.pickedUp?'Parcel collected — you are on the way.':'Your delivery is ready to begin.')+'</strong><small>Follow the highlighted route to complete the contract.</small></div>'+
   '<div class="jc-route"><div class="jc-stop"><span class="jc-stop-icon jc-pickup">01</span><div class="jc-stop-copy"><small>PICKUP LOCATION</small><b>'+pickup+'</b><span>'+(job.pickedUp?'Parcel collected ✓':'Get close to this entrance to collect your parcel')+'</span></div></div><div class="jc-route-arrow" aria-hidden="true">↓</div><div class="jc-stop"><span class="jc-stop-icon jc-dropoff">02</span><div class="jc-stop-copy"><small>DELIVER TO</small><b>'+destination+'</b><span>'+(job.pickedUp?'Bring the parcel here to get paid':'Your drop-off destination')+'</span></div></div></div>'+
   '<div class="jc-reward"><div><small>DELIVERY REWARD</small><strong>₦'+f(job.pay)+'</strong></div><span class="jc-reward-note">'+status+'<br>Paid on successful delivery</span></div>'+
   '<p class="jc-address-note">✓ Server-verified Port Harcourt address</p>'+feedback+
   '<button class="jc-careers" data-open-workplaces="1" type="button"><span>🏢 Careers &amp; factions</span><b aria-hidden="true">→</b></button>');
  modal.classList.add('job-center-menu');
  return;
 }

 const jobs=buildDeliveryJobs();
 if(!jobs.length){
  panel('<div class="jc-head"><div class="jc-emblem" aria-hidden="true">📦</div><div class="jc-heading"><small class="jc-eyebrow">PORT HARCOURT · COURIER NETWORK</small><h2>Job Center</h2><p>Local delivery contracts</p></div></div>'+
   '<div class="jc-empty"><span aria-hidden="true">🗺️</span><b>Preparing verified delivery routes</b><p>The address list is still syncing. Wait for the city to finish loading, then reopen the Job Center.</p></div>'+feedback+
   '<button class="jc-careers" data-open-workplaces="1" type="button"><span>🏢 Careers &amp; factions</span><b aria-hidden="true">→</b></button>');
  modal.classList.add('job-center-menu');
  return;
 }

 const j=jobs[((jobN%jobs.length)+jobs.length)%jobs.length];
 panel('<div class="jc-head"><div class="jc-emblem" aria-hidden="true">📦</div><div class="jc-heading"><small class="jc-eyebrow">PORT HARCOURT · COURIER NETWORK</small><h2>Job Center</h2><p>Verified local delivery contracts</p></div><span class="jc-status">AVAILABLE NOW</span></div>'+
  '<div class="jc-quote"><strong>“We need a rider for a delivery.”</strong><small>Accept this contract, collect the parcel, and deliver it to earn your reward.</small></div>'+
  '<div class="jc-route"><div class="jc-stop"><span class="jc-stop-icon jc-pickup">01</span><div class="jc-stop-copy"><small>PICKUP LOCATION</small><b>'+deliveryText(j.pickup.name)+'</b><span>First stop · Collect the parcel here</span></div></div><div class="jc-route-arrow" aria-hidden="true">↓</div><div class="jc-stop"><span class="jc-stop-icon jc-dropoff">02</span><div class="jc-stop-copy"><small>DELIVERY DESTINATION</small><b>'+deliveryText(j.destination.name)+'</b><span>Final stop · Reward paid after delivery</span></div></div></div>'+
  '<div class="jc-reward"><div><small>DELIVERY REWARD</small><strong>₦'+f(j.pay)+'</strong></div><span class="jc-reward-note">No upfront fee<br>Earn on completion</span></div>'+
  '<p class="jc-address-note">✓ Verified delivery entrances <span>·</span> '+j.addressCount+' mapped locations</p>'+feedback+
  '<div class="jc-actions"><button class="jc-accept" type="button" data-j="1" '+(jobAcceptancePending?'disabled aria-busy="true"':'')+'><span class="jc-accept-label">'+(jobAcceptancePending?'Connecting to server…':'Accept delivery')+'</span><span class="jc-accept-icon" aria-hidden="true">'+(jobAcceptancePending?'…':'→')+'</span></button><button class="jc-careers" data-open-workplaces="1" type="button"><span>🏢 Careers &amp; factions</span><b aria-hidden="true">→</b></button></div>'+
  '<p class="jc-footnote">The job becomes active only when the game server confirms acceptance.</p>');
 modal.classList.add('job-center-menu');
}
