/* ---------- Stage 5: pedestrians, zebra crossings, keke / danfo / okada traffic ---------- */
const PEDS=[],TV=[],pedObs=[],ZC=[-150,-60,-28,30,100,140];
ZC.forEach(z=>{for(let x=-4;x<=4.01;x+=1.3)flat(.6,3.2,wht,x,.055,z);});
const bx=(w,h,d,m,x,y,z,p)=>add(new THREE.BoxGeometry(w,h,d),m,x,y,z,p);
const TYM=M(0x141414),HBM=M(0xc9ced4),MKM=M(0x8a8f96),BLK=M(0x111111),
 GLM=new THREE.MeshBasicMaterial({color:0x9fc4dd,transparent:true,opacity:.45,side:THREE.DoubleSide,depthWrite:false}),
 DGM=new THREE.MeshBasicMaterial({color:0x1b2a36}),HLM=new THREE.MeshBasicMaterial({color:0xfff2c0}),TLM=new THREE.MeshBasicMaterial({color:0xb01818});
const WGc={};
function wheelAt(g,x,y,z,r,w){const k=r+'_'+w;if(!WGc[k]){const t=new THREE.CylinderGeometry(r,r,w,12);t.rotateZ(Math.PI/2);const h=new THREE.CylinderGeometry(r*.55,r*.55,w+.02,8);h.rotateZ(Math.PI/2);WGc[k]=[t,h,new THREE.BoxGeometry(w+.04,r*.28,r*.28)];}
 const pv=new THREE.Group();pv.position.set(x,y,z);g.add(pv);const sp=new THREE.Group();pv.add(sp);
 add(WGc[k][0],TYM,0,0,0,sp);add(WGc[k][1],HBM,0,0,0,sp);add(WGc[k][2],MKM,0,r*.72,0,sp);return {pv,sp,f:0};}
const hs=(r,m,x,y,z,p)=>add(new THREE.SphereGeometry(r,10,8),m,x,y,z,p);
const fc=(sk,r,x,y,z,p)=>{const f=mkFace(sk,HLMH,r);f.position.set(x,y,z);p.add(f);};const HLMH=M(0x111111);
function mkKeke(){const g=new THREE.Group(),body=new THREE.Group();g.add(body);
 const Y=M(0xe8b923),G=M(0x1f6f3a),sk=M(0x6b3e1f),sh=M(0x3a5fa0);
 bx(1.2,.12,2.1,BLK,0,.5,-.1,body);bx(1.0,.62,.9,Y,0,.85,1.0,body);bx(1.34,.75,1.4,Y,0,.95,-.6,body);
 [-1,1].forEach(s=>[.4,-1.25].forEach(z=>bx(.06,.62,.06,BLK,s*.64,1.64,z,body)));
 bx(1.5,.08,2.0,G,0,1.97,-.4,body);
 const ws=bx(1.0,.55,.03,GLM,0,1.6,.62,body);ws.rotation.x=-.25;
 bx(.06,.5,.06,BLK,0,1.05,.9,body);bx(.8,.05,.05,BLK,0,1.28,.85,body);
 bx(.4,.12,.4,BLK,0,.7,.2,body);bx(.34,.5,.2,sh,0,1.1,.15,body);hs(.11,sk,0,1.5,.15,body);fc(sk,.11,0,1.5,.15,body);
 bx(1.1,.12,.5,BLK,0,.7,-.75,body);bx(1.1,.5,.08,BLK,0,.98,-1.05,body);
 hs(.09,HLM,0,.9,1.47,body);bx(.5,.1,.04,TLM,0,.7,-1.33,body);
 const wh=[wheelAt(g,0,.3,1.3,.3,.14),wheelAt(g,-.62,.3,-.85,.3,.16),wheelAt(g,.62,.3,-.85,.3,.16)];
 return {g,body,wh,hw:.8,hd:1.55,type:'keke'};}
function mkDanfo(){const g=new THREE.Group(),body=new THREE.Group();g.add(body);const Y=M(0xf0c419);
 bx(2.0,1.45,5.0,Y,0,1.2,0,body);bx(2.03,.2,5.03,BLK,0,.88,0,body);bx(2.04,.5,3.3,DGM,0,1.6,-.5,body);
 bx(1.7,.6,.04,DGM,0,1.6,2.51,body);bx(2.02,.08,5.02,M(0xe8e8e8),0,1.97,0,body);
 [2.55,-2.55].forEach(z=>bx(2.1,.22,.2,BLK,0,.5,z,body));
 [-1,1].forEach(s=>{bx(.3,.18,.05,HLM,s*.7,.75,2.52,body);bx(.3,.16,.05,TLM,s*.7,.85,-2.52,body);});
 bx(1.0,.25,.04,BLK,0,.75,2.52,body);bx(.9,.22,.06,BLK,0,2.14,2.2,body);
 const wh=[];[[-1.02,1.65],[1.02,1.65],[-1.02,-1.65],[1.02,-1.65]].forEach(q=>wh.push(wheelAt(g,q[0],.42,q[1],.42,.22)));
 return {g,body,wh,hw:1.1,hd:2.6,type:'danfo'};}
function mkOkada(col,c1,c2){const g=new THREE.Group(),body=new THREE.Group();g.add(body);
 const F=M(col),sk=M(0x6b3e1f),s1=M(c1),s2=M(c2),pn=M(0x223044);
 bx(.16,.22,1.3,F,0,.6,0,body);bx(.28,.22,.5,F,0,.82,.3,body);bx(.26,.1,.95,BLK,0,.82,-.35,body);
 const fk=bx(.06,.62,.06,BLK,0,.66,.72,body);fk.rotation.x=.3;bx(.7,.05,.05,BLK,0,1.05,.58,body);
 hs(.07,HLM,0,.95,.82,body);bx(.15,.06,.04,TLM,0,.8,-.85,body);
 const t1=bx(.32,.5,.22,s1,0,1.2,-.05,body);t1.rotation.x=.25;hs(.11,sk,0,1.6,.06,body);fc(sk,.11,0,1.6,.06,body);
 add(new THREE.SphereGeometry(.125,10,8,0,Math.PI*2,0,Math.PI/2),M(0xcc2222),0,1.62,.06,body);
 [-1,1].forEach(s=>{bx(.1,.45,.14,pn,s*.2,.7,-.05,body);const a=bx(.06,.06,.5,s1,s*.22,1.12,.3,body);a.rotation.x=.4;bx(.1,.45,.14,pn,s*.22,.65,-.55,body);});
 bx(.32,.5,.22,s2,0,1.18,-.62,body);hs(.11,sk,0,1.56,-.6,body);fc(sk,.11,0,1.56,-.6,body);
 const wh=[wheelAt(g,0,.33,.78,.33,.12),wheelAt(g,0,.33,-.78,.33,.12)];
 return {g,body,wh,hw:.55,hd:1.3,type:'okada'};}
function mkTV(b,x,z,ry,vm){b.g.position.set(x,0,z);b.g.rotation.y=ry;keepVehicleVisible(b.g);scene.add(b.g);
 const c={g:b.g,body:b.body,wh:b.wh,box:{x,z,hw:b.hw,hd:b.hd},kind:'t',type:b.type,v:vm,vm,vx:0,vz:0,steer:0,ry,x,z,lx:x,roll:0,pitch:0,ph:Math.random()*6};
 boxes.push(c.box);tr.push(c);TV.push(c);return c;}
mkTV(mkKeke(),1.6,60,Math.PI,7);mkTV(mkDanfo(),1.6,-90,Math.PI,8);mkTV(mkOkada(0xb02a2a,0x2f6f4f,0xe8c14a),1.6,125,Math.PI,11);
mkTV(mkKeke(),-1.6,-65,0,7);mkTV(mkDanfo(),-1.6,45,0,8);mkTV(mkOkada(0x1d4a8a,0xc94a3a,0xf0f0f0),-1.6,-145,0,11);

/* pedestrians */
const PSK=[0x8d5524,0x6b3e1f,0x4a2a14,0xa8703c].map(M),PSH=[0xc94a3a,0x2f6f4f,0x3a5fa0,0xe8c14a,0x6a2a8a,0xf0f0f0,0x151515,0xd9863a].map(M),PPN=[0x1c2330,0x2b2b2b,0xa39373,0x3a4a6a,0x5a4030].map(M),HRM=M(0x111111);
const PG={t:new THREE.BoxGeometry(.36,.55,.2),h:new THREE.SphereGeometry(.11,12,9),hr:new THREE.SphereGeometry(.12,10,7),
 l:(()=>{const g=new THREE.CylinderGeometry(.075,.065,.82,6);g.translate(0,-.41,0);return g;})(),
 a:(()=>{const g=new THREE.CylinderGeometry(.05,.045,.55,6);g.translate(0,-.275,0);return g;})()};
const prn=a=>a[Math.floor(Math.random()*a.length)];
function mkPed(o){const g=new THREE.Group(),sk=prn(PSK),sh=prn(PSH),pn=prn(PPN);g.scale.setScalar(.92+Math.random()*.16);
 add(PG.t,sh,0,1.15,0,g);add(PG.h,sk,0,1.58,0,g).scale.set(.95,1.1,1);add(PG.hr,HRM,0,1.633,-.029,g).scale.set(1,.8,1);{const f=mkFace(sk,HRM,.11);f.position.set(0,1.58,0);g.add(f);}
 const lg=[-1,1].map(s=>{const p=new THREE.Group();p.position.set(s*.1,.85,0);g.add(p);add(PG.l,pn,0,0,0,p);return p;});
 const am=Math.random()<.5?sk:sh,ar=[-1,1].map(s=>{const p=new THREE.Group();p.position.set(s*.23,1.4,0);g.add(p);add(PG.a,am,0,0,0,p);return p;});
 scene.add(g);return Object.assign({g,lg,ar,ph:Math.random()*6,s:'walk',cd:0,t:0},o);}
const blocked=(x,z)=>boxes.some(b=>{if(b.hw<=0||b.hd<=0||(b.owner&&!b.owner.g.visible))return false;const e=objectHalfExtents(b);return Math.abs(x-b.x)<e.hw+.05&&Math.abs(z-b.z)<e.hd+.05;});
function laneClear(zc){for(const c of tr){const d=zc-c.z,vz=(c.ry>2?-1:1)*c.v;if(Math.abs(d)<3.5)return false;if(d*vz>0&&Math.abs(d)<10+Math.abs(c.v)*1.4)return false;}
 if(driving){const d=zc-driving.z;if(Math.abs(d)<4)return false;if(d*driving.vz>0&&Math.abs(d)<10+Math.abs(driving.v)*1.4)return false;}return true;}
function pedUpdate(p,dt){let vx=0,vz=0,mv=false;
 if(p.m==='w'){
  if(p.s==='walk'){p.x+=(p.lx-p.x)*Math.min(1,dt*2);if(p.cd>0)p.cd-=dt;const nz=p.z+p.dz*p.sp*dt;
   if(p.cd<=0)for(const zc of ZC){if((p.z-zc)*(nz-zc)<=0){p.cd=5;if(Math.random()<.45){p.s='wait';p.zc=zc;p.t=0;p.tx=-Math.sign(p.lx)*(5.7+Math.random()*1.5);p.z=zc+(Math.random()-.5)*2;break;}}}
   if(p.s==='walk'){if(Math.abs(nz)>185||blocked(p.x,nz+p.dz*.4))p.dz=-p.dz;else{p.z=nz;vz=p.dz*p.sp;mv=true;}}}
  else if(p.s==='wait'){p.t+=dt;if(laneClear(p.zc)||p.t>14)p.s='cross';}
  else{const d=p.tx-p.x,st=1.5*dt;if(Math.abs(d)<=st){p.x=p.tx;p.lx=p.tx;p.s='walk';p.cd=6;p.dz=Math.random()<.5?1:-1;}else{p.x+=Math.sign(d)*st;vx=Math.sign(d)*1.5;mv=true;}}}
 else if(p.idle>0)p.idle-=dt;
 else{p.tmr-=dt;const nx=p.x+Math.sin(p.hd)*p.sp*dt,nz=p.z+Math.cos(p.hd)*p.sp*dt;
  if(p.tmr<=0){p.hd=Math.random()*6.283;p.tmr=2+Math.random()*4;if(Math.random()<.4)p.idle=1+Math.random()*3;}
  else if(nx<p.x1||nx>p.x2||nz<p.z1||nz>p.z2||blocked(nx,nz)||roadNear(nx,nz,0)){p.hd=Math.random()*6.283;p.tmr=1.5+Math.random()*2;}
  else{p.x=nx;p.z=nz;vx=Math.sin(p.hd)*p.sp;vz=Math.cos(p.hd)*p.sp;mv=true;}}
 /* get out of the way of the player */
 if(driving){const dx=p.x-driving.x,dz=p.z-driving.z,d=Math.hypot(dx,dz);if(d<2.5&&d>.01&&Math.abs(driving.v)>2){p.x+=dx/d*6*dt;p.z+=dz/d*6*dt;}}
 else{const dx=p.x-pos.x,dz=p.z-pos.z,d=Math.hypot(dx,dz);if(d<.6&&d>.01){p.x+=dx/d*(.6-d)*.5;p.z+=dz/d*(.6-d)*.5;}}
 const sp=Math.hypot(vx,vz);if(mv)p.ph+=sp*dt*4.6;
 const am=mv?Math.min(1,sp/1.2)*.7:0,k=Math.min(1,dt*12),sw=Math.sin(p.ph)*am;
 p.lg[0].rotation.x+=(sw-p.lg[0].rotation.x)*k;p.lg[1].rotation.x+=(-sw-p.lg[1].rotation.x)*k;
 p.ar[0].rotation.x+=(-sw*.8-p.ar[0].rotation.x)*k;p.ar[1].rotation.x+=(sw*.8-p.ar[1].rotation.x)*k;
 const ta=mv?Math.atan2(vx,vz):(p.s==='wait'?Math.atan2(p.tx-p.x,0):p.g.rotation.y);let da=Math.atan2(Math.sin(ta-p.g.rotation.y),Math.cos(ta-p.g.rotation.y));
 p.g.rotation.y+=da*Math.min(1,dt*8);p.g.position.set(p.x,mv?Math.abs(Math.sin(p.ph))*.03:0,p.z);}
function peds(dt,t){pedObs.length=0;for(const p of PEDS){pedUpdate(p,dt);if(p.s==='cross')pedObs.push(p);}
 for(const c of TV)if(c.type==='okada')c.x=c.lx+Math.sin(t*.8+c.ph)*.35;}
for(let i=0;i<14;i++){const sd=i%2?1:-1;let x,z,n=0;
 do{x=sd*(5.7+Math.random()*1.6);z=-175+Math.random()*350;n++;}while(n<40&&(blocked(x,z)||blocked(x,z+3)||blocked(x,z-3)||ZC.some(c=>Math.abs(z-c)<3)||HR.some(r=>Math.abs(z-r[0])<9)));
 PEDS.push(mkPed({m:'w',x,z,lx:x,dz:Math.random()<.5?1:-1,sp:1+Math.random()*.7}));}
function spawnWander(n,x1,x2,z1,z2){for(let i=0;i<n;i++){let x,z,k=0;do{x=x1+Math.random()*(x2-x1);z=z1+Math.random()*(z2-z1);k++;}while(k<60&&(blocked(x,z)||roadNear(x,z,0)));
 PEDS.push(mkPed({m:'r',x,z,x1,x2,z1,z2,hd:Math.random()*6.283,sp:.8+Math.random()*.6,idle:Math.random()*2,tmr:1+Math.random()*3}));}}
spawnWander(7,-83,-14,80,111);spawnWander(5,22,78,125,185);

/* ---------- Stage 6: shop interiors, working backpack, ATM + bank, Job Center missions ---------- */
let bank=0,hp=100,hunger=82,lh=-1,lp=-1,bagMsg='',bagK=[],job=null,jobN=0,jobAcceptancePending=false,jobAcceptanceFeedback='',misT='';
const f=n=>Math.round(n).toLocaleString();
function sys(t){const d=document.createElement('div');d.innerHTML='<b>System:</b> ';d.append(t);$('log').append(d);$('log').scrollTop=1e5;}
function mis(h){if(h!==misT){misT=h;$('mis').innerHTML=h;}}
/* ATM kiosk on Aba Road pavement */
add(new THREE.BoxGeometry(.7,1.8,.9),M(0x2a3138),-7.6,.9,-36);boxes.push({x:-7.6,z:-36,hw:.4,hd:.5});
add(new THREE.PlaneGeometry(.5,.4),new THREE.MeshBasicMaterial({color:0x39a0ff,side:THREE.DoubleSide}),-7.24,1.3,-36).rotation.y=Math.PI/2;
mini('ATM',-7.22,1.85,-36,.7,'#0a4d8c').rotation.y=Math.PI/2;
POI.push({x:-6.9,z:-36,k:'Use',name:'ATM',t:'atm'});
/* mission beacon */
const beacon=new THREE.Mesh(new THREE.CylinderGeometry(1.2,1.2,40,16,1,true),new THREE.MeshBasicMaterial({color:0xffc928,transparent:true,opacity:.3,side:THREE.DoubleSide,depthWrite:false,fog:false}));
beacon.visible=false;scene.add(beacon);
/* Interiors are real walkable 3D rooms; coordinates are kept inside server world limits. */
const HOME_ROOMS=Object.create(null);
function homeRoom(d){
 const h=d.home||{},id=String(h.id||'my-home');
 if(HOME_ROOMS[id]){HOME_ROOMS[id].home=h;return HOME_ROOMS[id];}
 const ix=Number(d.roomX)||280,iz=Number(d.roomZ)||280,cls=h.cls||'flat';
 const plans={
  hut:{w:8.2,d:8.0,height:2.8,wall:0xbba07c,floor:0x8b7150,wood:0x65462e,soft:0xd2b48c,trim:0x5f412c,accent:0x9a7448},
  faceme:{w:10.2,d:8.8,height:3.0,wall:0xd6c9b0,floor:0x9c8b70,wood:0x694c35,soft:0x91a3ad,trim:0x5f4635,accent:0xb05c43},
  flat:{w:12.2,d:10.8,height:3.25,wall:0xe7e2d7,floor:0x9c927e,wood:0x65462e,soft:0x476a80,trim:0x5b4433,accent:0x276276},
  estate:{w:14.2,d:12.2,height:3.5,wall:0xe9e3d5,floor:0xb5a78d,wood:0x593d2c,soft:0x32624d,trim:0x8b6a3d,accent:0xb89a68},
  mansion:{w:16.2,d:14.2,height:3.9,wall:0xf0e6d8,floor:0xc0ad92,wood:0x50372b,soft:0x5b416e,trim:0xa98645,accent:0xc0a16a},
  palace:{w:18.2,d:16.2,height:4.25,wall:0xf4ebd8,floor:0xd2bd91,wood:0x4c321f,soft:0x6c4d20,trim:0xd0ad55,accent:0xe1c678},
  grand:{w:22.5,d:18.5,height:5.1,wall:0xf5f4ee,floor:0x999d9f,wood:0x252d34,soft:0x28616d,trim:0xd0ad55,accent:0x20adbb}
 };
 const p=plans[cls]||plans.flat,w=p.w,depth=p.d,height=p.height,frontZ=depth/2,doorW=1.75,doorH=2.35;
 const g=new THREE.Group();g.position.set(ix,0,iz);scene.add(g);
 const A=(geo,mat,x,y,z)=>add(geo,mat,x,y,z,g);
 const wall=new THREE.MeshLambertMaterial({color:p.wall,side:THREE.DoubleSide});
 const floorMat=M(p.floor),trim=M(p.trim),wood=M(p.wood),soft=M(p.soft),accent=M(p.accent);
 const dark=M(0x202b32),metal=M(0x343b3f),cream=M(0xf4eee0),glass=new THREE.MeshPhongMaterial({color:0x78aebd,transparent:true,opacity:.72,shininess:80,side:THREE.DoubleSide});
 const brass=M(0xc7a55d),rug=M(cls==='hut'?0x8f633d:cls==='palace'?0x6c252c:cls==='grand'?0x17344a:0x76513b);
 A(new THREE.BoxGeometry(w,.12,depth),floorMat,0,-.06,0);
 A(new THREE.BoxGeometry(w+.06,.045,depth+.06),trim,0,.012,0);
 A(new THREE.PlaneGeometry(w,depth),new THREE.MeshLambertMaterial({color:0xd0cabd,side:THREE.DoubleSide}),0,height,0).rotation.x=-Math.PI/2;
 // Per-class room envelope: compact traditional room, shared compound room, apartment, family house and luxury suites.
 const sideWinDepth=Math.min(1.65,depth*.15),sideWinHeight=1.05,sideWinY=Math.min(2.05,height*.62);
 function sideWall(side){
  const x=side*w/2,windows=[-depth*.22,depth*.22].map(v=>({z:v,start:v-sideWinDepth/2,end:v+sideWinDepth/2})).sort((a,b)=>a.start-b.start);
  let cursor=-depth/2;
  windows.forEach(win=>{
   const before=win.start-cursor;
   if(before>.05)A(new THREE.BoxGeometry(.18,height,before),wall,x,height/2,cursor+before/2);
   const lower=sideWinY-sideWinHeight/2,upper=height-(sideWinY+sideWinHeight/2);
   if(lower>.05)A(new THREE.BoxGeometry(.18,lower,sideWinDepth),wall,x,lower/2,win.z);
   if(upper>.05)A(new THREE.BoxGeometry(.18,upper,sideWinDepth),wall,x,sideWinY+sideWinHeight/2+upper/2,win.z);
   A(new THREE.BoxGeometry(.055,sideWinHeight,sideWinDepth-.08),glass,x-side*.025,sideWinY,win.z);
   A(new THREE.BoxGeometry(.12,.075,sideWinDepth+.12),trim,x-side*.04,sideWinY+sideWinHeight/2+.025,win.z);
   A(new THREE.BoxGeometry(.12,.075,sideWinDepth+.12),trim,x-side*.04,sideWinY-sideWinHeight/2-.025,win.z);
   A(new THREE.BoxGeometry(.12,sideWinHeight+.12,.075),trim,x-side*.04,sideWinY,win.z-sideWinDepth/2-.025);
   A(new THREE.BoxGeometry(.12,sideWinHeight+.12,.075),trim,x-side*.04,sideWinY,win.z+sideWinDepth/2+.025);
   A(new THREE.BoxGeometry(.08,sideWinHeight,.045),metal,x-side*.055,sideWinY,win.z);
   A(new THREE.BoxGeometry(.12,.05,sideWinDepth),metal,x-side*.055,sideWinY,win.z);
   cursor=win.end;
  });
  if(depth/2-cursor>.05)A(new THREE.BoxGeometry(.18,height,depth/2-cursor),wall,x,height/2,cursor+(depth/2-cursor)/2);
 }
 sideWall(-1);sideWall(1);
 // Rear wall has a real window opening; the front wall leaves a walkable doorway.
 const backWinW=Math.min(3.1,w*.3),backWinH=1.15,backWinY=Math.min(2.05,height*.62),backZ=-depth/2;
 const sideWidth=(w-backWinW)/2;
 A(new THREE.BoxGeometry(sideWidth,height,.18),wall,-backWinW/2-sideWidth/2,height/2,backZ);
 A(new THREE.BoxGeometry(sideWidth,height,.18),wall,backWinW/2+sideWidth/2,height/2,backZ);
 const lowerBack=backWinY-backWinH/2,upperBack=height-(backWinY+backWinH/2);
 if(lowerBack>.05)A(new THREE.BoxGeometry(backWinW,lowerBack,.18),wall,0,lowerBack/2,backZ);
 if(upperBack>.05)A(new THREE.BoxGeometry(backWinW,upperBack,.18),wall,0,backWinY+backWinH/2+upperBack/2,backZ);
 A(new THREE.BoxGeometry(backWinW-.1,backWinH-.08,.055),glass,0,backWinY,backZ+.045);
 A(new THREE.BoxGeometry(backWinW+.16,.075,.13),trim,0,backWinY+backWinH/2+.025,backZ+.045);
 A(new THREE.BoxGeometry(backWinW+.16,.075,.13),trim,0,backWinY-backWinH/2-.025,backZ+.045);
 A(new THREE.BoxGeometry(.08,backWinH+.12,.13),trim,-backWinW/2-.04,backWinY,backZ+.045);
 A(new THREE.BoxGeometry(.08,backWinH+.12,.13),trim,backWinW/2+.04,backWinY,backZ+.045);
 A(new THREE.BoxGeometry(.06,backWinH,.06),metal,0,backWinY,backZ+.085);
 A(new THREE.BoxGeometry(backWinW, .06,.06),metal,0,backWinY,backZ+.085);
 const frontSeg=(w-doorW)/2;
 A(new THREE.BoxGeometry(frontSeg,height,.18),wall,-doorW/2-frontSeg/2,height/2,frontZ);
 A(new THREE.BoxGeometry(frontSeg,height,.18),wall,doorW/2+frontSeg/2,height/2,frontZ);
