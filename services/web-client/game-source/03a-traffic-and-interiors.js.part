 const r=room(p);r.ret={x:p.x,z:p.z,sx:p.sx};inside=r;pos.set(r.x,0,r.z+3.2);vel.set(0,0,0);face=Math.PI;camYaw=0;camPitch=.3;focus.set(pos.x,1.4,pos.z);modal.style.display='none';curPoi=null;act2.style.display='none';}
function leaveRoom(){if(!inside)return;if(inside.isShopInterior){window.NRS?.exitShopInterior();return;}if(inside.isApartmentRoom){window.NRS?.exitApartmentRoom();return;}if(inside.isApartmentBuilding){window.NRS?.exitApartmentBuilding();return;}openExitRouteMenu();}
const APARTMENT_FACADE_DETAILS=Object.create(null);
const APARTMENT_BLOCK_NUMBERS=new Map();
const APARTMENT_ROOMS_PER_FLOOR=10;
let APARTMENT_INTERIOR_VISUAL=null;
const APARTMENT_INTERIOR_COLLIDERS=[];
function addApartmentInteriorCollider(x,z,hw,hd,kind='wall'){
 const collider={x,z,hw,hd,apartmentInteriorWall:true,kind};boxes.push(collider);APARTMENT_INTERIOR_COLLIDERS.push(collider);return collider;
}
function apartmentBlockId(b){return "apt-"+Math.round(b.x*10)+"-"+Math.round(b.z*10);}
function apartmentBlockNumber(b){return APARTMENT_BLOCK_NUMBERS.get(apartmentBlockId(b))||1;}
function apartmentBuildingName(b){
 return "Apartment Block #"+String(apartmentBlockNumber(b)).padStart(3,'0');
}
function apartmentBuildingPayload(b){
 const id="apt-"+Math.round(b.x*10)+"-"+Math.round(b.z*10),floors=Math.max(2,Math.min(10,Math.floor(Number(b.h)/4)));
 return {buildingId:id,buildingName:apartmentBuildingName(b),x:Number(b.x),z:Number(b.z),
  entryX:Number(b.entryX),entryZ:Number(b.entryZ),width:Number(b.hw*2),depth:Number(b.hd*2),height:Number(b.h),floors,
  entryAxis:b.entryAxis||'x',entrySign:Number(b.entrySign)||1,generated:b.gen===true};
}
function addApartmentExteriorDetails(b,id){
 if(APARTMENT_FACADE_DETAILS[id])return;
 const root=new THREE.Group();root.position.set(b.x,0,b.z);scene.add(root);
 const A=(geo,mat,x,y,z)=>{const o=new THREE.Mesh(geo,mat);o.position.set(x,y,z);root.add(o);return o;};
 const trim=M(0x38434b),door=M(0x18262e),step=M(0x9a9b96),glass=new THREE.MeshPhongMaterial({color:0x83b5c6,transparent:true,opacity:.65,side:THREE.DoubleSide});
 const axis=b.entryAxis||'x',sign=b.entrySign||1,fx=axis==='x'?sign*b.hw:0,fz=axis==='z'?sign*b.hd:0;
 if(!b.gen){
  if(axis==='x'){
   A(new THREE.BoxGeometry(.20,2.65,2.35),trim,fx+sign*.05,1.33,0);
   A(new THREE.BoxGeometry(.10,2.28,1.65),door,fx+sign*.16,1.15,0);
   A(new THREE.BoxGeometry(.04,2.05,.07),M(0x899aa0),fx+sign*.22,1.15,0);
   A(new THREE.BoxGeometry(.08,.1,.1),M(0xd0b66d),fx+sign*.24,1.08,.48);
  }else{
   A(new THREE.BoxGeometry(2.35,2.65,.20),trim,0,1.33,fz+sign*.05);
   A(new THREE.BoxGeometry(1.65,2.28,.10),door,0,1.15,fz+sign*.16);
   A(new THREE.BoxGeometry(.07,2.05,.04),M(0x899aa0),0,1.15,fz+sign*.22);
   A(new THREE.BoxGeometry(.1,.1,.04),M(0xd0b66d),.48,1.08,fz+sign*.24);
  }
 }
 for(let stepNo=0;stepNo<3;stepNo++){
  const width=2.8-stepNo*.28,depth=1.0,y=.10+stepNo*.17,offset=1.1+stepNo*.72;
  if(axis==='x')A(new THREE.BoxGeometry(depth,.18,width),step,fx+sign*offset,y,0);
  else A(new THREE.BoxGeometry(width,.18,depth),step,0,y,fz+sign*offset);
 }
 const boardTex=tex(512,112,(g,w,h)=>{
  g.fillStyle='#17313e';g.fillRect(0,0,w,h);
  g.fillStyle='#d8ad52';g.fillRect(0,0,w,9);g.fillRect(0,h-9,w,9);
  const floors=Math.max(2,Math.min(10,Math.floor(Number(b.h)/4)));
  const block=String(apartmentBlockNumber(b)).padStart(3,'0');
  g.fillStyle='#fff';g.textAlign='center';g.font='bold 32px system-ui';g.fillText('APARTMENT BLOCK #'+block,w/2,50);
  g.fillStyle='#b8e7f4';g.font='bold 20px system-ui';g.fillText((floors*APARTMENT_ROOMS_PER_FLOOR)+' UNITS · '+floors+' FLOORS',w/2,84);
 });
 let boardX,boardZ,boardYaw;
 if(axis==='x'){boardX=fx+sign*.19;boardZ=0;boardYaw=sign>0?Math.PI/2:-Math.PI/2;}
 else {boardX=0;boardZ=fz+sign*.19;boardYaw=sign>0?0:Math.PI;}
 readableTextBoard(root,new THREE.PlaneGeometry(3.8,.84),boardTex,boardX,3.25,boardZ,boardYaw);
 APARTMENT_FACADE_DETAILS[id]=root;
}
function refreshApartmentPOIs(){
 for(let i=POI.length-1;i>=0;i--)if(POI[i].apartmentBuildingPoi)POI.splice(i,1);
 APARTMENT_BLOCK_NUMBERS.clear();
 const numberedBlocks=bld.filter(b=>(b.apartmentCandidate||b.gen)&&Number.isFinite(Number(b.h))&&b.h>=5&&b.hw>=4&&b.hd>=4)
  .slice().sort((a,b)=>Number(a.x)-Number(b.x)||Number(a.z)-Number(b.z));
 numberedBlocks.forEach((b,index)=>APARTMENT_BLOCK_NUMBERS.set(apartmentBlockId(b),index+1));
 const activeIds=new Set();
 for(const b of bld){
  if((!b.apartmentCandidate&&!b.gen)||!Number.isFinite(Number(b.h))||b.h<5||b.hw<4||b.hd<4)continue;
  const id="apt-"+Math.round(b.x*10)+"-"+Math.round(b.z*10);
  if(activeIds.has(id))continue;
  activeIds.add(id);
  const building=apartmentBuildingPayload(b);
  addApartmentExteriorDetails(b,id);
  POI.push({x:building.entryX,z:building.entryZ,k:'Enter',name:'Enter '+building.buildingName,
   t:'apartment-building',r:4.5,apartmentBuildingPoi:true,apartmentBuilding:building});
 }
 for(const [id,root] of Object.entries(APARTMENT_FACADE_DETAILS)){
  if(!activeIds.has(id)){scene.remove(root);delete APARTMENT_FACADE_DETAILS[id];}
 }
}

function apartmentText(text,bg='#183441',fg='#fff'){
 return tex(512,128,(g,w,h)=>{
  g.fillStyle=bg;g.fillRect(0,0,w,h);
  g.fillStyle='#d7b15d';g.fillRect(0,0,w,8);g.fillRect(0,h-8,w,8);
  g.fillStyle=fg;g.textAlign='center';g.font='bold '+(text.length>16?30:42)+'px system-ui';g.fillText(text,w/2,h*.61,w-24);
 });
}
function clearApartmentInteriorVisual(){
