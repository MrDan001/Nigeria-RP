/* ---------- Character: black NIGERIA RP tee, cap, baggy jeans, sneakers ---------- */
const SKIN=[0x8d5524,0x6b3e1f,0x4a2a14,0xa8703c],HAIR=[0x111111,0x1a1a1a,0x2b1b12,0x111111];
const OUTFITS=[
 {top:0x151515,bottom:0x1c2330,shoe:0xf2f2f2,short:false,long:false,cap:true,print:true},
 {top:0x2f6f4f,bottom:0xa39373,shoe:0x3a2a20,short:false,long:false,cap:false},
 {top:0xc94a3a,bottom:0x2b2b2b,shoe:0x222222,short:true,long:false,cap:false},
 {top:0x3a5fa0,bottom:0x1d2a44,shoe:0xcccccc,short:false,long:true,cap:false}];
const look={o:0,s:0},mat={skin:M(0),top:M(0),bottom:M(0),shoe:M(0),hair:M(0),fore:M(0),shin:M(0),eye:M(0x111111),cap:M(0x101010)};
let capParts=[],printMesh,activeUniformWorkplaceId=null,selectedAppearance=null,avatarShoulders=null,avatarHips=null;
const hairStyleParts={afro:[],braids:[],locs:[]};
const UNIFORM_LOOKS={
 'market-mile1':{top:0x7b2929,bottom:0x282b30,shoe:0x1c1c1c,long:true,cap:false,print:false},
 'bank-main':{top:0x172b49,bottom:0x182031,shoe:0x202020,long:true,cap:false,print:false},
 'hospital-main':{top:0xf1f2ec,bottom:0x2d5369,shoe:0xe5e9ed,long:true,cap:false,print:false},
 'hospital-princess':{top:0xe9f6f6,bottom:0x167f8b,shoe:0xe5e9ed,long:true,cap:false,print:false},
 'park-main':{top:0x2e7945,bottom:0x29362b,shoe:0x282828,long:true,cap:true,print:false},
 'news-main':{top:0x34354d,bottom:0x202232,shoe:0x242424,long:true,cap:false,print:false},
 'gov-rivers':{top:0x8a8f98,bottom:0x29303a,shoe:0x1c1c1c,long:true,cap:false,print:false},
 'police-rivers':{top:0x1b345f,bottom:0x14213a,shoe:0x111827,long:true,cap:true,print:false},
 'frsc-rivers':{top:0x17744b,bottom:0x243c30,shoe:0x1b231c,long:true,cap:true,print:false},
 'fire-rivers':{top:0xc94a21,bottom:0x292c32,shoe:0x202020,long:true,cap:true,print:false},
 'army-rivers':{top:0x4e5b2e,bottom:0x3d4827,shoe:0x292719,long:true,cap:true,print:false},
 'transport-union':{top:0x286ab1,bottom:0x24272b,shoe:0x252525,long:true,cap:false,print:false},
 'school-primary':{top:0x27794d,bottom:0x263c31,shoe:0x202020,long:true,cap:false,print:false},
 'school-secondary':{top:0x2c5489,bottom:0x27364c,shoe:0x202020,long:true,cap:false,print:false}
};
function dress(){
 const uniform=UNIFORM_LOOKS[activeUniformWorkplaceId],o=uniform?{...OUTFITS[look.o],...uniform}:OUTFITS[look.o],sk=SKIN[look.s];
 mat.skin.color.setHex(sk);mat.hair.color.setHex(HAIR[look.s]);mat.top.color.setHex(o.top);mat.bottom.color.setHex(o.bottom);mat.shoe.color.setHex(o.shoe);
 mat.fore.color.setHex(o.long?o.top:sk);mat.shin.color.setHex(o.short?sk:o.bottom);
 if(selectedAppearance&&!uniform){
  const hex=v=>/^#[0-9a-f]{6}$/i.test(String(v||''))?parseInt(v.slice(1),16):null;
  const tops={cream:0xf1ece1,black:0x17191d,green:0x167c53,red:0xa83232,blue:0x2e66a6},bottoms={denim:0x41658b,black:0x1b1d20,khaki:0x8a7954,white:0xe8e5df},shoes={white:0xeeeeea,black:0x17191b,brown:0x654027};
  const sh=hex(selectedAppearance.skin),hh=hex(selectedAppearance.hair);
  if(sh!==null)mat.skin.color.setHex(sh);if(hh!==null)mat.hair.color.setHex(hh);
  if(tops[selectedAppearance.top]!=null)mat.top.color.setHex(tops[selectedAppearance.top]);
  if(bottoms[selectedAppearance.bottom]!=null)mat.bottom.color.setHex(bottoms[selectedAppearance.bottom]);
  if(shoes[selectedAppearance.shoes]!=null)mat.shoe.color.setHex(shoes[selectedAppearance.shoes]);
  mat.fore.color.copy(mat.skin.color);mat.shin.color.copy(mat.bottom.color);
 }
 capParts.forEach(c=>c.visible=!!o.cap&&(!selectedAppearance||!!uniform));
 if(printMesh)printMesh.visible=!!o.print;
 hairStyleParts.afro.forEach(o=>o.visible=selectedAppearance?.hairStyle==='afro');
 hairStyleParts.braids.forEach(o=>o.visible=selectedAppearance?.hairStyle==='long-braids');
 hairStyleParts.locs.forEach(o=>o.visible=selectedAppearance?.hairStyle==='locs');
 if(avatarShoulders)avatarShoulders.scale.set(selectedAppearance?.gender==='female' ? .235 : .255,.145,.18);
 if(avatarHips)avatarHips.scale.set(selectedAppearance?.gender==='female' ? 1.13 : 1,1,1);
}
const player=new THREE.Group();scene.add(player);
const model=new THREE.Group();model.position.y=.085;player.add(model);

// Canonical local-player nameplate: identity is supplied by the authenticated online session event.
const ownTagCanvas=document.createElement('canvas');ownTagCanvas.width=640;ownTagCanvas.height=140;
const ownTagCtx=ownTagCanvas.getContext('2d');
const ownTagTexture=new THREE.CanvasTexture(ownTagCanvas);ownTagTexture.colorSpace=THREE.SRGBColorSpace;
const ownTagMaterial=new THREE.SpriteMaterial({map:ownTagTexture,transparent:true,depthTest:false,depthWrite:false});
const ownTag=new THREE.Sprite(ownTagMaterial);ownTag.scale.set(3.65,.8,1);ownTag.position.set(0,2.3,0);ownTag.renderOrder=51;ownTag.visible=false;player.add(ownTag);
let ownTagLast='';
function syncOwnPlayerTag(identity){
 if(!identity||!identity.name){ownTag.visible=false;return;}
 const username=String(identity.name).trim();
 const level=Math.max(1,Math.floor(Number(identity.level)||1));
 const sessionId=String(identity.sessionId||identity.displayId||'000').padStart(3,'0');
 if(!username){ownTag.visible=false;return;}
 const trait=String(window.NRS?.characterAppearance?.trait||selectedAppearance?.trait||'');
 const key=sessionId+'|'+username+'|'+level+'|'+trait;
 if(key===ownTagLast){ownTag.visible=true;return;}
 ownTagLast=key;
 ownTagCtx.clearRect(0,0,640,140);
 // Transparent text-only nameplate: session ID, username, then player level.
 ownTagCtx.textAlign='center';ownTagCtx.textBaseline='middle';ownTagCtx.lineJoin='round';
 ownTagCtx.lineWidth=4;ownTagCtx.strokeStyle='rgba(0,0,0,.96)';
 ownTagCtx.shadowColor='rgba(0,0,0,.9)';ownTagCtx.shadowBlur=7;
 const identityLine=sessionId+' | '+username;
 let fs=34;ownTagCtx.font='700 '+fs+'px system-ui,sans-serif';
 while(fs>20&&ownTagCtx.measureText(identityLine).width>590){fs-=2;ownTagCtx.font='700 '+fs+'px system-ui,sans-serif';}
 ownTagCtx.strokeText(identityLine,320,43,594);ownTagCtx.fillStyle='#ffffff';ownTagCtx.fillText(identityLine,320,43,594);
 const metaLine='Level '+level+(trait?' · '+trait:'');
 ownTagCtx.font='800 21px system-ui,sans-serif';ownTagCtx.strokeText(metaLine,320,101,590);
 ownTagCtx.fillStyle='#a7efff';ownTagCtx.fillText(metaLine,320,101,590);ownTagCtx.shadowBlur=0;
 ownTagTexture.needsUpdate=true;ownTag.visible=true;
}
window.addEventListener('nrs-player-identity',event=>syncOwnPlayerTag(event.detail));
syncOwnPlayerTag(window.NRS?.playerIdentity);
// Empty compatibility node only. The old capsule/sphere body has been removed from source.
const upper=new THREE.Group();upper.name='legacyCompatibilityNode';model.add(upper);
const arm=[],elbow=[],leg=[],knee=[];
capParts=[];printMesh=null;avatarShoulders=null;avatarHips=null;
dress();

// The procedural block geometry is removed; the Diesel GLB is the only visible player asset.
model.visible=false;

let dieselAvatarRoot=null, dieselAnimator=null;
function nrsDieselPartKind(node, material) {
 const s=(String(node?.name||'')+' '+String(material?.name||'')).toLowerCase();
 if(/hair|beard|moustache|mustache|eyebrow|brow/.test(s))return 'hair';
 if(/shoe|sneaker|boot|footwear|trainer|sandal/.test(s))return 'shoes';
 if(/trouser|pants|jeans|denim|shorts|skirt|leggings|lowerwear|bottom/.test(s))return 'bottom';
 if(/shirt|t.?shirt|tee|hoodie|jacket|coat|sweater|upperwear|outfit|clothing|blouse|dress|torso/.test(s))return 'top';
 if(/skin|face|head|neck|hand|arm|leg|body/.test(s))return 'skin';
 return '';
}
function nrsDieselStyleTag(node) {
 const s=(String(node?.name||'')+' '+(Array.isArray(node?.material)?node.material.map(m=>m?.name||'').join(' '):(node?.material?.name||''))).toLowerCase();
 if(/long.?braid|braid/.test(s))return 'long-braids';
 if(/afro|natural.?curl/.test(s))return 'afro';
 if(/dread|locs?/.test(s))return 'locs';
 if(/short.?hair|buzz.?cut/.test(s))return 'short';
 return '';
}
function applyDieselModelAppearance(root, appearance) {
 if(!root||!appearance)return {mappedParts:[],styleVariants:0};
 const tops={cream:'#f1ece1',black:'#17191d',green:'#167c53',red:'#a83232',blue:'#2e66a6'};
 const bottoms={denim:'#41658b',black:'#1b1d20',khaki:'#8a7954',white:'#e8e5df'};
 const shoes={white:'#eeeeea',black:'#17191b',brown:'#654027'};
 const colors={skin:/^#[0-9a-f]{6}$/i.test(String(appearance.skin||''))?appearance.skin:'#7b4528',hair:/^#[0-9a-f]{6}$/i.test(String(appearance.hair||''))?appearance.hair:'#17120f',top:tops[appearance.top]||tops.cream,bottom:bottoms[appearance.bottom]||bottoms.denim,shoes:shoes[appearance.shoes]||shoes.white};
 const mapped=new Set(),styleMeshes=[];
 root.traverse(node=>{
  if(!node.isMesh)return;
  if(!node.userData.nrsDieselMaterialsCloned){const m=node.material;node.material=Array.isArray(m)?m.map(x=>x?.clone?.()||x):(m?.clone?.()||m);node.userData.nrsDieselMaterialsCloned=true;}
  const mats=Array.isArray(node.material)?node.material:[node.material];
  for(const m of mats){const k=nrsDieselPartKind(node,m);if(k&&m?.color&&colors[k]){m.color.set(colors[k]);mapped.add(k);}}
  const style=nrsDieselStyleTag(node);if(style)styleMeshes.push({node,style});
 });
 const styles=new Set(styleMeshes.map(x=>x.style));
 if(styles.size>1)styleMeshes.forEach(x=>{x.node.visible=x.style===appearance.hairStyle;});
 return {mappedParts:[...mapped],styleVariants:styles.size};
}
function attachDieselAnimator(root, clips) {
 const animations=Array.isArray(clips)?clips:[],lower=s=>String(s||'').toLowerCase(),mixer=new THREE.AnimationMixer(root);
 let idleClip=animations.find(c=>/idle|stand|rest|breath|neutral/i.test(c.name||''));
 const walkClip=animations.find(c=>/walk|run|jog/i.test(c.name||''));
 if(!idleClip&&!walkClip&&animations.length)idleClip=animations[0];
 const idleAction=idleClip?mixer.clipAction(idleClip):null,walkAction=walkClip&&walkClip!==idleClip?mixer.clipAction(walkClip):null;
 if(idleAction)idleAction.play();if(walkAction){walkAction.play();walkAction.setEffectiveWeight(0);}
 const tracks=animations.flatMap(c=>c.tracks||[]).map(t=>lower(t.name)),bounds=new THREE.Box3().setFromObject(root),center=bounds.getCenter(new THREE.Vector3()),fallbackBones=[];
 root.updateMatrixWorld(true);
 root.traverse(node=>{
  if(!node.isBone)return;
  const n=lower(node.name).replace(/[^a-z0-9]/g,'');let kind='';
  if(/(upperarm|leftarm|rightarm|arm[lr]|shoulder|clavicle)/.test(n)&&!/(fore|lower|hand|twist)/.test(n))kind='arm';
  else if(/(forearm|lowerarm|leftforearm|rightforearm|armroll)/.test(n))kind='forearm';
  else if(/(upperleg|upleg|thigh|leftupleg|rightupleg|leg[lr])/.test(n)&&!/(lower|calf|shin|foot)/.test(n))kind='thigh';
  else if(/(lowerleg|leftleg|rightleg|calf|shin|knee)/.test(n)&&!/(upper|thigh|upleg)/.test(n))kind='shin';
  if(!kind)return;
  const wp=new THREE.Vector3();node.getWorldPosition(wp);
  const sign=kind==='arm'||kind==='forearm'?(wp.x>=center.x?-1:1):(wp.x>=center.x?1:-1);
  fallbackBones.push({bone:node,base:node.quaternion.clone(),kind,sign,phase:wp.x>=center.x?0:Math.PI});
 });
 function pose(t,speed) {
  const walk=Math.max(0,Math.min(1,Math.abs(Number(speed)||0)/2.5));
  for(const p of fallbackBones){let x=0,y=0,z=0;
   if(p.kind==='arm')z=p.sign*(1.18+Math.sin(t*1.65+p.phase)*.018+Math.sin(t*6+p.phase)*walk*.16);
   else if(p.kind==='forearm')z=p.sign*(.12+Math.max(0,Math.sin(t*6+p.phase))*walk*.34);
   else if(p.kind==='thigh')x=Math.sin(t*6+p.phase)*walk*.38;
   else if(p.kind==='shin')x=Math.max(0,Math.sin(t*6+p.phase))*walk*.42;
   p.bone.quaternion.copy(p.base).multiply(new THREE.Quaternion().setFromEuler(new THREE.Euler(x,y,z)));
  }
 }
 function update(dt,t,speed=0){const w=Math.max(0,Math.min(1,Math.abs(Number(speed)||0)/2.7));if(walkAction)walkAction.setEffectiveWeight(w);if(idleAction)idleAction.setEffectiveWeight(walkAction?1-w:1);pose(t,speed);mixer.update(Math.max(0,Math.min(Number(dt)||0,.05)));}
 function reset(){mixer.stopAllAction();for(const p of fallbackBones)p.bone.quaternion.copy(p.base);mixer.uncacheRoot(root);}
 return {update,reset,mixer,animationNames:animations.map(a=>a.name),fallbackBoneCount:fallbackBones.length};
}
window.NRS=window.NRS||{};window.NRS.applyDieselModelAppearance=applyDieselModelAppearance;window.NRS.attachDieselAnimator=attachDieselAnimator;

function loadDieselAvatar(){
 model.visible=false;
 if(!window.THREE?.GLTFLoader){window.NRS.dieselAvatar={status:'error',loaded:false,error:'GLTFLoader unavailable'};return;}
 const loader=new THREE.GLTFLoader();loader.setCrossOrigin?.('anonymous');const url='/Diesel.glb?rev=diesel-no-block-animated-20261018b';
 const started=performance.now();let settled=false;window.NRS.dieselAvatar={status:'loading',loaded:false,url};
 const timeout=setTimeout(()=>{if(settled)return;settled=true;window.NRS.dieselAvatar={status:'timeout',loaded:false,url};console.error('[Nigeria RP] Diesel model timed out; block fallback stays hidden.');},20000);
 loader.load(url,gltf=>{
  if(settled)return;settled=true;clearTimeout(timeout);
  try{
   const imported=gltf.scene;if(!imported)throw new Error('GLB contains no scene');
   const bounds=new THREE.Box3().setFromObject(imported),size=bounds.getSize(new THREE.Vector3()),center=bounds.getCenter(new THREE.Vector3());
   if(!Number.isFinite(size.x+size.y+size.z)||size.x<=0||size.y<=0||size.z<=0)throw new Error('Invalid model bounds');
   let meshes=0,skinned=0,bones=0;imported.traverse(o=>{if(o.isMesh){meshes++;if(o.isSkinnedMesh){skinned++;bones+=o.skeleton?.bones?.length||0;o.castShadow=true;o.receiveShadow=true;}}});
   if(!meshes)throw new Error('GLB has no visible meshes');
   const scale=1.62/size.y;imported.scale.multiplyScalar(scale);imported.position.set(-center.x*scale,-bounds.min.y*scale+.80,-center.z*scale);
   model.add(imported);model.children.forEach(child=>{if(child!==imported)child.visible=false;});
   dieselAvatarRoot=imported;window.NRS.dieselAvatarRoot=imported;
   const appearance=window.NRS.characterAppearance||selectedAppearance||{skin:'#7b4528',hair:'#17120f',hairStyle:'long-braids',top:'black',bottom:'denim',shoes:'white',accessory:'gold',gender:'male',trait:'Creative',expression:'neutral'};
   const mapped=applyDieselModelAppearance(imported,appearance);dieselAnimator=attachDieselAnimator(imported,gltf.animations||[]);model.visible=true;
   const detail={status:'loaded',loaded:true,url,elapsedMs:Math.round(performance.now()-started),meshes,skinnedMeshes:skinned,bones,animations:dieselAnimator.animationNames,mappedParts:mapped.mappedParts,styleVariants:mapped.styleVariants,fallbackBones:dieselAnimator.fallbackBoneCount};
   window.NRS.dieselAvatar=detail;console.info('[Nigeria RP] Diesel model loaded.',detail);window.dispatchEvent(new CustomEvent('nrs-diesel-avatar-loaded',{detail}));
   if(!skinned&&!gltf.animations?.length)console.warn('[Nigeria RP] Diesel asset has no skeletal rig or animation clips; limb posing is limited by the asset.');
  }catch(error){window.NRS.dieselAvatar={status:'error',loaded:false,url,error:String(error?.message||error)};console.error('[Nigeria RP] Diesel model validation failed; block fallback remains hidden.',error);}
 },event=>{if(event?.total)window.NRS.dieselAvatar.progress=Math.round(event.loaded/event.total*100);},error=>{
  if(settled)return;settled=true;clearTimeout(timeout);window.NRS.dieselAvatar={status:'error',loaded:false,url,error:String(error?.message||error)};console.error('[Nigeria RP] Diesel model failed to load; block fallback remains hidden.',error);
 });
}
loadDieselAvatar();

const shadow=flat(.9,.9,new THREE.MeshBasicMaterial({color:0,transparent:true,opacity:.3}),0,.04,0);

