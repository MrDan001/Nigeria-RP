/* ---------- Input ---------- */
const inp={x:0,y:0},keys={};let sprint=false;
addEventListener('keydown',e=>{if(e.target.tagName!=='INPUT')keys[e.code]=true;});addEventListener('keyup',e=>keys[e.code]=false);
const joy=$('joy'),knob=$('knob');let jid=null;
function joyMove(e){const r=joy.getBoundingClientRect(),R=r.width/2;let x=(e.clientX-(r.left+R))/R,y=(e.clientY-(r.top+R))/R;
 const m=Math.hypot(x,y);if(m>1){x/=m;y/=m;}if(m<.12){inp.x=0;inp.y=0;}else{inp.x=x;inp.y=-y;}
 knob.style.transform='translate('+(x*R*.5)+'px,'+(y*R*.5)+'px)';}
joy.addEventListener('pointerdown',e=>{jid=e.pointerId;joy.setPointerCapture(jid);joyMove(e);});
joy.addEventListener('pointermove',e=>{if(e.pointerId===jid)joyMove(e);});
const jend=e=>{if(e.pointerId===jid){jid=null;inp.x=0;inp.y=0;knob.style.transform='';}};
joy.addEventListener('pointerup',jend);joy.addEventListener('pointercancel',jend);
let camYaw=0,camPitch=.3,lid=null,lx=0,ly=0,driveCamOffset=0;const cv=$('c');
cv.addEventListener('pointerdown',e=>{if(lid===null){lid=e.pointerId;lx=e.clientX;ly=e.clientY;cv.setPointerCapture(lid);}});
cv.addEventListener('pointermove',e=>{if(e.pointerId!==lid)return;
 // Camera gestures rotate only the 3D view; the HUD and driving controls remain fixed.
 camYaw-=(e.clientX-lx)*.005;camPitch=clamp(camPitch+(e.clientY-ly)*.004,-1.28,1.18);lx=e.clientX;ly=e.clientY;
 // Keep the chosen view angle relative to the vehicle so a side view stays a side view through turns.
 if(driving)driveCamOffset=Math.atan2(Math.sin(camYaw-(driving.ry+Math.PI)),Math.cos(camYaw-(driving.ry+Math.PI)));});
const lend=e=>{if(e.pointerId===lid)lid=null;};cv.addEventListener('pointerup',lend);cv.addEventListener('pointercancel',lend);
let playerHoldTimer=null,playerHoldPointer=null,playerHoldX=0,playerHoldY=0;
const cancelPlayerHold=()=>{if(playerHoldTimer!==null)clearTimeout(playerHoldTimer);playerHoldTimer=null;playerHoldPointer=null;};
cv.addEventListener('pointerdown',e=>{cancelPlayerHold();const hasRemotes=!!window.NRS?.session?.remotes?.size;const hasCourierNpcs=typeof courierNPCs!=='undefined'&&courierNPCs.some(n=>n?.g?.visible);if(driving||(inside&&!inside.isWorkplaceInterior)||modal.style.display!=='none'||(!hasRemotes&&!hasCourierNpcs))return;playerHoldPointer=e.pointerId;playerHoldX=e.clientX;playerHoldY=e.clientY;
 playerHoldTimer=setTimeout(()=>{playerHoldTimer=null;const rect=cv.getBoundingClientRect(),pointer=new THREE.Vector2(((e.clientX-rect.left)/rect.width)*2-1,-((e.clientY-rect.top)/rect.height)*2+1),ray=new THREE.Raycaster();ray.setFromCamera(pointer,cam);const groups=[...(window.NRS?.session?.remotes?.values?.()||[]),...((typeof courierNPCs!=='undefined'?courierNPCs:[]).filter(n=>n?.g?.visible).map(n=>n.g))],hits=ray.intersectObjects(groups,true);let hit=null;
 for(const item of hits){let node=item.object;while(node&&!node.userData?.playerId&&!node.userData?.courierNpcId)node=node.parent;if(node?.userData?.courierNpcId){hit={courierNpcId:node.userData.courierNpcId};break;}if(node?.userData?.playerId){hit=node.userData;break;}}if(hit){lid=null;if(hit.courierNpcId)openCourierInteractionMenu(hit.courierNpcId);else openPlayerInteractionMenu(hit);}},700);
});cv.addEventListener('pointermove',e=>{if(e.pointerId===playerHoldPointer&&Math.hypot(e.clientX-playerHoldX,e.clientY-playerHoldY)>12)cancelPlayerHold();});cv.addEventListener('pointerup',e=>{if(e.pointerId===playerHoldPointer)cancelPlayerHold();});cv.addEventListener('pointercancel',e=>{if(e.pointerId===playerHoldPointer)cancelPlayerHold();});
$('gear').onclick=()=>{const g=$('gp');g.style.display=g.style.display==='flex'?'none':'flex';};
$('bo').onclick=()=>{look.o=(look.o+1)%OUTFITS.length;dress();};
$('bs').onclick=()=>{look.s=(look.s+1)%SKIN.length;dress();};
$('run').onclick=()=>{sprint=!sprint;$('run').classList.toggle('on',sprint);};
let nrsHudChatChannel="GLOBAL";
$('tabs').addEventListener('click',e=>{
 const tab=e.target.closest('span');if(!tab)return;
 const channel=tab.textContent.trim().toUpperCase();
 if(!['GLOBAL','LOCAL','SYSTEM'].includes(channel))return;
 nrsHudChatChannel=channel;
 $('tabs').querySelectorAll('span').forEach(item=>{
  const name=item.textContent.trim().toUpperCase();
  if(['GLOBAL','LOCAL','SYSTEM'].includes(name)){item.style.opacity=name===channel?'1':'.55';item.style.fontWeight=name===channel?'900':'600';}
 });
});
$('cf').onsubmit=e=>{
 e.preventDefault();const v=$('ci').value.trim();if(!v)return;
 if(nrsHudChatChannel==='SYSTEM'){const d=document.createElement('div');const b=document.createElement('b');b.textContent='System: ';d.append(b,document.createTextNode('SYSTEM is read-only. Choose GLOBAL or LOCAL chat.'));$('log').append(d);$('log').scrollTop=$('log').scrollHeight;return;}
 const sent=window.NRS?.sendChat?.(v,nrsHudChatChannel);
 if(!sent){const d=document.createElement('div');const b=document.createElement('b');b.textContent='System: ';d.append(b,document.createTextNode('Chat is disconnected. Reconnect and try again.'));$('log').append(d);$('log').scrollTop=$('log').scrollHeight;return;}
 $('ci').value='';
};

/* ---------- Movement: camera-relative, delta-time, one update loop ---------- */
const pos=new THREE.Vector3(0,0,24),vel=new THREE.Vector3(),focus=new THREE.Vector3(0,1.4,24),camDrivePos=new THREE.Vector3();
function objectHalfExtents(b){if(!b.owner)return{hw:b.hw,hd:b.hd};const co=Math.abs(Math.cos(b.owner.ry)),si=Math.abs(Math.sin(b.owner.ry));return{hw:co*b.hw+si*b.hd,hd:si*b.hw+co*b.hd};}
let face=Math.PI,speed=0,phase=0;
function update(dt){updateNearbyHouseExteriors(dt);if(driving){driveUpdate(dt);return;}if(window.NRS?.stage9PassengerLocked){const fp=window.NRS.stage9PassengerPos;if(fp){pos.x=Number(fp.x)||0;pos.z=Number(fp.z)||0;face=Number(fp.yaw)||0;player.position.set(pos.x,0,pos.z);focus.set(pos.x,1.4,pos.z);}vel.set(0,0,0);inp.x=inp.y=0;hudAct();updateCam(dt);return;}
 let ix=inp.x,iy=inp.y;
 if(keys.KeyW||keys.ArrowUp)iy+=1;if(keys.KeyS||keys.ArrowDown)iy-=1;if(keys.KeyD||keys.ArrowRight)ix+=1;if(keys.KeyA||keys.ArrowLeft)ix-=1;
 let mag=Math.hypot(ix,iy);if(mag>1){ix/=mag;iy/=mag;mag=1;}
 const s=Math.sin(camYaw),c=Math.cos(camYaw);let tx=0,tz=0;
 if(mag>0){const dx=ix*c-iy*s,dz=-ix*s-iy*c,l=Math.hypot(dx,dz),top=sprint?6.3:4.5;
  const sp=mag<.7?2*(mag/.7):2+(mag-.7)/.3*(top-2);const cf=crouch?.45:1;tx=dx/l*sp*cf;tz=dz/l*sp*cf;}
 const k=1-Math.exp(-dt*10);vel.x+=(tx-vel.x)*k;vel.z+=(tz-vel.z)*k;
 const moveX=vel.x*dt,moveZ=vel.z*dt,collisionSteps=Math.max(1,Math.min(128,Math.ceil(Math.max(Math.abs(moveX),Math.abs(moveZ))/.08)));
 const stepX=moveX/collisionSteps,stepZ=moveZ/collisionSteps;
 const parkGateAccess=hasParkGateAccessClient();
 for(let step=0;step<collisionSteps;step++){
  pos.x+=stepX;pos.z+=stepZ;
  for(const b of boxes){if(b.hw<=0||b.hd<=0||(b.owner&&!b.owner.g.visible)||(b.parkAccessBarrier&&parkGateAccess))continue;
   const e=objectHalfExtents(b),ox=pos.x-b.x,oz=pos.z-b.z,px=e.hw+.12-Math.abs(ox),pz=e.hd+.12-Math.abs(oz);
   if(px>0&&pz>0){if(px<pz)pos.x+=Math.sign(ox||stepX||1)*px;else pos.z+=Math.sign(oz||stepZ||1)*pz;}
  }
 }
 if(inside?.isCarpark){pos.x=clamp(pos.x,inside.x-13.2,inside.x+13.2);pos.z=clamp(pos.z,inside.z-14.2,inside.z+14.2);const b=inside.cb,ox=pos.x-b.x,oz=pos.z-b.z,px=b.hw+.3-Math.abs(ox),pz=b.hd+.3-Math.abs(oz);if(px>0&&pz>0){if(px<pz)pos.x+=Math.sign(ox||1)*px;else pos.z+=Math.sign(oz||1)*pz;}}
 else if(inside){const halfW=inside.isHome?Math.max(4.8,(inside.roomW||10.4)/2-.45):inside.isWorkplaceInterior?Math.max(6.0,(inside.roomW||16)/2-.55):(inside.isApartmentBuilding?8.7:inside.isApartmentRoom?5.4:5.2),back=inside.isHome?Math.max(4.3,(inside.roomD||10)/2-.45):inside.isWorkplaceInterior?Math.max(5.5,(inside.roomD||14)/2-.55):(inside.isApartmentBuilding?10.7:inside.isApartmentRoom?5.3:4.6),front=inside.isHome?Math.max(5.0,(inside.roomD||10)/2-.45):inside.isWorkplaceInterior?Math.max(5.7,(inside.roomD||14)/2-.55):(inside.isApartmentBuilding?10.7:inside.isApartmentRoom?5.3:5.4);pos.x=clamp(pos.x,inside.x-halfW,inside.x+halfW);pos.z=clamp(pos.z,inside.z-back,inside.z+front);if(inside.cb){const b=inside.cb,ox=pos.x-b.x,oz=pos.z-b.z,px=b.hw+.3-Math.abs(ox),pz=b.hd+.3-Math.abs(oz);if(px>0&&pz>0){if(px<pz)pos.x+=Math.sign(ox||1)*px;else pos.z+=Math.sign(oz||1)*pz;}}}
 else{pos.x=clamp(pos.x,-240,240);pos.z=clamp(pos.z,-240,240);}
 speed=Math.hypot(vel.x,vel.z);
 if(speed>.3){let d=Math.atan2(vel.x,vel.z)-face;d=Math.atan2(Math.sin(d),Math.cos(d));face+=d*(1-Math.exp(-dt*12));}
 if(keys.Space&&pos.y===0)jv=5.4;jv-=14*dt;pos.y+=jv*dt;if(pos.y<0){pos.y=0;jv=0;}player.position.copy(pos);model.rotation.y=face;shadow.position.set(pos.x,.04,pos.z);}
function animate(dt,t){if(driving)return;
 const run=clamp((speed-2)/2.5,0,1),amp=clamp(speed/2,0,1)*(.55+.4*run);phase+=speed*dt*(4.2-1.6*run);
 const dm=(o,v)=>{o.rotation.x+=(v-o.rotation.x)*Math.min(1,dt*18);};
 [0,1].forEach(i=>{const p=phase+i*Math.PI,sw=Math.sin(p);
  dm(leg[i],-sw*amp*.9);dm(knee[i],Math.max(0,Math.cos(p))*amp*(.9+.5*run));dm(arm[i],sw*amp*.8);dm(elbow[i],-(.2+.7*run)*amp-.05);});
 dm(upper,.04+.14*run*amp);model.position.y=.085+Math.abs(Math.sin(phase))*.025*amp;upper.scale.y=1+Math.sin(t*2)*.006;if(punchT>0){punchT-=dt;const u=1-punchT/.35;arm[pHand].rotation.x=-1.5*Math.sin(Math.PI*Math.min(u,1));elbow[pHand].rotation.x=-.3;}model.scale.y+=((crouch?.86:1)-model.scale.y)*Math.min(1,dt*12);}
function updateCam(dt){
 if(driving){
  const c=driving,speed=Math.abs(c.v||0),follow=1-Math.exp(-dt*(speed>1?7:11));
  // Aim a little ahead of the car at speed, while keeping the camera position anchored behind the vehicle.
  const ahead=clamp(speed*.12,0,2.8);
  focus.x+=(c.x+Math.sin(c.ry)*ahead-focus.x)*follow;
  focus.z+=(c.z+Math.cos(c.ry)*ahead-focus.z)*follow;focus.y=1.2;
  const wantedYaw=c.ry+Math.PI+driveCamOffset;
  camYaw+=Math.atan2(Math.sin(wantedYaw-camYaw),Math.cos(wantedYaw-camYaw))*(1-Math.exp(-dt*(speed>1?5.5:10)));
  const d=CAMD[camMode],cp=Math.cos(camPitch);
  if(camPitch<0){
   // Keep the follow camera above ground and aim above the player, allowing an upward look into the sky.
   camDrivePos.set(c.x+Math.sin(camYaw)*d,1.45,c.z+Math.cos(camYaw)*d);
  }else{
   camDrivePos.set(c.x+Math.sin(camYaw)*cp*d,1.15+Math.sin(camPitch)*d,c.z+Math.cos(camYaw)*cp*d);
  }
  cam.position.lerp(camDrivePos,1-Math.exp(-dt*(speed>1?5.5:10)));
  if(camPitch<0)cam.lookAt(focus.x,focus.y+.25+Math.tan(-camPitch)*d,focus.z);else cam.lookAt(focus);
  return;
 }
 const f=1-Math.exp(-dt*14);focus.x+=(pos.x-focus.x)*f;focus.z+=(pos.z-focus.z)*f;focus.y=1.4;
 const d=inside&&inside.isHome?3.1:inside?.isCarpark?5.5:inside?.isApartmentRoom?3.15:inside?.isApartmentBuilding?3.7:inside?.isShopInterior?3.35:inside?.isWorkplaceInterior?3.6:4.6,cp=Math.cos(camPitch);
 let lookY=focus.y;
 if(camPitch<0){cam.position.set(focus.x+Math.sin(camYaw)*d,focus.y+.25,focus.z+Math.cos(camYaw)*d);lookY=focus.y+.25+Math.tan(-camPitch)*d;}
 else cam.position.set(focus.x+Math.sin(camYaw)*cp*d,focus.y+Math.sin(camPitch)*d,focus.z+Math.cos(camYaw)*cp*d);
 const cameraInteriorRoot=(inside?.isApartmentRoom||inside?.isApartmentBuilding)
  ? APARTMENT_INTERIOR_VISUAL
  : inside?.isHome ? HOME_ROOMS[inside.home?.id||inside.id]?.group : null;
 if(cameraInteriorRoot){
  cameraInteriorRoot.updateMatrixWorld(true);
  const cameraDelta=cam.position.clone().sub(focus),cameraDistance=cameraDelta.length();
  if(cameraDistance>.1){
   const direction=cameraDelta.clone().multiplyScalar(1/cameraDistance);
   const raycaster=new THREE.Raycaster(focus.clone(),direction,.12,cameraDistance);
   const hit=raycaster.intersectObjects(cameraInteriorRoot.children,true).find(item=>item.distance>.32);
   if(hit)cam.position.copy(focus).addScaledVector(direction,Math.max(.55,hit.distance-.30));
  }
 }
 if(inside?.isHome){
  // Keep the orbit camera within the room shell when turning toward walls or furniture.
  cam.position.x=clamp(cam.position.x,inside.x-inside.roomW/2+.35,inside.x+inside.roomW/2-.35);
  cam.position.z=clamp(cam.position.z,inside.z-inside.roomD/2+.35,inside.z+inside.roomD/2-.35);
 }else if(inside?.isApartmentRoom){
  // Never let the orbit camera cross the apartment shell when the player turns toward a wall.
  cam.position.x=clamp(cam.position.x,inside.x-5.25,inside.x+5.25);
  cam.position.z=clamp(cam.position.z,inside.z-5.25,inside.z+5.25);
 }else if(inside?.isApartmentBuilding){
  cam.position.x=clamp(cam.position.x,inside.x-9.25,inside.x+9.25);
  cam.position.z=clamp(cam.position.z,inside.z-11.2,inside.z+11.2);
 }
 cam.lookAt(focus.x,lookY,focus.z);
}

/* ---------- HUD: compass and minimap ---------- */
const cc=$('comp').getContext('2d'),LAB={0:'N',45:'NE',90:'E',135:'SE',180:'S',225:'SW',270:'W',315:'NW'};
function drawComp(){const w=880,h=84,hd=((-camYaw*57.2958)%360+360)%360,ppd=w/110;cc.clearRect(0,0,w,h);cc.textAlign='center';
 for(let d=Math.floor((hd-60)/15)*15;d<=hd+60;d+=15){const x=w/2+(d-hd)*ppd,n=((d%360)+360)%360,L=LAB[n];
  cc.fillStyle=L?'#fff':'rgba(255,255,255,.55)';cc.font=(L?'bold 34px':'24px')+' system-ui';cc.fillText(L||n,x,66);cc.fillRect(x-1.5,12,3,L?16:10);}
 cc.fillStyle='#fff';cc.beginPath();cc.moveTo(w/2-10,0);cc.lineTo(w/2+10,0);cc.lineTo(w/2,13);cc.fill();}
const mc=$('mm').getContext('2d');
function mapDraw(m,S,sc,rot,clip){const R=S/2;m.clearRect(0,0,S,S);m.save();if(clip){m.beginPath();m.arc(R,R,R-2,0,7);m.clip();}
 m.fillStyle='#16313a';m.fillRect(0,0,S,S);m.translate(R,R);if(rot)m.rotate(camYaw);m.scale(sc,sc);m.translate(rot?-pos.x:0,rot?-pos.z:0);
 ZN.forEach(a=>{m.fillStyle=a.mc;m.fillRect(a.x1,a.z1,a.x2-a.x1,a.z2-a.z1);});m.fillStyle='#2a6f8f';m.fillRect(-260,195,520,60);m.fillStyle='#5a626a';RD.forEach(a=>m.fillRect(a[0],a[1],a[2],a[3]));RB.forEach(b=>{m.beginPath();m.arc(b[0],b[1],16,0,7);m.fill();m.fillStyle='#3f7a35';m.beginPath();m.arc(b[0],b[1],8.4,0,7);m.fill();m.fillStyle='#5a626a';});
 if(ROUTE&&ROUTE.length>1){m.save();m.lineCap='round';m.lineJoin='round';m.beginPath();ROUTE.forEach((q,i)=>i?m.lineTo(q[0],q[1]):m.moveTo(q[0],q[1]));
 m.strokeStyle='rgba(90,0,10,.85)';m.lineWidth=clip?8:10;m.stroke();m.strokeStyle='#ff2a3a';m.lineWidth=clip?5.5:7;m.stroke();
 m.strokeStyle='rgba(255,255,255,.9)';m.lineWidth=clip?1.2:1.6;m.setLineDash([3,5]);m.lineDashOffset=-(performance.now()/60)%8;m.stroke();m.restore();}
 m.fillStyle='#9aa0a6';for(const b of bld)m.fillRect(b.x-b.hw,b.z-b.hd,b.hw*2,b.hd*2);
 m.fillStyle='#ff9f43';for(const p of POI)m.fillRect(p.x-2,p.z-2,4,4);for(const s of FS){m.fillStyle='#fff';m.beginPath();m.arc(s.x,s.z,8/sc,0,7);m.fill();m.fillStyle=s.col;m.beginPath();m.arc(s.x,s.z,6/sc,0,7);m.fill();m.fillStyle='#fff';m.fillRect(s.x-1.6/sc,s.z-3/sc,3.2/sc,6/sc);}if(job){m.fillStyle='#ffc928';m.beginPath();m.arc(job.x,job.z,6/sc,0,7);m.fill();}if(NAV){m.fillStyle='#fff';m.beginPath();m.arc(NAV.x,NAV.z,8/sc,0,7);m.fill();m.fillStyle='#ff2a3a';m.beginPath();m.arc(NAV.x,NAV.z,6/sc,0,7);m.fill();}m.fillStyle='#e8c14a';for(const c of cars)if(c.g?.visible)m.fillRect(c.x-1.2,c.z-2.4,2.4,4.8);for(const c of TV)m.fillRect(c.x-1.2,c.z-2.4,2.4,4.8);m.fillStyle='#fff';for(const p of PEDS)m.fillRect(p.x-.9,p.z-.9,1.8,1.8);
 if(!clip){m.fillStyle='#fff';m.textAlign='center';m.font='bold '+(12/sc)+'px system-ui';ZN.forEach(a=>m.fillText(a.n,(a.x1+a.x2)/2,(a.z1+a.z2)/2));m.fillStyle='#cfe3ff';m.font=(10/sc)+'px system-ui';HR.forEach(r=>m.fillText(r[1],-150,r[0]-7));VR.forEach(r=>m.fillText(r[1],r[0],r[2]+14));}
 m.translate(pos.x,pos.z);m.rotate(Math.PI-face);m.scale(1/sc,1/sc);m.fillStyle='#4ade80';m.beginPath();m.moveTo(0,-11);m.lineTo(8,9);m.lineTo(0,5);m.lineTo(-8,9);m.closePath();m.fill();m.restore();
 if(clip){m.fillStyle='#fff';m.font='bold 22px system-ui';m.textAlign='center';m.fillText('N',R+Math.sin(camYaw)*98,R-Math.cos(camYaw)*98+8);}}
function drawMap(){mapDraw(mc,240,driving?1.15:1.6,true,true);const f=$('fm');if(f)mapDraw(f.getContext('2d'),400,.8,false,false);}

/* ---------- Vehicles, traffic, buttons ---------- */
let driving=null,punchT=0,crouch=false,nearCar=null,locT='',ac,carparkExitPending=false,drivingCameraLocked=false;
const tr=cars.filter(c=>c.kind==='t');
const stage9FleetVisuals={};
[
 {id:"fleet-keke-01",type:"keke",scale:.76,hw:.82,hd:1.72,color:0x168d70},
 {id:"fleet-okada-01",type:"okada",scale:.58,hw:.58,hd:1.45,color:0xd8a51d},
 {id:"fleet-taxi-01",type:"taxi",scale:1,hw:1.05,hd:2.3,color:0x1388bf},
 {id:"fleet-danfo-01",type:"danfo",scale:1.12,hw:1.18,hd:2.65,color:0xd2a322},
 {id:"fleet-bus-01",type:"bus",scale:1.32,hw:1.42,hd:3.05,color:0x1a8a55},
 {id:"fleet-truck-01",type:"haulage",scale:1.42,hw:1.5,hd:3.35,color:0x8c5d34}
].forEach((v,i)=>{const c=car(430+i*6,430,v.color,0,'f');c.g.scale.setScalar(v.scale);c.stage9FleetId=v.id;c.stage9FleetType=v.type;c.stage9HalfWidth=v.hw;c.stage9HalfDepth=v.hd;c.g.visible=false;c.box.hw=0;c.box.hd=0;stage9FleetVisuals[v.id]=c;});
function setCar(c){c.g.position.set(c.x,0,c.z);c.g.rotation.y=c.ry;c.body.rotation.x=c.pitch;c.body.rotation.z=c.roll;c.box.x=c.x;c.box.z=c.z;}
function traffic(dt){
 bagV-=(bagA*40+bagV*1.2)*dt;bagA+=bagV*dt;bag.rotation.z=bagA;
 const obs=tr.slice().concat(pedObs);if(!driving)obs.push(pos);
 cars.forEach(c=>{if(c.kind!=='t'&&c.g?.visible&&c.box?.hw>0&&c.box?.hd>0)obs.push(c);});
 for(const c of tr){
  if(!c.g.visible)continue;
  // Ambient traffic follows fixed lanes along the north/south arterial.
  // These cars have no lane-change controller: allowing avoidance to alter x
  // (even briefly) can carry the new x into the next frame and walk the car
  // diagonally onto the pavement. Use the spawn-time lane centre as an invariant.
  const dz=c.ry>2?-1:1;
  const base=Number.isFinite(c.laneX)?c.laneX:(Number.isFinite(c.lx)?c.lx:c.x);
  let gap=Infinity;
  for(const o of obs){
   if(o===c||o?.g?.visible===false)continue;
   const d=(o.z-c.z)*dz,ox=o.x??o.position?.x;
   if(d>0&&d<gap&&Number.isFinite(ox)&&Math.abs(ox-base)<2.25)gap=d;
  }
  const targetSpeed=gap<4.2?0:gap<7?2.5:gap<12?5.5:(c.vm||9);
  c.x=base;
  c.v+=clamp(targetSpeed-c.v,-16*dt,5*dt);
  c.z+=dz*c.v*dt;if(Math.abs(c.z)>190)c.z=-dz*190;
  c.wh.forEach(w=>w.sp.rotation.x+=c.v*dt/.38);setCar(c);
 }
}
const WLOCK=200,WMAX=540;let hornN=null,hornBtn=false,hornWheel=false,hornWheelPointer=null,hornKey=false,carparkExitAttemptAt=0;
let gasT=0,brkT=0,gasP=0,brkP=0,hbP=false,wheelA=0,wheelHeld=false,jv=0,pHand=0,bagA=0,bagV=0,eng=null;
const TANK=40,FUEL_PER_M=.004,FUEL_IDLE=.002; /* litres: 1 L per 250 m, small idle burn */
function driveUpdate(dt){const c=driving;if(Math.abs(c.v)>.05){drivingCameraLocked=true;cam.fov=60;}else drivingCameraLocked=false;
 if(c.on&&c.fuel<=0){c.fuel=0;c.on=false;engine(false);setIgn();sys('⛽ Out of fuel! The engine has cut out. Get fuel from a petrol station.');}
 if(keys.KeyD||keys.ArrowRight)wheelA=Math.min(WLOCK,wheelA+420*dt);else if(keys.KeyA||keys.ArrowLeft)wheelA=Math.max(-WLOCK,wheelA-420*dt);
 else if(!wheelHeld&&wheelA){const rs=(50+Math.abs(wheelA)*2.7)*(1+Math.abs(c.v)*3.6/100)*dt;wheelA=Math.abs(wheelA)<=rs?0:wheelA-Math.sign(wheelA)*rs;}
 if(!!keys.KeyH!==hornKey){hornKey=!!keys.KeyH;hornSync();}
 gasP+=((keys.KeyW||keys.ArrowUp?1:gasT)-gasP)*Math.min(1,dt*6);brkP+=((keys.KeyS||keys.ArrowDown?1:brkT)-brkP)*Math.min(1,dt*8);
 const th=c.on?gasP:0,br=brkP,hb=hbP||keys.Space,st=clamp(wheelA/WLOCK,-1,1),sn=Math.sin(c.ry),cs=Math.cos(c.ry);
 let fv=c.vx*sn+c.vz*cs,lv=c.vx*cs-c.vz*sn;const kmh=Math.abs(fv)*3.6;
 let gear=1;const G=[0,30,55,85,120,160];while(gear<5&&kmh>G[gear])gear++;c.gear=gear;c.rpm=clamp(.2+.8*(kmh-G[gear-1])/(G[gear]-G[gear-1]),.2,1);
 let a=0;
 if(th>.05)a+=fv<-.5?th*14:th*(14-2.2*gear)*Math.max(0,1-kmh/150);
 if(br>.05){if(fv>.5)a-=br*16;else if(fv>-6)a-=br*4.5;}
 fv+=a*dt;fv-=Math.sign(fv)*Math.min(Math.abs(fv),(.35+.0006*fv*fv+(hb?6:0)+(c.fuel<=0?3:0))*dt);
 if(c.on&&c.fuel>0)c.fuel=Math.max(0,c.fuel-(Math.abs(fv)*dt*FUEL_PER_M*(.7+.6*th)+FUEL_IDLE*dt));
 lv*=Math.exp(-(hb?1.2:(kmh>90&&Math.abs(st)>.7?4:7))*dt);
 const steeringInput=Math.sign(st)*Math.pow(Math.abs(st),.72);
 c.steer+=(steeringInput*.68/(1+kmh/48)-c.steer)*(1-Math.exp(-dt*17));
 const yaw=fv/2.8*Math.tan(c.steer)*(hb?1.4:1);c.ry-=yaw*dt;
 c.vx=sn*fv+cs*lv;c.vz=cs*fv-sn*lv;c.x+=c.vx*dt;c.z+=c.vz*dt;
 /* Collision uses each object's real half-size, not an extra 1.4-unit invisible shell.
    Convert the rotated vehicle footprint to an axis-aligned bound for broad-phase contact. */
 const ownHW=Math.abs(Math.cos(c.ry))*c.box.hw+Math.abs(Math.sin(c.ry))*c.box.hd;
 const ownHD=Math.abs(Math.sin(c.ry))*c.box.hw+Math.abs(Math.cos(c.ry))*c.box.hd;
 for(const b of boxes){
  if(b===c.box||b.hw<=0||b.hd<=0||(b.owner&&!b.owner.g.visible))continue;
  const other=objectHalfExtents(b),ox=c.x-b.x,oz=c.z-b.z,px=ownHW+other.hw-Math.abs(ox),pz=ownHD+other.hd-Math.abs(oz);
  if(px>0&&pz>0){
   if(px<pz){const push=Math.sign(ox||1)*px;c.x+=push;if(c.vx*push<0)c.vx=0;}
   else{const push=Math.sign(oz||1)*pz;c.z+=push;if(c.vz*push<0)c.vz=0;}
   c.vx*=.92;c.vz*=.92;
  }
 }
 fv=c.vx*Math.sin(c.ry)+c.vz*Math.cos(c.ry);
 if(inside?.isCarpark){
  // Garage walls must stop the car dead; clamping position alone left the car
  // "pinned" with its old speed, so the stopped-at-gate check never passed.
  const gMinX=inside.x-11.2,gMaxX=inside.x+11.2,gMinZ=inside.z-13.5,gMaxZ=inside.z+14.1;
  if(c.x<gMinX||c.x>gMaxX){c.x=clamp(c.x,gMinX,gMaxX);c.vx=0;}
  if(c.z<gMinZ||c.z>gMaxZ){c.z=clamp(c.z,gMinZ,gMaxZ);c.vz=0;}
  fv=c.vx*sn+c.vz*cs;
 }else{c.x=clamp(c.x,-240,240);c.z=clamp(c.z,-240,240);}c.v=fv;
 const k=1-Math.exp(-dt*6);c.pitch+=(clamp(-a*.004,-.06,.06)-c.pitch)*k;c.roll+=(clamp(yaw*fv*.003,-.07,.07)-c.roll)*k;
 c.tail.color.setHex(br>.05||hb?0xff2020:0x701010);c.rev.color.setHex(fv<-.5?0xffffff:0x555555);c.sw.rotation.z=wheelA*.0174533;
  const spd=Math.min(220,Math.round(kmh)),arc=$('spdArc'),needle=$('spdNeedle'),value=$('spdValue');if(arc)arc.style.strokeDashoffset=String(113-(spd/220)*113);if(needle)needle.style.transform='rotate('+(-135+(spd/220)*270)+'deg)';if(value)value.textContent=String(Math.round(kmh));
 c.wh.forEach(w=>{w.sp.rotation.x+=fv*dt/.38;if(w.f)w.pv.rotation.y=-c.steer;});
 if(eng){eng.o.frequency.value=38+c.rpm*95;eng.g.gain.value=.02+.03*th;}
 setCar(c);pos.set(c.x,0,c.z);face=c.ry;
 if(inside?.isCarpark&&!carparkExitPending&&(hornBtn||hornKey)&&Math.abs(c.x-455)<=5.8&&c.z>=468&&c.z<=469.2){
  if(performance.now()-carparkExitAttemptAt>650){
   carparkExitPending=true;carparkExitAttemptAt=performance.now();
   const N=window.NRS;
   if(N&&N.exitCarpark)N.exitCarpark(c.id,true);
   else{carparkExitPending=false;sys('Garage connection is not ready. Please try the horn again.');}
  }
 }
 cam.fov=60;cam.updateProjectionMatrix();
 /* Camera orientation stays where the driver set it; no automatic panning on turns. */}
function hudAct(){const a=$('act');
 if(driving){$('wsv').style.transform='rotate('+wheelA+'deg)';a.style.display='block';a.textContent='Exit car';const on=driving.on,t=Math.round(Math.abs(driving.v)*3.6)+' km/h '+(driving.starting?'STARTING':on?'G'+(driving.v<-.5?'R':(driving.gear||1)):'ENGINE OFF');const t2=t+zn();if(locT!==t2){locT=t2;$('loc').innerHTML='🚗 '+t+'<br><small>'+(on?zn():driving.starting?'Starting...':'Press 🔘 to start')+'</small>';}drvHud();return;}
 {const z=zn();if(locT!==z){locT=z;$('loc').innerHTML='📍 '+z+'<br><small>Port Harcourt, Rivers State</small>';}}
 if(inside?.isCarpark){nearCar=null;a.style.display='block';const door=Math.hypot(pos.x-inside.x,pos.z-(inside.z+13.4));a.textContent=door<3.2?'Use garage door':'Spawn car';return;}
 nearCar=null;let bd=3.4;for(const c of cars){if(c.kind==='t'||!c.g?.visible||!c.box||c.box.hw<=0||c.box.hd<=0)continue;const d=Math.hypot(c.x-pos.x,c.z-pos.z);if(d<bd){bd=d;nearCar=c;}}
 a.style.display=nearCar?'block':'none';a.textContent='Enter car';}
$('act').onclick=()=>{
 if(driving){const c=driving;if(Math.abs(c.v)>5)return;c.v=c.vx=c.vz=0;c.box.hw=1.05;c.box.hd=2.3;pos.set(c.x+Math.cos(c.ry)*2.3,0,c.z-Math.sin(c.ry)*2.3);face=c.ry;vel.set(0,0,0);focus.copy(pos);
  standUp();shadow.visible=true;c.on=false;c.hlOn=false;c.starting=false;driving=null;if(window.NRS)window.NRS.currentStage9VehicleId='';setIgn();setHl(c);c.rev.color.setHex(0x555555);c.sw.rotation.z=0;hornBtn=false;hornWheel=false;hornWheelPointer=null;hornKey=false;hornSync();document.body.classList.remove('drv');$('act').classList.remove('dr');engine(false);radioSet(0);cam.fov=60;cam.updateProjectionMatrix();c.tail.color.setHex(0x701010);inp.x=inp.y=0;jid=null;knob.style.transform='';}
 else if(nearCar&&nearCar.g?.visible&&nearCar.box&&nearCar.box.hw>0&&nearCar.box.hd>0){driving=nearCar;if(window.NRS)window.NRS.currentStage9VehicleId=nearCar.stage9FleetId||'';driving.v=driving.vx=driving.vz=0;driving.box.hw=1.05;driving.box.hd=2.3;vel.set(0,0,0);driving.on=false;driving.starting=false;driveCamOffset=0;camYaw=driving.ry+Math.PI;camPitch=.28;cam.fov=60;cam.updateProjectionMatrix();wheelA=0;sitIn(driving);document.body.classList.add('drv');$('act').classList.add('dr');setIgn();}
 else if(inside?.isCarpark){const door=Math.hypot(pos.x-inside.x,pos.z-(inside.z+13.4));if(door<3.2)openGarageFootExitMenu();else openGarageSpawnMenu();}};
/* seated driver: player rides inside the car body, hands on the wheel, legs forward */
function sitIn(c){c.body.add(player);player.position.set(.42,-.06,-.3);player.rotation.set(0,0,0);player.scale.setScalar(.85);player.visible=true;shadow.visible=false;
 model.rotation.y=0;model.position.y=0;model.scale.y=1;crouch=false;$('crch').classList.remove('on');
 leg.forEach(l=>l.rotation.x=-1.35);knee.forEach(k=>k.rotation.x=.9);arm.forEach(a=>a.rotation.x=-1.2);elbow.forEach(e=>e.rotation.x=-.5);upper.rotation.x=.05;}
function standUp(){
 scene.add(player);player.scale.setScalar(1);player.rotation.set(0,0,0);player.position.copy(pos);model.rotation.y=face;
 // sitIn uses a bent-leg pose. Restore the canonical on-foot pose at the transition,
 // instead of waiting for the idle/walk animation to ease the seated joints back.
 leg.forEach(l=>l.rotation.set(0,0,0));knee.forEach(k=>k.rotation.set(0,0,0));
 arm.forEach(a=>a.rotation.set(0,0,0));elbow.forEach(e=>e.rotation.set(0,0,0));
 upper.rotation.set(0,0,0);model.position.y=.085;model.scale.y=crouch?.86:1;
}
/* ignition: engine is OFF when you get in; gas does nothing until you start it */
function setIgn(){const b=$('ign'),c=driving;b.classList.toggle('on',!!(c&&c.on));b.classList.toggle('st',!!(c&&c.starting));}
function crank(){const a=ctx(),t=a.currentTime,o=a.createOscillator(),g=a.createGain();o.type='sawtooth';o.frequency.setValueAtTime(48,t);o.frequency.linearRampToValueAtTime(70,t+.6);
 for(let i=0;i<8;i++){g.gain.setValueAtTime(.05,t+i*.08);g.gain.setValueAtTime(.015,t+i*.08+.04);}g.gain.setValueAtTime(0,t+.65);o.connect(g);g.connect(a.destination);o.start(t);o.stop(t+.66);}
function setHl(c){c.hl.color.setHex(c.hlOn||c.kind==='t'?0xfff6d0:0xb9b49a);}
function ignition(){const c=driving;if(!c||c.starting)return;
 if(c.on){c.on=false;c.hlOn=false;engine(false);setHl(c);setIgn();return;}
 if(c.fuel<=0){sys('⛽ Out of fuel. Get fuel from a petrol station.');return;}
 c.starting=true;crank();setIgn();
 setTimeout(()=>{c.starting=false;if(driving===c){c.on=true;c.hlOn=true;engine(true);setHl(c);}setIgn();},650);}
$('ign').onclick=ignition;
function ctx(){return ac=ac||new (window.AudioContext||window.webkitAudioContext)();}
/* two-tone horn: sounds for exactly as long as the button (or H) is held */
function hornSync(){const want=(hornBtn||hornWheel||hornKey)&&driving;
 if(want&&!hornN){const a=ctx();if(a.state==='suspended')a.resume();const t=a.currentTime,g=a.createGain(),f=a.createBiquadFilter();f.type='lowpass';f.frequency.value=2300;f.Q.value=.7;
  g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(.13,t+.03);
  const os=[[392,'sawtooth',1],[494,'sawtooth',1],[784,'square',.16],[988,'square',.16]].map((q,k)=>{const o=a.createOscillator(),og=a.createGain();o.type=q[1];o.frequency.value=q[0]*(k%2?1.004:.997);og.gain.value=q[2];o.connect(og);og.connect(f);o.start(t);return o;});
  f.connect(g);g.connect(a.destination);hornN={os,g};}
 else if(!want&&hornN){const a=ctx(),t=a.currentTime,h=hornN;hornN=null;h.g.gain.cancelScheduledValues(t);h.g.gain.setValueAtTime(h.g.gain.value,t);h.g.gain.linearRampToValueAtTime(0,t+.07);h.os.forEach(o=>o.stop(t+.09));}}
function punch(){if(punchT>0||driving)return;punchT=.35;pHand^=1;if(Math.hypot(pos.x-6.6,pos.z-22)<2)bagV+=5*Math.sign(6.6-pos.x);}
$('fist').onclick=punch;$('jump').onclick=()=>{if(!driving&&pos.y===0)jv=5.4;};
const bag=new THREE.Group();bag.position.set(6.6,2.5,22);scene.add(bag);add(new THREE.CylinderGeometry(.22,.22,.9,10),M(0xb02a2a),0,-.7,0,bag);
add(new THREE.CylinderGeometry(.07,.09,2.6,6),M(0x555555),6.6,1.3,22.9);add(new THREE.BoxGeometry(.1,.1,1),M(0x555555),6.6,2.55,22.4);
$('crch').onclick=()=>{crouch=!crouch;$('crch').classList.toggle('on',crouch);};
const modal=$('modal');
const routeFade=document.createElement('div');routeFade.id='routeFade';routeFade.style.cssText='position:fixed;inset:0;background:#030609;opacity:0;pointer-events:none;z-index:99999;transition:opacity .24s ease';document.body.appendChild(routeFade);
let routeFadeTimer=0;
function routeTransitionIn(){clearTimeout(routeFadeTimer);routeFade.style.opacity='1';}
function routeTransitionOut(){clearTimeout(routeFadeTimer);routeFadeTimer=setTimeout(()=>{routeFade.style.opacity='0';},280);}
function panel(h){modal.classList.remove('house-menu','job-center-menu','work-menu','apartment-menu','bank-menu','forbes-menu','stage4-menu');modal.innerHTML='<button id="mx" class="modal-close" type="button" aria-label="Close menu">✕ Close</button>'+h;modal.style.display='block';$('mx').onclick=()=>{modal.style.display='none';modal.innerHTML='';modal.classList.remove('house-menu','job-center-menu','work-menu','apartment-menu','bank-menu','forbes-menu','stage4-menu');workplaceMenuOpen=false;forbesBoardOpen=false;if(typeof marketMenuOpen!=='undefined')marketMenuOpen=false;if(typeof bankMenuOpen!=='undefined')bankMenuOpen=false;if(typeof hospitalMenuOpen!=='undefined')hospitalMenuOpen=false;if(typeof parkMenuOpen!=='undefined')parkMenuOpen=false;};}

function openExitRouteMenu(){if(!inside)return;const garage=!!inside.isHome&&!!(inside.home?.isOwner||inside.home?.occupiedByMe);panel('<b>🚪 Choose your exit</b><p class="route-copy">Choose how to leave your home.</p><button data-exit-route="street">🚶 Exit to street<br><small>Leave on foot.</small></button>'+(garage?'<button data-exit-route="carpark">🚗 Exit to garage<br><small>Take a vehicle you own, then stop at the garage gate and hold the horn to exit to the street.</small></button>':'')+'');}
function returnToStreetFromRoom(){const r=inside;if(!r)return;if(r.isHome){const N=window.NRS;if(N&&N.exitHome){routeTransitionIn();modal.style.display='none';modal.innerHTML='';act2.style.display='none';sys('🚪 Returning to the street outside your home…');N.exitHome();}return;}if(r.isApartmentRoom){window.NRS?.exitApartmentRoom();return;}if(r.isApartmentBuilding){window.NRS?.exitApartmentBuilding();return;}routeTransitionIn();inside=null;pos.set(r.ret.x,0,r.ret.z);vel.set(0,0,0);face=Number.isFinite(r.ret.face)?r.ret.face:(Number.isFinite(Number(r.ret.sx))?-Number(r.ret.sx)*Math.PI/2:face);camYaw=Number.isFinite(r.ret.camYaw)?r.ret.camYaw:camYaw;camPitch=Number.isFinite(r.ret.camPitch)?r.ret.camPitch:camPitch;focus.set(pos.x,1.4,pos.z);player.position.copy(pos);model.rotation.y=face;shadow.position.set(pos.x,.04,pos.z);modal.style.display='none';modal.innerHTML='';curPoi=null;act2.style.display='none';routeTransitionOut();}
function garageRoom(d){
 const existing=HOME_ROOMS.__privateGarage;
 if(existing){existing.home=d.home||existing.home||null;return existing;}
 const ix=Number(d.garageX)||455,iz=Number(d.garageZ)||455;
 const concrete=M(0x62696c),concreteDark=M(0x42494d),wall=M(0x879092),wallDark=M(0x3b4549),metal=M(0x252f34),steel=M(0x69767b),yellow=M(0xf3c33d),white=M(0xf4f2e9),blue=M(0x267c9a),glass=new THREE.MeshPhongMaterial({color:0x5e9eb0,transparent:true,opacity:.45,shininess:75,side:THREE.DoubleSide});
 // Sealed 36 x 40 metre bay: continuous floor, concrete side/rear walls and roof.
 flat(36,40,concrete,ix,.015,iz);
 flat(12.5,37,concreteDark,ix,.028,iz-1);
