(()=>{const legacyGo=$('go'),legacyStart=$('start');if(legacyGo&&legacyStart)legacyGo.onclick=async()=>{legacyStart.style.display='none';try{await document.documentElement.requestFullscreen();await screen.orientation.lock('landscape');}catch(e){}};})();

/* ---------- Steering wheel, pedals, engine, radio ---------- */
const wl=$('wheel');let wla=0,wid=null;
const wang=e=>{const r=wl.getBoundingClientRect();return Math.atan2(e.clientY-(r.top+r.height/2),e.clientX-(r.left+r.width/2))*57.2958;};
wl.addEventListener('pointerdown',e=>{
 const r=wl.getBoundingClientRect(),dx=e.clientX-(r.left+r.width/2),dy=e.clientY-(r.top+r.height/2);
 wl.setPointerCapture(e.pointerId);
 // The steering-wheel hub is a separate hold-to-honk control; outer rim still steers.
 if(Math.hypot(dx,dy)<=Math.min(r.width,r.height)*.16){
  hornWheelPointer=e.pointerId;hornWheel=true;hornSync();e.preventDefault();return;
 }
 wid=e.pointerId;wla=wang(e);wheelHeld=true;
});
wl.addEventListener('pointermove',e=>{if(e.pointerId!==wid)return;const q=wang(e);let d=q-wla;if(d>180)d-=360;else if(d<-180)d+=360;wla=q;wheelA=clamp(wheelA+d,-WMAX,WMAX);});
const wend=e=>{
 if(e.pointerId===hornWheelPointer){hornWheelPointer=null;hornWheel=false;hornSync();}
 if(e.pointerId===wid){wid=null;wheelHeld=false;}
};wl.addEventListener('pointerup',wend);wl.addEventListener('pointercancel',wend);
function hold(id,fn){const el=$(id);el.addEventListener('pointerdown',e=>{el.setPointerCapture(e.pointerId);fn(1);el.classList.add('on');});
 const up=()=>{fn(0);el.classList.remove('on');};el.addEventListener('pointerup',up);el.addEventListener('pointercancel',up);}
hold('gas',v=>gasT=v);hold('brk',v=>brkT=v);hold('hb',v=>hbP=!!v);hold('hn',v=>{hornBtn=!!v;hornSync();});
function engine(on){if(on){const a=ctx(),o=a.createOscillator(),f=a.createBiquadFilter(),g=a.createGain();o.type='sawtooth';f.type='lowpass';f.frequency.value=500;g.gain.value=.03;o.connect(f);f.connect(g);g.connect(a.destination);o.start();eng={o,g};}else if(eng){eng.o.stop();eng=null;}}
const ST=[null,{bpm:104,k:[0,7,10],c:[4,12],b:[110,0,0,110,0,0,131,0,147,0,0,110,0,165,0,131],l:[0,0,440,0,0,523,0,440,0,0,587,0,523,0,440,0],lt:'square'},
 {bpm:94,k:[0,8],c:[4,12],b:[131,0,0,0,196,0,0,0,175,0,0,0,196,0,0,0],l:[523,0,659,0,784,0,659,0,587,0,698,0,784,0,659,0],lt:'triangle'}];
let nz=null,rd={t:0,s:0,n:0,a:null,i:0};
function tone(f,t,d,ty,v){const a=ctx(),o=a.createOscillator(),g=a.createGain();o.type=ty;o.frequency.setValueAtTime(f,t);g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(g);g.connect(a.destination);o.start(t);o.stop(t+d);}
function noise(t,d,v,hp){const a=ctx();if(!nz){nz=a.createBuffer(1,a.sampleRate*.3,a.sampleRate);const x=nz.getChannelData(0);for(let i=0;i<x.length;i++)x[i]=Math.random()*2-1;}
 const s=a.createBufferSource(),f=a.createBiquadFilter(),g=a.createGain();s.buffer=nz;f.type='highpass';f.frequency.value=hp;g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);s.connect(f);f.connect(g);g.connect(a.destination);s.start(t);s.stop(t+d);}
function rstep(S,i,t){if(S.k.includes(i)){const a=ctx(),o=a.createOscillator(),g=a.createGain();o.frequency.setValueAtTime(130,t);o.frequency.exponentialRampToValueAtTime(40,t+.15);g.gain.setValueAtTime(.5,t);g.gain.exponentialRampToValueAtTime(.0001,t+.2);o.connect(g);g.connect(a.destination);o.start(t);o.stop(t+.2);}
 if(S.c.includes(i))noise(t,.12,.25,1500);if(i%2===0)noise(t,.04,.08,7000);
 if(S.b[i])tone(S.b[i],t,.3,'sine',.35);if(S.l[i])tone(S.l[i],t,.22,S.lt,.07);}
function radioSet(i){clearInterval(rd.t);if(rd.a){rd.a.pause();rd.a=null;}rd.i=i;
 if(i===1||i===2){const S=ST[i],a=ctx();rd.s=0;rd.n=a.currentTime+.1;rd.t=setInterval(()=>{while(rd.n<a.currentTime+.15){rstep(S,rd.s%16,rd.n);rd.n+=60/S.bpm/4;rd.s++;}},30);}
 else if(i===3)$('mf').click();
 else if(i===4){const u=prompt('Paste an audio stream or file URL');if(u){rd.a=new Audio(u);rd.a.loop=true;rd.a.play().catch(()=>{});}}}
$('mf').onchange=e=>{const f=e.target.files[0];if(f){rd.a=new Audio(URL.createObjectURL(f));rd.a.loop=true;rd.a.play().catch(()=>{});}};
$('radio').onclick=()=>panel('<b>📻 Car radio</b><p>'+['Off','Naija Beats FM (synth)','Highlife Chill FM (synth)','My music (pick a file)','Stream URL'].map((n,i)=>'<button data-i="'+i+'">'+(rd.i===i?'▶ ':'')+n+'</button>').join('<br>')+'</p>');
