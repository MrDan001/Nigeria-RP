   g.fillStyle="#ffffff";g.textAlign="center";g.font="bold 36px system-ui";g.fillText("STOP  •  HONK AT THE GARAGE DOOR",w/2,79);
 });
 readableTextBoard(scene,new THREE.PlaneGeometry(11.2,2.35),gateSign,ix,3.75,iz+15.58,Math.PI);
 const topLabel=tex(512,80,(g,w,h)=>{
   g.fillStyle="#152329";g.fillRect(0,0,w,h);g.fillStyle="#f3c33d";g.fillRect(0,0,w,6);
   g.fillStyle="#ffffff";g.textAlign="center";g.font="bold 27px system-ui";g.fillText("NRS  •  PRIVATE RESIDENTIAL GARAGE",w/2,51);
 });
 readableTextBoard(scene,new THREE.PlaneGeometry(13,.9),topLabel,ix,5.48,iz-18.98);
 return HOME_ROOMS.__privateGarage={id:"__privateGarage",name:"Private car park",x:ix,z:iz,cb:{x:ix-12.8,z:iz-1,hw:.4,hd:.4},pois:[],isCarpark:true,home:d.home||null};
}
function openGarageFootExitMenu(){
 const home=inside?.home||{},cls=home.cls||'flat';
 const returnWord=cls==='hut'?'hut':cls==='faceme'?'room':cls==='flat'?'apartment':'house';
 panel('<b>🚪 Garage door</b><p class="route-copy">You are on foot at the private garage door. Choose where to go.</p><button data-garage-route="street">🚶 Exit to street<br><small>Leave the garage on foot.</small></button><button data-garage-route="home">🏠 Exit to your '+returnWord+'<br><small>Return to your rented '+returnWord+'.</small></button>');
}
function openGarageSpawnMenu(){const N=window.NRS||{},life=N.life||{},owned=new Set(life.ownedCars||[]),list=cars.filter(c=>c.kind!=="t"&&c.id&&owned.has(c.id));const names={c0:"Black executive saloon",c1:"Red city saloon",c2:"Blue family saloon",c3:"Silver luxury saloon",c4:"Black premium saloon"};panel('<b>🚘 Private car park</b><p class="route-copy">Select one of your cars. It spawns in a numbered bay. Drive slowly to the enclosed garage door, stop completely and hold the horn to open the gate and enter the street.</p>'+list.map(c=>'<button data-garage-car="'+c.id+'">🚗 '+(names[c.id]||("Vehicle "+c.id))+'<br><small>'+c.id.toUpperCase()+' · Fuel '+Math.round(c.fuel||0)+' L</small></button>').join('')+(list.length?'':'<p>No owned vehicles are available.</p>'));}

modal.addEventListener('click',e=>{
 const lockButton=e.target.closest('[data-house-lock]');
 if(lockButton){const N=window.NRS;if(N?.setHouseLock){const id=lockButton.dataset.houseLock,locked=lockButton.dataset.houseLockTo==='true';modal.style.display='none';modal.innerHTML='';N.setHouseLock(id,locked);}return;}
 const visitButton=e.target.closest('[data-house-visit]');
 if(visitButton){const N=window.NRS;if(N?.enterHouse){routeTransitionIn();modal.style.display='none';modal.innerHTML='';act2.style.display='none';N.enterHouse(visitButton.dataset.houseVisit);}else sys('House access is not connected yet.');return;}
 const rentButton=e.target.closest('[data-house-rent]');
 if(rentButton){const N=window.NRS;if(N?.rentHouse&&!rentButton.disabled){const id=rentButton.dataset.houseRent,days=Number(modal.querySelector('#houseRentDays')?.value||1);modal.style.display='none';modal.innerHTML='';N.rentHouse(id,days);}return;}
 const garageRoute=e.target.closest('[data-garage-route]')?.dataset.garageRoute;
 if(garageRoute&&inside?.isCarpark&&!driving){
  const N=window.NRS;
  if(!N||typeof N.exitCarparkOnFoot!=='function'){sys('Garage connection is not ready.');return;}
  routeTransitionIn();modal.style.display='none';modal.innerHTML='';
  N.exitCarparkOnFoot(garageRoute);return;
 }
 const route=e.target.closest('[data-exit-route]')?.dataset.exitRoute;
 if(route){if(route==='street')returnToStreetFromRoom();else{if(!inside?.isHome||!(inside.home?.isOwner||inside.home?.occupiedByMe)){sys('Only the resident of this home can use its private car park.');return;}const N=window.NRS;if(N&&N.enterCarpark){routeTransitionIn();modal.style.display='none';modal.innerHTML='';N.enterCarpark();}}return;}
 const carId=e.target.closest('[data-garage-car]')?.dataset.garageCar;
 if(carId&&inside?.isCarpark){
  const c=cars.find(v=>v.id===carId&&v.kind!=='t');
  if(!c)return;
  const N=window.NRS;
  if(!N||typeof N.spawnCarparkVehicle!=='function'){sys('Garage connection is not ready. Please try again.');return;}
  N.spawnCarparkVehicle(c.id,(result)=>{
   if(!result?.ok){sys(result?.message||'The server could not spawn this vehicle.');return;}
   cars.filter(v=>v.kind!=='t'&&v.id).forEach(v=>{v.g.visible=false;v.box.hw=0;v.box.hd=0;v.v=v.vx=v.vz=0;});
   c.x=Number(result.x);c.z=Number(result.z);c.ry=Number(result.yaw)||0;c.on=false;c.starting=false;c.g.visible=true;c.box.hw=1.05;c.box.hd=2.3;setCar(c);
   pos.set(c.x,0,c.z);focus.set(pos.x,1.4,pos.z);nearCar=c;modal.style.display='none';modal.innerHTML='';$('act').onclick();
   sys('🚗 '+c.id.toUpperCase()+' spawned. Drive through the marked lane, stop at the gate, then hold the horn to enter the street.');
  });
 }
});
