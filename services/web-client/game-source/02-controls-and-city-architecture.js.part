 {id:'army-rivers',name:'Nigerian Army — Port Harcourt Garrison',x:185,z:-150},
 {id:'transport-union',name:'Port Harcourt Transport Union',x:14,z:60,entryX:16,entryZ:54}
];
const WORKPLACE_ENTRY_DESIGNS={
 'market-mile1':{wall:0xb8a27a,trim:0x573b29,accent:0xf0b943},
 'bank-main':{wall:0xc3d0d7,trim:0x1d3e58,accent:0x1d8cc0},
 'park-main':{wall:0xd5d3b6,trim:0x3d6946,accent:0x81b85a},
 'news-main':{wall:0x9ba8b9,trim:0x1d2d42,accent:0xd9444c},
 'gov-rivers':{wall:0xd7c8a6,trim:0x243e56,accent:0xd3ad4c},
 'police-rivers':{wall:0xbfc9d3,trim:0x243e58,accent:0x3d87d1},
 'frsc-rivers':{wall:0xe0d8bd,trim:0x255a4b,accent:0xe0bf36},
 'fire-rivers':{wall:0xc6b9ad,trim:0x6b2929,accent:0xe54837},
 'army-rivers':{wall:0xb3b7a4,trim:0x374734,accent:0xc39b4d},
 'transport-union':{wall:0xc5c6c2,trim:0x313b42,accent:0xe7a92d}
};

const WORKPLACE_BUILDING_PROFILES={
 'market-mile1':{kind:'market',w:34,d:22,h:7,floors:1,axis:'z',subtitle:'TRADERS • PRODUCE • DAILY COMMERCE'},
 'bank-main':{kind:'bank',w:22,d:24,h:16,floors:4,axis:'east',subtitle:'BANKING • CUSTOMER SERVICE',signWidth:9.2,signY:7.0},
 'park-main':{kind:'park',w:14,d:12,h:5,floors:1,axis:'z',subtitle:'PARK AUTHORITY • VISITOR SERVICES'},
 'news-main':{kind:'news',w:28,d:22,h:16,floors:4,axis:'z',subtitle:'NEWSROOM • RADIO • BROADCAST'},
 'gov-rivers':{kind:'government',w:18,d:34,h:27,floors:6,axis:'z',subtitle:'STATE SECRETARIAT • PUBLIC ADMINISTRATION'},
 'police-rivers':{kind:'police',w:16,d:18,h:12,floors:3,axis:'z',subtitle:'POLICE HEADQUARTERS • EMERGENCY DESK'},
 'frsc-rivers':{kind:'frsc',w:24,d:18,h:9,floors:2,axis:'z',subtitle:'ROAD SAFETY • DRIVER SUPPORT'},
 'fire-rivers':{kind:'fire',w:14,d:16,h:8,floors:2,axis:'z',subtitle:'FIRE • RESCUE • EMERGENCY RESPONSE'},
 'army-rivers':{kind:'army',w:32,d:30,h:12,floors:3,axis:'z',subtitle:'PORT HARCOURT GARRISON • DUTY HQ'},
 'transport-union':{kind:'transport',w:30,d:24,h:7,floors:1,axis:'west',subtitle:'PASSENGER TERMINAL • ROUTE DISPATCH'}
};
// The workplace coordinates are the navigation/interaction points. Give every POI-only site
// a visible, branded entry facade, double doors, lights and a clear MAIN ENTRANCE sign.
function buildWorkplaceEntrance(w){
 const palette=WORKPLACE_ENTRY_DESIGNS[w.id]||{wall:0xbcc5c9,trim:0x334452,accent:0x4f9dba};
 const p=WORKPLACE_BUILDING_PROFILES[w.id]||{kind:'office',w:20,d:18,h:9,floors:2,axis:'z',subtitle:'MAIN ENTRANCE'};
 const frontZ=w.z-2.05;
 let main=null;
 if(p.axis==='east'){
  main=organizationBlockX(w,'east',p.w,p.d,p.h,p.floors,palette,p.kind,3.3,w.z);
  organizationEntranceX(w,palette,{orientation:'east',doorWidth:3.3,signWidth:p.signWidth||9.2,signY:p.signY||7.0,subtitle:p.subtitle});
  /* Public-facing ATM cubicle beside the entrance, clear of the arterial carriageway. */
  organizationBox(1.35,2.5,1.35,-8.9,1.25,-12.6,0x27333a);
  organizationBox(.8,.9,.06,-8.9,1.35,-11.89,0x218bd1);
  organizationBox(.35,.22,.07,-8.9,1.0,-11.86,0x65dcad);
  [-1,1].forEach(k=>organizationBox(.12,1.0,.12,-8.9+k*.65,.5,-12.6,0x5f6b73));
 }else if(p.axis==='west'){
  const doorZ=w.z-6;
  main=organizationBlockX(w,'west',p.w,p.d,p.h,p.floors,palette,p.kind,3.4,doorZ);
  organizationEntranceX(w,palette,{orientation:'west',doorZ,doorWidth:3.4,signWidth:8.2,signY:4.9,subtitle:p.subtitle});
  /* Covered passenger waiting bay and two compact local minibuses inside the depot plot. */
  organizationBox(13,.32,7,w.x+37,4.0,w.z-7,palette.trim);
  [-1,1].forEach(k=>{
   organizationBox(.18,3.8,.18,w.x+31,1.9,w.z-4+k*5,palette.trim);
   organizationBox(.18,3.8,.18,w.x+43,1.9,w.z-4+k*5,palette.trim);
  });
  [-1,1].forEach(k=>{
   const bx=w.x+37,bz=w.z-10+k*8;
   organizationBox(4.5,1.45,2.2,bx,.95,bz,0xeee9dd);
   organizationBox(3.6,.63,2.28,bx,1.75,bz,0x263d4b);
   organizationBox(3.9,.18,2.34,bx,1.36,bz,0xe1b247);
   [-1,1].forEach(side=>organizationBox(.72,.52,.10,bx+side*1.22,1.78,bz-1.17,0x80b9cb));
   [-1,1].forEach(side=>[-1,1].forEach(end=>add(new THREE.CylinderGeometry(.36,.36,.22,12),M(0x222629),bx+side*1.55,.38,bz+end*.72).rotation.z=Math.PI/2));
  });
  flatW(2.5,7,swm,w.x+2.8,.067,w.z-3.5,4);
 }else{
  main=organizationBlockZ(w.x,frontZ,p.w,p.d,p.h,p.floors,palette,p.kind,p.doorWidth||(w.id==='gov-rivers'?5.4:3.4));
  if(w.id==='gov-rivers'){
   /* State secretariat: a tall central administrative block and broad office wings. */
   organizationBlockZ(w.x-15.2,frontZ-2.0,14,30,19,4,palette,'government');
   organizationBlockZ(w.x+15.2,frontZ-2.0,14,30,19,4,palette,'government');
   organizationEntranceZ(w,palette,{frontZ,doorWidth:5.4,doorHeight:3.1,columns:6,signWidth:18,signHeight:2.0,signY:10.0,subtitle:p.subtitle});
   organizationBox(18,.42,5.1,w.x,5.8,frontZ+2.1,palette.trim);
   organizationBox(18,.16,5.3,w.x,6.05,frontZ+2.1,palette.accent);
   flag(w.x-8,w.z+5);flag(w.x+8,w.z+5);
   const seal=add(new THREE.CylinderGeometry(1.0,1.0,.16,24),M(0xd4ad4e),w.x,15.0,frontZ+.13);
   seal.rotation.x=Math.PI/2;
   organizationSign('RIVERS STATE GOVERNMENT',palette,16,1.55,w.x,18.0,frontZ+.16,0,'OFFICIAL STATE SECRETARIAT');
  }else if(w.id==='market-mile1'){
