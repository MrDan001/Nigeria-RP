const act2=document.createElement('button');act2.id='act2';document.body.appendChild(act2);
function shopUI(){const p=shopP;if(!p.items){panel('<b>'+p.name+'</b><p>Jobs and missions open in Stage 6.</p>');return;}
 panel('<b>'+p.name+'</b><p>'+(p.k==='Talk'?'“Wetin you wan buy?”':'Welcome in!')+'</p><p>Cash: ₦'+cash.toLocaleString()+'</p>'+p.items.map((it,i)=>'<button data-b="'+i+'">'+it[0]+' – ₦'+it[1].toLocaleString()+'</button>').join('<br>')+(pMsg?'<p><i>'+pMsg+'</i></p>':''));}
act2.onclick=()=>{if(curPoi){shopP=curPoi;pMsg='';shopUI();}};
modal.addEventListener('click',e=>{const i=e.target.dataset&&e.target.dataset.b;if(i===undefined||!shopP||!shopP.items)return;const it=shopP.items[+i];
 if(cash>=it[1]){NRS.walletChange(-it[1],0,(r)=>{if(r.ok){inv[it[0]]=(inv[it[0]]||0)+1;pMsg='Bought '+it[0]+'.';if(window.NRS?.saveProgress)window.NRS.saveProgress();}else pMsg=r.message||'Purchase failed.';money();shopUI();});return;}else pMsg='Not enough cash.';shopUI();});
modal.addEventListener('click',e=>{
 const floorButton=e.target.closest('[data-apartment-floor]');
 if(floorButton){
  const floor=Math.floor(Number(floorButton.dataset.apartmentFloor));
  if(window.NRS?.changeApartmentFloor&&Number.isInteger(floor)){floorButton.disabled=true;window.NRS.changeApartmentFloor(floor);}
  else sys('Elevator connection is not ready. Try again.');
  return;
 }
 const lockButton=e.target.closest('[data-apartment-lock]');
 if(lockButton){
  const buildingId=String(lockButton.dataset.apartmentBuilding||inside?.apartmentBuildingId||'');
  const roomNumber=Math.floor(Number(lockButton.dataset.apartmentRoom||inside?.apartmentRoomNumber));
  const locked=lockButton.dataset.apartmentLock==='true';
  if(window.NRS?.setApartmentRoomLock&&buildingId&&Number.isInteger(roomNumber)){lockButton.disabled=true;window.NRS.setApartmentRoomLock(buildingId,roomNumber,locked);}
  else sys('Room settings are not ready. Try again.');
  return;
 }
 const enter=e.target.closest('[data-apartment-enter]');
 if(enter){
  const buildingId=String(enter.dataset.apartmentBuilding||inside?.apartmentBuildingId||'');
  const roomNumber=Math.floor(Number(enter.dataset.apartmentEnter));
  if(window.NRS?.enterApartmentRoom&&buildingId&&Number.isInteger(roomNumber)){enter.disabled=true;window.NRS.enterApartmentRoom(buildingId,roomNumber);}
  else sys('Apartment entry is not ready. Try the numbered door again.');
  return;
 }
 const button=e.target.closest('[data-apartment-rent]');if(!button)return;
 const days=Math.floor(Number(modal.querySelector('#apartmentRentDays')?.value||1));
 const buildingId=String(button.dataset.apartmentBuilding||inside?.apartmentBuildingId||'');
 const roomNumber=Math.floor(Number(button.dataset.apartmentRent));
 if(!window.NRS?.rentApartmentRoom||!buildingId||!Number.isInteger(roomNumber)){sys('Apartment rental is not ready. Try the door again.');return;}
 button.disabled=true;window.NRS.rentApartmentRoom(buildingId,roomNumber,days);
});
$('ib2').onclick=()=>{const k=Object.keys(inv);panel('<b>🎒 Backpack</b><p>📱 Phone</p>'+k.map(n=>'<p>'+n+' ×'+inv[n]+'</p>').join('')+'<p>Cash: ₦'+cash.toLocaleString()+'</p>');};

