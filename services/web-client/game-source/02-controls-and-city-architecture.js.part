 [-14,14].forEach(side=>{
   add(new THREE.BoxGeometry(.7,6.1,33.8),wall,ix+side,3,iz-.4);
   add(new THREE.BoxGeometry(.12,5.8,33.1),wallDark,ix+side+(side<0?.38:-.38),3,iz-.4);
   for(let z=-15;z<=14;z+=9){
     add(new THREE.BoxGeometry(.9,6.15,.9),steel,ix+side,3,iz+z);
     add(new THREE.BoxGeometry(.94,.2,.94),yellow,ix+side,5.95,iz+z);
     add(new THREE.BoxGeometry(.98,.22,.98),metal,ix+side,0.22,iz+z);
   }
 });
 // Rear wall and front wall split around the vehicle doorway.
 add(new THREE.BoxGeometry(28.2,6.1,.7),wall,ix,3,iz-19.45);
 add(new THREE.BoxGeometry(28.4,.18,.74),blue,ix,5.9,iz-19.45);
 add(new THREE.BoxGeometry(8.4,6.1,.75),wall,ix-10.1,3,iz+16);
 add(new THREE.BoxGeometry(8.4,6.1,.75),wall,ix+10.1,3,iz+16);
 add(new THREE.BoxGeometry(12.1,.75,1.0),steel,ix,5.72,iz+16);
 // Industrial roller-door rails, slatted door parked overhead, and yellow safety jambs.
 [-6.05,6.05].forEach(x=>{
   add(new THREE.BoxGeometry(.22,5.05,.34),metal,ix+x,2.52,iz+15.55);
   add(new THREE.BoxGeometry(.32,5.05,.12),yellow,ix+x,2.52,iz+15.33);
   for(let y=.25;y<=4.55;y+=.48)add(new THREE.BoxGeometry(.3,.07,.14),steel,ix+x,y,iz+15.19);
 });
 add(new THREE.BoxGeometry(11.8,.46,.55),metal,ix,5.18,iz+15.48);
 for(let y=4.48;y<=4.98;y+=.17)add(new THREE.BoxGeometry(11.2,.07,.14),steel,ix,y,iz+15.23);
 add(new THREE.BoxGeometry(11.9,.12,.18),yellow,ix,4.38,iz+15.27);
 // Ceiling LED strips, emergency lamps and ventilation units.
 for(let x=-10;x<=10;x+=10){
   add(new THREE.BoxGeometry(.16,.1,30),metal,ix+x,5.94,iz-.5);
   for(let z=-12;z<=11;z+=11){
     add(new THREE.BoxGeometry(1.45,.09,4.3),white,ix+x,5.89,iz+z);
     add(new THREE.BoxGeometry(1.05,.04,3.7),new THREE.MeshBasicMaterial({color:0xffefbf}),ix+x,5.82,iz+z);
   }
 }
 for(const x of [-8,8]){
   add(new THREE.BoxGeometry(1.5,.3,1.5),steel,ix+x,5.7,iz-17.3);
   add(new THREE.CylinderGeometry(.47,.47,.16,20),metal,ix+x,5.46,iz-17.3);
   add(new THREE.CylinderGeometry(.31,.31,.17,16),blue,ix+x,5.34,iz-17.3);
 }
 // Marked resident bays, wheel-stops, bay numbers and a clear central exit lane.
 for(let i=0;i<5;i++){
   const x=ix-9+i*4.5,bayZ=iz-5;
   flat(3.8,9.8,M(0x50595b),x,.045,bayZ);
   for(const side of [-1,1])add(new THREE.BoxGeometry(.055,.035,9.5),white,x+side*1.85,.07,bayZ);
   add(new THREE.BoxGeometry(3.7,.045,.07),yellow,x,.075,bayZ-4.8);
   add(new THREE.BoxGeometry(3.7,.045,.07),yellow,x,.075,bayZ+4.75);
   add(new THREE.BoxGeometry(1.0,.12,.22),metal,x,.13,bayZ+3.95);
   const number=tex(128,96,(g,w,h)=>{g.fillStyle="#192529";g.fillRect(0,0,w,h);g.fillStyle="#f2c846";g.textAlign="center";g.font="bold 58px system-ui";g.fillText(String(i+1).padStart(2,"0"),w/2,67);});
   readableTextBoard(scene,new THREE.PlaneGeometry(1.05,.8),number,x,1.15,bayZ-3.8);
 }
 // Workshop cabinet and wall-mounted extinguishers give the private garage scale.
 add(new THREE.BoxGeometry(2.6,1.45,.7),metal,ix-12,0.82,iz-8.8);
 add(new THREE.BoxGeometry(2.35,.12,.12),yellow,ix-12,1.55,iz-8.42);
 for(const x of [-12.9,12.9]){
   add(new THREE.CylinderGeometry(.16,.16,.75,12),M(0xb92e28),ix+x,1.0,iz+5);
   add(new THREE.BoxGeometry(.42,.15,.15),white,ix+x,1.4,iz+5);
 }
 flat(8,.16,yellow,ix,.07,iz+11.9);
 flat(8,.16,white,ix,.075,iz+12.55);
 const gateSign=tex(512,128,(g,w,h)=>{
