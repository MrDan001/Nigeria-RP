/* ---------- Stage 4: shops, market stalls, roadside sellers ---------- */
let cash=5000,curPoi=null,shopP=null,pMsg='';const inv={},POI=[],FS=[];
const money=()=>{$('cash').textContent=cash.toLocaleString();};money();
const fit=(g,t,max,W)=>g.font='bold '+Math.min(max,Math.floor(W/(t.length*.6)))+'px system-ui';
function mirrorSignTexture(texture){const back=texture.clone();back.wrapS=THREE.RepeatWrapping;back.center.set(0,0);back.repeat.set(-1,1);back.offset.set(1,0);back.needsUpdate=true;return back;}
function readableTextBoard(parent,geometry,texture,x,y,z,rotationY=0){
 const board=new THREE.Group();board.position.set(x,y,z);board.rotation.y=rotationY;parent.add(board);
 const front=new THREE.Mesh(geometry,new THREE.MeshBasicMaterial({map:texture,side:THREE.FrontSide,fog:false}));
 front.position.z=.012;board.add(front);
 const back=new THREE.Mesh(makeReadableSignBackGeometry(geometry),new THREE.MeshBasicMaterial({map:texture,side:THREE.FrontSide,fog:false}));
 back.rotation.y=Math.PI;back.position.z=-.012;board.add(back);
 return board;
}
let FORBES_SIGN=null;
function drawForbesPhysicalSign(players){
 if(!FORBES_SIGN)return;
 const {ctx,canvas,texture}=FORBES_SIGN;
 ctx.clearRect(0,0,canvas.width,canvas.height);
 ctx.fillStyle='#102a35';ctx.fillRect(0,0,canvas.width,canvas.height);
 ctx.fillStyle='#c7a75c';ctx.fillRect(0,0,canvas.width,12);ctx.fillRect(0,canvas.height-12,canvas.width,12);
 ctx.strokeStyle='#e5c46d';ctx.lineWidth=5;ctx.strokeRect(8,8,canvas.width-16,canvas.height-16);
 ctx.textAlign='center';ctx.fillStyle='#f4d77b';ctx.font='900 54px system-ui';ctx.fillText('FORBES',canvas.width/2,66);
 ctx.fillStyle='#fff';ctx.font='800 25px system-ui';ctx.fillText('PORT HARCOURT · TOP 10 RICHEST PLAYERS',canvas.width/2,105);
 ctx.strokeStyle='rgba(255,255,255,.28)';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(32,126);ctx.lineTo(canvas.width-32,126);ctx.stroke();
 const rows=Array.isArray(players)?players.slice(0,10):[];
 if(!rows.length){
  ctx.textAlign='center';ctx.fillStyle='#d5e0e5';ctx.font='600 25px system-ui';
  ctx.fillText('LIVE IN-GAME WEALTH RANKING',canvas.width/2,340);
  ctx.fillText('Connect to load the latest top 10',canvas.width/2,380);
 }else{
  rows.forEach((player,index)=>{
   const y=158+index*39;
   ctx.fillStyle=index===0?'rgba(199,167,92,.24)':index%2?'rgba(255,255,255,.035)':'rgba(255,255,255,.075)';
   ctx.fillRect(24,y-28,canvas.width-48,35);
   ctx.textAlign='left';ctx.fillStyle=index===0?'#ffe28a':'#eff5f7';ctx.font='800 25px system-ui';
   ctx.fillText(String(index+1).padStart(2,'0'),42,y,50);
   ctx.fillText(String(player.username||'Citizen'),112,y,555);
   ctx.textAlign='right';ctx.fillStyle='#81e5b1';ctx.font='800 23px system-ui';
   ctx.fillText('₦'+Math.max(0,Math.floor(Number(player.totalWealth)||0)).toLocaleString('en-NG'),canvas.width-42,y,300);
  });
 }
 texture.needsUpdate=true;
}
function createForbesPhysicalSign(x,y,z){
 const canvas=document.createElement('canvas');canvas.width=1024;canvas.height=560;
 const ctx=canvas.getContext('2d'),texture=new THREE.CanvasTexture(canvas);texture.colorSpace=THREE.SRGBColorSpace;
 const group=new THREE.Group();group.position.set(x,y,z);scene.add(group);
 const geo=new THREE.PlaneGeometry(8.4,4.6);
 const front=new THREE.Mesh(geo,new THREE.MeshBasicMaterial({map:texture,side:THREE.FrontSide,fog:false}));front.position.z=.025;group.add(front);
 const back=new THREE.Mesh(makeReadableSignBackGeometry(geo),new THREE.MeshBasicMaterial({map:texture,side:THREE.FrontSide,fog:false}));back.rotation.y=Math.PI;back.position.z=-.025;group.add(back);
 FORBES_SIGN={canvas,ctx,texture,group};
 drawForbesPhysicalSign(window.NRS?.richestPlayers||[]);
}
const mini=(t,x,y,z,w,bg)=>{const board=new THREE.Group();board.position.set(x,y,z);scene.add(board);const geo=new THREE.PlaneGeometry(w,w/4),map=tex(256,64,(g,W,H)=>{g.fillStyle=bg;g.fillRect(0,0,W,H);g.fillStyle='#fff';g.textAlign='center';fit(g,t,26,240);g.fillText(t,W/2,H*.64);}),frontMat=new THREE.MeshBasicMaterial({map,side:THREE.FrontSide}),backMat=new THREE.MeshBasicMaterial({map,side:THREE.FrontSide});const front=new THREE.Mesh(geo,frontMat);front.position.z=.012;board.add(front);const back=new THREE.Mesh(makeReadableSignBackGeometry(geo),backMat);back.rotation.y=Math.PI;back.position.z=-.012;board.add(back);return board;};
const WORKPLACE_SIGNBOARDS={};
function updateWorkplaceOccupantSigns(workplaces){
 if(!Array.isArray(workplaces))return;
 Object.values(WORKPLACE_SIGNBOARDS).forEach(sign=>{
  const workplace=workplaces.find(w=>w.id===sign.site.id),boss=(workplace?.staff||[]).find(p=>p.boss);
  const occupant=workplace?.bossName||boss?.name||null,title=boss?.rankTitle||sign.site.leaderTitle||'WORKPLACE HEAD';
  const ctx=sign.ctx,canvas=sign.canvas;ctx.clearRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle='#'+Number(sign.site.trim).toString(16).padStart(6,'0');ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.textAlign='center';ctx.fillStyle='#fff';ctx.font='800 27px system-ui';ctx.fillText(sign.site.name.toUpperCase(),canvas.width/2,37,canvas.width-18);
  const line=occupant?(title.toUpperCase()+': '+occupant):'LEADERSHIP POSITION OPEN';let size=20;ctx.font='800 '+size+'px system-ui';
  while(size>12&&ctx.measureText(line).width>canvas.width-18){size--;ctx.font='800 '+size+'px system-ui';}
  ctx.fillStyle=occupant?'#dbf7e7':'#ffe3a3';ctx.fillText(line,canvas.width/2,80,canvas.width-18);
  ctx.font='600 13px system-ui';ctx.fillStyle='#e4ecf1';ctx.fillText('OFFICIAL FACILITY SIGN',canvas.width/2,108,canvas.width-18);sign.texture.needsUpdate=true;if(sign.backBoard?.material?.map)sign.backBoard.material.map.needsUpdate=true;
 });
}
function addWorkplaceOccupantSign(site){
 const canvas=document.createElement('canvas');canvas.width=640;canvas.height=128;const ctx=canvas.getContext('2d'),texture=new THREE.CanvasTexture(canvas);texture.colorSpace=THREE.SRGBColorSpace;
 const sx=site.x+site.w/2+1.25,sz=site.z+site.d/2+2.8;add(new THREE.CylinderGeometry(.065,.09,1.6,8),M(0x68737b),sx,.8,sz);
 const boardMat=new THREE.MeshBasicMaterial({map:texture,side:THREE.FrontSide});const board=new THREE.Mesh(new THREE.PlaneGeometry(4.8,.96),boardMat);board.position.set(sx,2.0,sz);scene.add(board);
 const backBoard=new THREE.Mesh(makeReadableSignBackGeometry(new THREE.PlaneGeometry(4.8,.96)),new THREE.MeshBasicMaterial({map:texture,side:THREE.FrontSide}));backBoard.rotation.y=Math.PI;backBoard.position.copy(board.position);scene.add(backBoard);
 WORKPLACE_SIGNBOARDS[site.id]={site,canvas,ctx,texture,board,backBoard};updateWorkplaceOccupantSigns(window.NRS?.workplaces||[]);
}
function buildHospital(site){
 building(site.x,site.z,site.w,site.d,site.h,site.wall,-1,.35,3.2,'z');
 const front=site.z+site.d/2;
 const mat=c=>M(c);
 const wall=mat(site.wall),trim=mat(site.trim),accent=mat(site.accent),glass=new THREE.MeshLambertMaterial({color:0x517f91,emissive:0x0d2027,transparent:true,opacity:.88});
 add(new THREE.BoxGeometry(site.w+.45,.38,site.d+.45),trim,site.x,.35,site.z);
 add(new THREE.BoxGeometry(site.w+.55,.25,site.d+.55),wall,site.x,site.h+.08,site.z);
 add(new THREE.BoxGeometry(site.w*.46,.28,2.0),trim,site.x,site.h-.1,front+.65);
 add(new THREE.BoxGeometry(site.w*.49,.18,2.8),accent,site.x,2.85,front+.95);
 // A clearly visible main entrance with a covered drop-off canopy.
 add(new THREE.BoxGeometry(3.6,2.5,.13),trim,site.x,1.27,front+.12);
 add(new THREE.BoxGeometry(3.15,2.15,.09),glass,site.x,1.22,front+.22);
 add(new THREE.BoxGeometry(.10,2.1,.11),wall,site.x,1.2,front+.29);
 // Visible dark double doors sit proud of the solid base facade instead of disappearing behind glass.
 add(new THREE.BoxGeometry(1.86,2.45,.16),trim,site.x,1.23,front+.43);
 [-1,1].forEach(side=>{
  add(new THREE.BoxGeometry(.84,2.22,.09),M(0x18242b),site.x+side*.43,1.15,front+.54);
  add(new THREE.BoxGeometry(.38,.7,.035),new THREE.MeshBasicMaterial({color:0x416a79}),site.x+side*.43,1.62,front+.60);
  add(new THREE.BoxGeometry(.045,.24,.08),M(0xd8b76b),site.x+side*.15,1.06,front+.62);
 });
 add(new THREE.BoxGeometry(2.02,.13,.18),accent,site.x,2.52,front+.45);
 add(new THREE.BoxGeometry(5.7,.18,2.6),trim,site.x,3.15,front+1.0);
 add(new THREE.BoxGeometry(5.9,.12,2.8),accent,site.x,3.26,front+1.0);
 [-1,1].forEach(side=>{
  for(let floor=0;floor<2;floor++)for(let col=0;col<4;col++){
   const wx=site.x+side*(3.1+col*2.05),wy=2.0+floor*3.2;
   add(new THREE.BoxGeometry(1.42,1.22,.1),trim,wx,wy,front+.09);
   add(new THREE.BoxGeometry(1.2,1.0,.08),glass,wx,wy,front+.16);
   add(new THREE.BoxGeometry(1.2,.04,.1),wall,wx,wy,front+.21);
  }
 });
 // Roof plant room and water tank make each hospital read as an occupied Nigerian facility.
 add(new THREE.BoxGeometry(4.2,1.4,3.6),wall,site.x-site.w*.28,site.h+.82,site.z-.6);
 add(new THREE.CylinderGeometry(.72,.72,1.45,14),trim,site.x+site.w*.28,site.h+.9,site.z-1.7);
 add(new THREE.CylinderGeometry(.76,.76,.12,14),accent,site.x+site.w*.28,site.h+1.66,site.z-1.7);
 const signTex=tex(512,112,(g,w,h)=>{
  g.fillStyle='#'+site.trim.toString(16).padStart(6,'0');g.fillRect(0,0,w,h);
  g.fillStyle='#ffffff';g.font='bold 34px system-ui';g.textAlign='center';
  g.fillText(site.name.toUpperCase(),w/2,44);
  g.font='bold 17px system-ui';g.fillStyle='#dff5f5';g.fillText('PATIENT CARE  •  EMERGENCY SERVICES',w/2,80);
 });
 readableTextBoard(scene,new THREE.PlaneGeometry(site.w*.82,1.7),signTex,site.x,site.h-1.0,front+.17);
 // Distinctive medical cross signage.
 const cx=site.x-site.w/2+2.2,cy=site.h-1.05,cz=front+.2;
 add(new THREE.BoxGeometry(1.5,1.5,.1),M(0xf4f4ef),cx,cy,cz);
 add(new THREE.BoxGeometry(.34,1.05,.13),accent,cx,cy,cz+.08);
 add(new THREE.BoxGeometry(1.05,.34,.13),accent,cx,cy,cz+.08);
 // Patient drop-off driveways connect to the existing road edge; they do not modify the road itself.
 if(site.id==='hospital-main'){
  flatW(8.5,6,swm,site.x+2,.061,front+3.0,4);
  flatW(4.0,9,asphalt2,site.x+4,.063,108.5,6);
  flatW(8,4,swm,site.x+2,.062,112.5,4);
  [-1,1].forEach(side=>add(new THREE.BoxGeometry(.08,.06,7),M(0xe6d7b4),site.x+4+side*2,.09,108));
 }else{
  flatW(11,7,swm,site.x-9,.061,front+3.2,4);
  flatW(4.4,14,asphalt2,site.x,.063,-122,6);
  flatW(8,4,swm,site.x,.062,-116.7,4);
  [-1,1].forEach(side=>add(new THREE.BoxGeometry(.08,.06,6),M(0xe6d7b4),site.x+side*2.1,.09,-122));
 }
 [-1,1].forEach(side=>{
  add(new THREE.BoxGeometry(.24,2.9,.24),trim,site.x+side*2.45,1.45,front+1.7);
  add(new THREE.BoxGeometry(.58,.3,.58),accent,site.x+side*2.45,.18,front+1.7);
  add(new THREE.BoxGeometry(1.7,.32,1.7),M(0x9aab8c),site.x+side*(site.w/2+1.2),.18,front-.5);
  add(new THREE.SphereGeometry(.45,10,8),M(0x2f824d),site.x+side*(site.w/2+1.2),.62,front-.5);
 });
 POI.push({x:site.entryX,z:site.entryZ,k:'Work',name:site.name,t:'workplace',workplaceId:site.id,r:8});
 addWorkplaceOccupantSign(site);
}

/* ---------- Purpose-built organization architecture ---------- */
/* Facade textures keep these detailed campuses efficient enough for mobile rendering. */
function organizationFacadeTexture(palette,kind,floors,mainFace){
 const c=document.createElement('canvas');c.width=1024;c.height=512;
 const g=c.getContext('2d'),hex=n=>'#'+Number(n).toString(16).padStart(6,'0');
 const wall=hex(palette.wall),trim=hex(palette.trim),accent=hex(palette.accent);
 g.fillStyle=wall;g.fillRect(0,0,c.width,c.height);
 g.fillStyle='rgba(255,255,255,.20)';g.fillRect(0,0,c.width,12);
 g.fillStyle=trim;g.fillRect(0,0,c.width,17);g.fillRect(0,c.height-20,c.width,20);
 const rowH=(c.height-34)/Math.max(1,floors);
 for(let row=0;row<Math.max(1,floors);row++){
  const y=17+row*rowH;
  if(row>0){g.fillStyle=trim;g.fillRect(0,y-4,c.width,8);}
  if(kind==='fire'&&mainFace&&row===0){
   const bays=3,bw=170,gap=28,start=(c.width-(bays*bw+(bays-1)*gap))/2;
   for(let j=0;j<bays;j++){
    const x=start+j*(bw+gap);g.fillStyle='#252d33';g.fillRect(x,y+18,bw,rowH-36);
    g.strokeStyle=accent;g.lineWidth=10;g.strokeRect(x,y+18,bw,rowH-36);
    g.strokeStyle='#718087';g.lineWidth=3;
    for(let yy=y+36;yy<y+rowH-24;yy+=16){g.beginPath();g.moveTo(x+8,yy);g.lineTo(x+bw-8,yy);g.stroke();}
   }
  }else{
   const cols=kind==='market'?11:kind==='news'?10:kind==='government'?8:kind==='bank'?7:6;
   const gap=c.width/cols,ww=gap*(kind==='news'?.55:.48),wh=rowH*(kind==='market'?.38:.52);
   for(let j=0;j<cols;j++){
    const x=gap*j+(gap-ww)/2,wy=y+(rowH-wh)/2;
    if(kind==='transport'&&row===0){g.fillStyle='#273942';g.fillRect(x,wy,ww,wh);g.fillStyle=accent;g.fillRect(x,wy,ww,8);g.fillStyle='#b8d5df';g.fillRect(x+9,wy+10,Math.max(3,ww*.12),wh-20);}
    else{
     g.fillStyle=trim;g.fillRect(x-5,wy-5,ww+10,wh+10);
     g.fillStyle=kind==='news'?'#142a3a':kind==='bank'?'#173b4e':'#243d4a';g.fillRect(x,wy,ww,wh);
     g.fillStyle='rgba(203,235,245,.68)';g.fillRect(x+5,wy+4,Math.max(3,ww*.13),wh-8);
     g.fillStyle='rgba(246,249,248,.26)';g.fillRect(x,wy+wh*.72,ww,Math.max(2,wh*.035));
     if(kind==='school'&&row===0){g.fillStyle=accent;g.fillRect(x-5,wy+wh+7,ww+10,5);}
    }
   }
  }
  if(kind==='government'||kind==='police'||kind==='frsc'||kind==='army'){
   g.fillStyle=accent;g.fillRect(0,y+rowH-10,c.width,5);
  }
 }
 if(kind==='market'){
  g.fillStyle='#635647';g.fillRect(0,c.height-70,c.width,50);
  for(let x=22;x<c.width;x+=130){g.fillStyle='#e4c37a';g.fillRect(x,c.height-62,90,7);}
 }
 if(kind==='school'){g.fillStyle=accent;g.fillRect(0,c.height-34,c.width,8);}
 if(kind==='news'){g.fillStyle=accent;g.fillRect(0,0,18,c.height);g.fillRect(c.width-18,0,18,c.height);}
 if(kind==='fire'&&mainFace){g.fillStyle=accent;g.fillRect(0,0,c.width,16);}
 const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;t.anisotropy=4;return t;
}
function organizationBlockZ(x,frontZ,w,d,h,floors,palette,kind,doorWidth=0){
 const cz=frontZ-d/2;
 const wall=M(palette.wall),roof=M(palette.trim),frontTex=organizationFacadeTexture(palette,kind,floors,true),sideTex=organizationFacadeTexture(palette,kind,floors,false);
 const fm=new THREE.MeshLambertMaterial({map:frontTex,side:THREE.DoubleSide});
 const sm=new THREE.MeshLambertMaterial({map:sideTex,side:THREE.DoubleSide});
 const block=add(new THREE.BoxGeometry(w,h,d),[sm,sm,wall,wall,fm,sm],x,h/2,cz);
 if(doorWidth>0){const opening=Math.min(w-.8,doorWidth+.9),half=(w-opening)/4;
  boxes.push({x:x-w/2,z:cz,hw:.18,hd:d/2},{x:x+w/2,z:cz,hw:.18,hd:d/2},{x,z:frontZ-d,hw:w/2,hd:.18},
   {x:x-(opening/2+half),z:frontZ,hw:half,hd:.18},{x:x+(opening/2+half),z:frontZ,hw:half,hd:.18},
   {x,z:frontZ,hw:opening/2,hd:.18});
 }else boxes.push({x,z:cz,hw:w/2,hd:d/2,h});
 add(new THREE.BoxGeometry(w+.6,.3,d+.6),roof,x,h+.12,cz);
 add(new THREE.BoxGeometry(w+.6,.3,d+.6),roof,x,h+.12,cz);
 add(new THREE.BoxGeometry(w+.45,.34,.24),roof,x,h+.28,frontZ-.02);
 add(new THREE.BoxGeometry(.24,.34,d+.4),roof,x-w/2-.02,h+.28,cz);
 add(new THREE.BoxGeometry(.24,.34,d+.4),roof,x+w/2+.02,h+.28,cz);
 return {x,z:cz,frontZ,w,d,h,block};
}
function organizationBlockX(site,orientation,w,d,h,floors,palette,kind,doorWidth=0,doorZ=site.z){
 const isEast=orientation==='east';
 const faceX=isEast?site.x-2.05:site.x+2.05;
 const cx=isEast?faceX-w/2:faceX+w/2;
 const cz=isEast?site.z:site.z-d/2-2.0;
 const wall=M(palette.wall),roof=M(palette.trim),frontTex=organizationFacadeTexture(palette,kind,floors,true),sideTex=organizationFacadeTexture(palette,kind,floors,false);
 const fm=new THREE.MeshLambertMaterial({map:frontTex,side:THREE.DoubleSide});
 const sm=new THREE.MeshLambertMaterial({map:sideTex,side:THREE.DoubleSide});
 const materials=isEast?[fm,sm,wall,wall,sm,sm]:[sm,fm,wall,wall,sm,sm];
 const block=add(new THREE.BoxGeometry(w,h,d),materials,cx,h/2,cz);
 if(doorWidth>0){const sign=isEast?1:-1,opening=Math.min(d-.8,doorWidth+.9),zMin=cz-d/2,zMax=cz+d/2,start=Math.max(zMin,doorZ-opening/2),end=Math.min(zMax,doorZ+opening/2),left=Math.max(0,start-zMin),right=Math.max(0,zMax-end);
  boxes.push({x:cx-sign*w/2,z:cz,hw:.18,hd:d/2},{x:cx,z:zMin,hw:w/2,hd:.18},{x:cx,z:zMax,hw:w/2,hd:.18});
  if(left>.1)boxes.push({x:faceX,z:zMin+left/2,hw:.18,hd:left/2});
  if(right>.1)boxes.push({x:faceX,z:end+right/2,hw:.18,hd:right/2});
  boxes.push({x:faceX,z:(start+end)/2,hw:.18,hd:(end-start)/2});
 }else boxes.push({x:cx,z:cz,hw:w/2,hd:d/2,h});
 add(new THREE.BoxGeometry(w+.6,.3,d+.6),roof,cx,h+.12,cz);
 add(new THREE.BoxGeometry(w+.6,.3,d+.6),roof,cx,h+.12,cz);
 add(new THREE.BoxGeometry(.24,.34,d+.4),roof,faceX+(isEast?-.02:.02),h+.28,cz);
 return {x:cx,z:cz,faceX,faceZ:null,w,d,h,block,orientation,frontZ:cz+d/2};
}
function organizationSign(name,palette,w,h,x,y,z,rotationY,subtitle){
  const map=tex(1024,224,(g,W,H)=>{
   g.fillStyle='#'+Number(palette.trim).toString(16).padStart(6,'0');g.fillRect(0,0,W,H);
   g.fillStyle='#'+Number(palette.accent).toString(16).padStart(6,'0');g.fillRect(0,0,W,13);g.fillRect(0,H-13,W,13);
   g.strokeStyle='rgba(255,255,255,.7)';g.lineWidth=5;g.strokeRect(8,8,W-16,H-16);
   g.textAlign='center';g.fillStyle='#fff';g.font='bold 47px system-ui';g.fillText(name.toUpperCase(),W/2,84,W-38);
   g.fillStyle='#eaf7f4';g.font='bold 25px system-ui';g.fillText((subtitle||'MAIN ENTRANCE').toUpperCase(),W/2,157,W-38);
  });
  const board=new THREE.Group();board.position.set(x,y,z);board.rotation.y=rotationY||0;scene.add(board);
  const geo=new THREE.PlaneGeometry(w,h);
  const front=new THREE.Mesh(geo,new THREE.MeshBasicMaterial({map,side:THREE.FrontSide,fog:false}));front.position.z=.012;board.add(front);
  const back=new THREE.Mesh(makeReadableSignBackGeometry(geo),new THREE.MeshBasicMaterial({map,side:THREE.FrontSide,fog:false}));back.rotation.y=Math.PI;back.position.z=-.012;board.add(back);
  return board;
}
function organizationBox(w,h,d,x,y,z,color){
 return add(new THREE.BoxGeometry(w,h,d),M(color),x,y,z);
}
function organizationEntranceZ(site,palette,opts){
 const front=opts.frontZ,doorX=site.x+(opts.doorOffset||0),dw=opts.doorWidth||2.8,dh=opts.doorHeight||2.7;
 organizationBox(dw+.85,dh+.55,.20,doorX,dh/2,front+.20,palette.trim);
 organizationBox(dw,dh,.12,doorX,dh/2,front+.34,0x18242b);
 const leaves=Math.max(1,Math.floor(dw/1.25));
 for(let i=0;i<leaves;i++){
  const leafW=dw/leaves;
  organizationBox(leafW-.12,dh-.18,.05,doorX-dw/2+leafW*(i+.5),dh/2,front+.42,0x203b49);
  organizationBox(.055,.22,.07,doorX-dw/2+leafW*(i+.5)+leafW*.35,1.0,front+.47,0xe4c87e);
 }
 organizationBox(dw+5.2,.34,2.2,doorX,3.48,front+1.05,palette.trim);
 organizationBox(dw+5.5,.14,2.35,doorX,3.70,front+1.05,palette.accent);
 const columns=opts.columns===undefined?2:opts.columns;
 for(let i=0;i<columns;i++){
  const xx=doorX+(i-(columns-1)/2)*(dw+3)/(Math.max(1,columns-1));
  add(new THREE.CylinderGeometry(.19,.24,3.4,10),M(palette.trim),xx,1.75,front+.8);
  organizationBox(.58,.16,.58,xx,3.48,front+.8,palette.accent);
 }
 organizationBox(dw+4,.18,1.3,doorX,.12,front+1.0,palette.wall);
 organizationBox(dw+3,.16,.75,doorX,.30,front+1.0,palette.trim);
 const signY=opts.signY||Math.max(4.3,dh+1.1);
 organizationSign(site.name,palette,opts.signWidth||Math.min(12,Math.max(7,site.w*.65)),opts.signHeight||1.35,site.x,signY,front+.17,0,opts.subtitle||'MAIN ENTRANCE');
}
function organizationEntranceX(site,palette,opts){
 const isEast=opts.orientation==='east',faceX=isEast?site.x-2.05:site.x+2.05;
 const doorZ=opts.doorZ===undefined?site.z:opts.doorZ;
 const dw=opts.doorWidth||2.8,dh=opts.doorHeight||2.7;
 organizationBox(.20,dh+.55,dw+.85,faceX+(isEast?.20:-.20),dh/2,doorZ,palette.trim);
 organizationBox(.12,dh,dw,faceX+(isEast?.34:-.34),dh/2,doorZ,0x18242b);
 [-1,1].forEach(side=>{
  organizationBox(.05,dh-.18,(dw-.16)/2,faceX+(isEast?.42:-.42),dh/2,doorZ+side*dw*.24,0x203b49);
  organizationBox(.07,.22,.055,faceX+(isEast?.47:-.47),1.0,doorZ+side*.12,0xe4c87e);
 });
 organizationBox(2.2,.34,dw+5.2,faceX+(isEast?1.05:-1.05),3.48,doorZ,palette.trim);
 organizationBox(2.35,.14,dw+5.5,faceX+(isEast?1.05:-1.05),3.70,doorZ,palette.accent);
 const cols=[doorZ-(dw/2+1.25),doorZ+(dw/2+1.25)];
 cols.forEach(zz=>{add(new THREE.CylinderGeometry(.19,.24,3.4,10),M(palette.trim),faceX+(isEast?.8:-.8),1.75,zz);});
 organizationSign(site.name,palette,opts.signWidth||8.5,opts.signHeight||1.25,faceX+(isEast?.17:-.17),opts.signY||6.0,doorZ,Math.PI/2,opts.subtitle||'MAIN ENTRANCE');
 organizationBox(1.2,.14,dw+3,faceX+(isEast?.85:-.85),.12,doorZ,palette.wall);
 organizationBox(.75,.16,dw+2,faceX+(isEast?1.45:-1.45),.30,doorZ,palette.trim);
}
function buildSchool(site){
 const palette={wall:site.wall,trim:site.trim,accent:site.accent};
 const front=site.entryZ-2.05;
 const floors=site.id==='school-primary'?3:3;
 organizationBlockZ(site.x,front,site.w,site.d,site.h,floors,palette,'school',3.4);
 organizationEntranceZ({x:site.entryX,z:site.entryZ,w:site.w,h:site.h,name:site.name},palette,{
  frontZ:front,doorWidth:3.4,doorHeight:2.65,columns:4,signWidth:Math.min(15,site.w*.72),signHeight:1.4,signY:6.1,
  subtitle:site.id==='school-primary'?'PRIMARY EDUCATION • ADMINISTRATION':'SECONDARY EDUCATION • SCIENCE & ARTS'
 });
 /* School grounds include a covered assembly forecourt, a flagpole, and outdoor activity space. */
 flatW(5,40,asphalt2,site.entryX,.057,168,6);
 flatW(1.1,38,swm,site.entryX-3.1,.066,168,4);flatW(1.1,38,swm,site.entryX+3.1,.066,168,4);
 flatW(11,13,M(site.id==='school-primary'?0x76a74e:0x5d8f48),site.x+12,.058,site.entryZ+23,4);
 organizationBox(11,.16,13,site.x+12,.13,site.entryZ+23,site.trim);
 for(let j=0;j<3;j++)organizationBox(2.1,.15,.32,site.x+8+j*4,.35,site.entryZ+18,site.accent);
 flag(site.x-8,site.entryZ+8);
 const tank=add(new THREE.CylinderGeometry(.8,.8,1.7,12),M(0x4e6e80),site.x+site.w*.32,site.h+1.0,front-site.d+3);
 add(new THREE.CylinderGeometry(.84,.84,.14,12),M(site.accent),site.x+site.w*.32,site.h+1.88,front-site.d+3);
 addWorkplaceOccupantSign(site);
 POI.push({x:site.entryX,z:site.entryZ,k:'Work',name:site.name,t:'workplace',workplaceId:site.id,r:8});
}
HOSPITAL_SITES.forEach(buildHospital);
SCHOOL_SITES.forEach(buildSchool);
// Work-only interaction markers for the remaining already-catalogued careers/factions.
// These are POIs only: they do not move any road, roundabout, existing building, or house.
const OTHER_WORKPLACE_ENTRIES=[
 {id:'market-mile1',name:'Mile 1 Market',x:-60,z:40},
 {id:'bank-main',name:'Port Harcourt Bank',x:-10,z:-20,entryX:-12,entryZ:-20},
 {id:'park-main',name:'City Park',x:-30,z:20},
