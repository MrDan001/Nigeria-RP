/* Residential house renderer overrides.
 * This file replaces the functions used by createHouseExterior itself. It deliberately
 * does not create standalone meshes in the world, so there is no duplicate old/new overlay.
 */
const nrsHouseWindow = (K,x,y,z,w,h) => houseFrontWindow(K.A,K.m,x,y,z,w,h);
const nrsHouseDoor = (K,x,y,z,w,h,doubleDoor=false) => houseDoor(K.A,K.m,x,y,z,w,h,doubleDoor);

HOUSE_BUILDERS.hut = function(K) {
 const {A,m,S,B,C,w,d,H,front,Y}=K, bodyH=2.45;
 // Traditional Rivers village cottage: warm mud walls, deep thatch gable and shaded veranda.
 B(w-1.0,bodyH,d-1.05,m.wall,0,Y+bodyH/2,-.25);
 B(w+.25,.26,d+.25,m.trim,0,Y+.19,-.25);
 A(houseGable(w+1.25,d+1.1,1.45),S.thatch,0,Y+bodyH-.25,-.25);
 B(w+1.5,.14,.24,m.trim,0,Y+bodyH+.02,front+.2);
 nrsHouseDoor(K,0,Y+1.05,front+.08,1.0,2.05);
 [-1,1].forEach(s=>nrsHouseWindow(K,s*1.65,Y+1.42,front+.05,1.0,.9));
 // Timber porch roof, two posts and a simple bench.
 B(w*.76,.14,1.85,S.thatch,0,Y+2.55,front+1.0);
 [-1,1].forEach(s=>C(.09,.11,2.45,S.woodDark,s*1.72,Y+1.24,front+1.68,8));
 B(1.6,.3,.46,S.woodDark,0,Y+.43,front+1.35);
 B(1.8,.12,.5,S.woodLight,0,Y+.66,front+1.35);
 // Pots, firewood, water drum and a low woven boundary fence.
 [[-2.15,front+1.0,.23],[2.05,front+1.12,.2]].forEach(p=>{C(p[2],p[2]*.8,p[2]*1.7,S.clay,p[0],Y+p[2],p[1],10);});
 C(.34,.34,.85,S.blue,2.5,Y+.45,front+1.15,12);
 for(let i=0;i<9;i++)C(.025,.03,.72,m.trim,-2.0+i*.5,.42,front+4.45,5);
 B(4.5,.08,.08,m.trim,0,.82,front+4.45);
 B(5.5,.1,3.2,S.paver,0,.13,front+2.95);
 return {x:-2.6,y:Y+2.95,z:front+.5,w:3.3};
};

HOUSE_BUILDERS.faceme = function(K) {
 const {A,m,S,B,C,w,d,H,front,Y}=K;
 // Face-me-I-face-you compound: separate doors share an open courtyard and wash area.
 B(w,H,d,m.wall,0,Y+H/2,-.25);
 B(w+.35,.17,d+.35,m.trim,0,Y+H+.03,-.25);
 // Dividing pilasters give each room its own identity.
 [-3.5,0,3.5].forEach(x=>B(.16,H+.12,.18,m.accent,x,Y+H/2,front-.12));
 [-3.5,0,3.5].forEach((x,i)=>{
