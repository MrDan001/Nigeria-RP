 [-4.6,-2.3,0,2.3,4.6].forEach(x=>C(.07,.08,2.55,m.trim,x,Y+1.28,front+1.48,8));
 // Courtyard floor, washing basins, buckets, line and practical service corner.
 B(w-.3,.09,2.65,S.concrete,0,Y+.04,.15);
 B(1.7,.64,.72,S.stoneDk,-3.65,Y+.37,-.25);
 B(1.8,.09,.8,S.stone,-3.65,Y+.73,-.25);
 C(.18,.15,.32,S.blue,-4.15,Y+.3,-.85,10);C(.18,.15,.32,S.red,-3.68,Y+.3,-.85,10);
 [-1,1].forEach(s=>C(.04,.05,2.1,S.woodDark,s*1.7,Y+1.08,.1,6));
 B(3.5,.035,.035,S.white,0,Y+2.1,.1);
 for(let i=0;i<4;i++)B(.38,.52,.035,S.cloth[i],-1.1+i*.74,Y+1.8,.1);
 C(.34,.34,.9,S.blue,4.1,Y+.45,-.1,12);
 B(5.8,.08,2.9,S.paver,0,.12,front+2.55);
 return {x:-3.9,y:Y+3.15,z:front+.8,w:3.9};
};

