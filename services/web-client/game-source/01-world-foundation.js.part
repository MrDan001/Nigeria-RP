function houseAccessCorridorNear(x,z,m){
 return HOUSE_PLOTS.some(h=>{
  const front=h.cls==='hut'?h.w*.48:h.d/2,start=h.z+front+4.1;
  if(h.id.startsWith('hut-m1-'))return Math.abs(x-h.x)<.8+m&&z>=Math.min(start,95.5)-m&&z<=Math.max(start,95.5)+m;
  const street=LOCAL_ROADS.find(r=>r.axis==='h'&&r.zone===h.zone&&r.fixed>h.z);
  if(!street)return false;
  const end=street.fixed-street.width/2-1.105;
  return Math.abs(x-h.x)<1.45+m&&z>=Math.min(start,end)-m&&z<=Math.max(start,end)+m;
 })||(
  Math.abs(z-95.5)<.8+m&&x>=-85-m&&x<=-12+m
