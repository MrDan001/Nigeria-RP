function seedHouseExteriors(){
 // Defer decorative preview meshes until the login UI has had time to render.
 // Build a few per batch so lower-powered phones remain responsive.
 let index=0;
 const batch=()=>{
  const stop=Math.min(index+4,HOUSE_PLOTS.length);
  for(;index<stop;index++){
   const plot=HOUSE_PLOTS[index];
   if(HOUSE_VISUALS[plot.id])continue;
   createHouseExterior({...plot,name:HOUSE_LABELS[plot.cls]||"Home",rentPerDay:HOUSE_PREVIEW_RENT[plot.cls]||0,vacant:true,occupiedByMe:false,locked:false});
  }
  if(index<HOUSE_PLOTS.length)window.setTimeout(batch,32);
 };
 window.setTimeout(batch,1800);
}
