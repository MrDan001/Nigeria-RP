/* ---------- Port Harcourt street ---------- */
function add(g,m,x,y,z,p){const o=new THREE.Mesh(g,m);o.position.set(x,y,z);(p||scene).add(o);return o;}
/* Vehicles must remain readable against the road and must not disappear into world fog. */
function keepVehicleVisible(root){
 root.traverse(o=>{
  if(!o.isMesh)return;
  o.frustumCulled=false;
  const mats=Array.isArray(o.material)?o.material:[o.material];
  mats.forEach(mat=>{if(mat){mat.fog=false;mat.needsUpdate=true;}});
 });
}
const flat=(w,h,m,x,y,z)=>{const o=add(new THREE.PlaneGeometry(w,h),m,x,y,z);o.rotation.x=-Math.PI/2;return o;};
const arterialTexture=tex(256,256,(g,w,h)=>{g.fillStyle="#373b3e";g.fillRect(0,0,w,h);for(let i=0;i<2300;i++){const v=28+Math.floor(Math.random()*55);g.fillStyle="rgba("+v+","+v+","+v+",.42)";g.fillRect(Math.random()*w,Math.random()*h,1+Math.random()*2,1+Math.random()*2);}},70,70);
const arterial=new THREE.MeshLambertMaterial({map:arterialTexture,color:0xb0b0b0});
const pavementTexture=tex(256,256,(g,w,h)=>{g.fillStyle="#aaa69d";g.fillRect(0,0,w,h);for(let y=0;y<h;y+=64)for(let x=0;x<w;x+=64){g.strokeStyle="rgba(55,55,50,.25)";g.lineWidth=2;g.strokeRect(x+1,y+1,62,62);}for(let i=0;i<600;i++){const v=80+Math.floor(Math.random()*120);g.fillStyle="rgba("+v+","+v+","+v+",.12)";g.fillRect(Math.random()*w,Math.random()*h,2,2);}},4,80);
const pavement=new THREE.MeshLambertMaterial({map:pavementTexture});
/* ---------- Streetworks v2 toolkit: realistic asphalt + merged geometry helpers ---------- */
const asphaltTex=tex(512,512,(g,w,h)=>{
 let s=1234567;const r=()=>(s=(s*16807)%2147483647)/2147483647;
 g.fillStyle='#585b5e';g.fillRect(0,0,w,h);
 for(let i=0;i<16;i++){const x=70+r()*372,y=70+r()*372,rad=30+r()*60,v=r()<.5?25:95,gr=g.createRadialGradient(x,y,2,x,y,rad);gr.addColorStop(0,'rgba('+v+','+v+','+(v+4)+',.09)');gr.addColorStop(1,'rgba('+v+','+v+','+(v+4)+',0)');g.fillStyle=gr;g.fillRect(x-rad,y-rad,rad*2,rad*2);}
 for(let i=0;i<9000;i++){const v=45+Math.floor(r()*80);g.fillStyle='rgba('+v+','+v+','+(v+3)+','+(.25+r()*.4)+')';g.fillRect(r()*w,r()*h,1+(r()<.25?1:0),1);}
 for(let i=0;i<650;i++){const v=120+Math.floor(r()*80);g.fillStyle='rgba('+v+','+v+','+v+','+(.16+r()*.25)+')';g.fillRect(r()*w,r()*h,2,2);}
 g.lineWidth=1.2;
 for(let i=0;i<7;i++){g.strokeStyle='rgba(14,15,16,'+(.22+r()*.2)+')';g.beginPath();let x=50+r()*410,y=50+r()*410;g.moveTo(x,y);for(let k=0;k<9;k++){x=Math.max(8,Math.min(w-8,x+(r()-.5)*46));y=Math.max(8,Math.min(h-8,y+(r()-.3)*38));g.lineTo(x,y);}g.stroke();}
 for(let i=0;i<3;i++){const x=60+r()*300,y=60+r()*300,pw=50+r()*80,ph=40+r()*70;g.fillStyle='rgba(20,21,22,.10)';g.fillRect(x,y,pw,ph);g.strokeStyle='rgba(10,10,11,.16)';g.lineWidth=1.5;g.strokeRect(x,y,pw,ph);}
});
asphaltTex.wrapS=asphaltTex.wrapT=THREE.RepeatWrapping;asphaltTex.anisotropy=4;
const asphalt2=new THREE.MeshLambertMaterial({map:asphaltTex,color:0xb8b8b8});
/* flat plane whose texture is mapped in world metres (no stretching on long roads) */
const flatW=(w,h,m,x,y,z,tile)=>{const o=flat(w,h,m,x,y,z),uv=o.geometry.attributes.uv;for(let i=0;i<uv.count;i++)uv.setXY(i,uv.getX(i)*w/tile,uv.getY(i)*h/tile);uv.needsUpdate=true;return o;};
const discW=(r,m,x,y,z,tile)=>{const o=add(new THREE.CircleGeometry(r,64),m,x,y,z),uv=o.geometry.attributes.uv;o.rotation.x=-Math.PI/2;for(let i=0;i<uv.count;i++)uv.setXY(i,uv.getX(i)*2*r/tile,uv.getY(i)*2*r/tile);uv.needsUpdate=true;return o;};

const SW=(()=>{
 const batches=[];
 const L=c=>new THREE.MeshLambertMaterial({color:c});
 const offs=(m,f,u)=>{m.polygonOffset=true;m.polygonOffsetFactor=f;m.polygonOffsetUnits=u;return m;};
 const B=m=>{const b={m,p:[],n:[]};batches.push(b);return b;};
 const tri=(b,a,c,d,nx,ny,nz)=>{b.p.push(a[0],a[1],a[2],c[0],c[1],c[2],d[0],d[1],d[2]);b.n.push(nx,ny,nz,nx,ny,nz,nx,ny,nz);};
 /* four corners, counter-clockwise seen from the visible side */
 const quad=(b,p0,p1,p2,p3)=>{const e=[p1[0]-p0[0],p1[1]-p0[1],p1[2]-p0[2]],f=[p2[0]-p0[0],p2[1]-p0[1],p2[2]-p0[2]];let nx=e[1]*f[2]-e[2]*f[1],ny=e[2]*f[0]-e[0]*f[2],nz=e[0]*f[1]-e[1]*f[0];const l=Math.hypot(nx,ny,nz);if(l<1e-9)return;nx/=l;ny/=l;nz/=l;tri(b,p0,p1,p2,nx,ny,nz);tri(b,p0,p2,p3,nx,ny,nz);};
 /* flat polygon on the ground plane, always facing up whatever the point order */
 const fq=(b,pts,y)=>{let s=0;for(let i=0;i<pts.length;i++){const a=pts[i],c=pts[(i+1)%pts.length];s+=a[0]*c[1]-c[0]*a[1];}const P=s<0?pts:pts.slice().reverse();for(let i=1;i<P.length-1;i++)tri(b,[P[0][0],y,P[0][1]],[P[i][0],y,P[i][1]],[P[i+1][0],y,P[i+1][1]],0,1,0);};
 const rc=(b,x0,z0,x1,z1,y)=>fq(b,[[x0,z0],[x1,z0],[x1,z1],[x0,z1]],y);
 const bx=(b,x0,y0,z0,x1,y1,z1)=>{let t;if(x0>x1){t=x0;x0=x1;x1=t;}if(y0>y1){t=y0;y0=y1;y1=t;}if(z0>z1){t=z0;z0=z1;z1=t;}
  quad(b,[x0,y1,z0],[x0,y1,z1],[x1,y1,z1],[x1,y1,z0]);
  quad(b,[x1,y0,z1],[x1,y0,z0],[x1,y1,z0],[x1,y1,z1]);
  quad(b,[x0,y0,z0],[x0,y0,z1],[x0,y1,z1],[x0,y1,z0]);
  quad(b,[x0,y0,z1],[x1,y0,z1],[x1,y1,z1],[x0,y1,z1]);
  quad(b,[x1,y0,z0],[x0,y0,z0],[x0,y1,z0],[x1,y1,z0]);};
 /* convex polygon slab (splitter islands etc.) */
 const prism=(b,pts,y0,y1,top)=>{let s=0;for(let i=0;i<pts.length;i++){const a=pts[i],c=pts[(i+1)%pts.length];s+=a[0]*c[1]-c[0]*a[1];}const P=s<0?pts:pts.slice().reverse();fq(top||b,P,y1);for(let i=0;i<P.length;i++){const a=P[i],c=P[(i+1)%P.length];quad(b,[a[0],y0,a[1]],[c[0],y0,c[1]],[c[0],y1,c[1]],[a[0],y1,a[1]]);}};
 /* curved wall segment of a circle, angle measured from +x towards +z */
 const wall=(b,cx,cz,r,a0,a1,y0,y1,out)=>{const A=[cx+r*Math.cos(a0),cz+r*Math.sin(a0)],C=[cx+r*Math.cos(a1),cz+r*Math.sin(a1)];
  if(out)quad(b,[C[0],y0,C[1]],[A[0],y0,A[1]],[A[0],y1,A[1]],[C[0],y1,C[1]]);else quad(b,[A[0],y0,A[1]],[C[0],y0,C[1]],[C[0],y1,C[1]],[A[0],y1,A[1]]);};
 /* upright cylinder with a flat top */
 const cyl=(b,cx,cz,r,y0,y1,n)=>{const pts=[];for(let i=0;i<n;i++){const a=i*Math.PI*2/n;pts.push([cx+r*Math.cos(a),cz+r*Math.sin(a)]);wall(b,cx,cz,r,a,(i+1)*Math.PI*2/n,y0,y1,true);}fq(b,pts,y1);};
 const flush=()=>{batches.forEach(b=>{if(!b.p.length)return;const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(b.p,3));g.setAttribute('normal',new THREE.Float32BufferAttribute(b.n,3));scene.add(new THREE.Mesh(g,b.m));b.p=[];b.n=[];});};
 /* instanced copies (bushes, lamp parts) */
 const inst=(geo,mat,list)=>{if(!list.length)return null;const im=new THREE.InstancedMesh(geo,mat,list.length),m4=new THREE.Matrix4(),q=new THREE.Quaternion(),sc=new THREE.Vector3(),ps=new THREE.Vector3(),up=new THREE.Vector3(0,1,0);
  list.forEach((o,i)=>{ps.set(o.x,o.y,o.z);q.setFromAxisAngle(up,o.r||0);sc.set(o.sx||1,o.sy||1,o.sz||1);m4.compose(ps,q,sc);im.setMatrixAt(i,m4);});
  im.instanceMatrix.needsUpdate=true;im.frustumCulled=false;scene.add(im);return im;};
 return {L,offs,B,quad,fq,rc,bx,prism,wall,cyl,flush,inst};
})();
flat(500,500,M(0x5d7a45),0,0,0);flatW(10,500,asphalt2,0,.03,0,8);
[-6.5,6.5].forEach(x=>flat(3,500,pavement,x,.04,0));
const boxes=[],bld=[];

// Keep these coordinates in sync with services/game-server/src/stage5.ts.
// Access is personalised client-side for collision feel, then enforced again by the server.
const PARK_GATE_BOUNDS={minX:-34,maxX:-10,minZ:23,maxZ:41,gateX:-30,gateZ:23,gateWidth:4.5,approachX:-30,approachZ:21.5};
const PARK_GATE_VISUALS=[];
function hasParkGateAccessClient(){
 const n=window.NRS||{};
 const pass=n.parkState?.ticket;
 const today=n.today||n.parkState?.today;
 if(pass?.dayKey && (!today || pass.dayKey===today))return true;
 const parkState=n.parkState||{};
 if(parkState.workplaceId==='park-main'&&Number(parkState.rank)>=1&&Number(parkState.rank)<=6&&parkState.onDuty===true&&parkState.uniform===true)return true;
 const employment=n.life?.employment||{};
 return employment.workplaceId==='park-main'&&employment.onDuty===true&&employment.uniformWorkplaceId==='park-main';
}
function updateParkGateVisual(){
 const open=hasParkGateAccessClient();
 for(const leaf of PARK_GATE_VISUALS)leaf.visible=!open;
}
window.addEventListener('nrs-park-state',updateParkGateVisual);
window.addEventListener('nrs-workplaces',updateParkGateVisual);
window.addEventListener('nrs-life',updateParkGateVisual);

function apartmentRoadSegments(){
 const roads=[];
 HR.forEach(r=>roads.push({axis:'h',fixed:r[0],lo:r[2],hi:r[3],half:5,id:r[1],main:true}));
 VR.forEach(r=>roads.push({axis:'v',fixed:r[0],lo:r[2],hi:r[3],half:5,id:r[1],main:true}));
 LOCAL_ROADS.forEach(r=>roads.push({axis:r.axis,fixed:r.fixed,lo:r.lo,hi:r.hi,half:r.width/2,id:r.id,main:false}));
 return roads;
}
function apartmentApproachBlocked(b,road,entry,roadEdge){
 const halfLane=1.6;
 const minX=road.axis==='h'?b.x-halfLane:Math.min(entry,roadEdge);
 const maxX=road.axis==='h'?b.x+halfLane:Math.max(entry,roadEdge);
 const minZ=road.axis==='h'?Math.min(entry,roadEdge):b.z-halfLane;
 const maxZ=road.axis==='h'?Math.max(entry,roadEdge):b.z+halfLane;
 for(const other of bld){
  if(other===b||(!other.gen&&!other.apartmentCandidate)||!Number.isFinite(Number(other.hw))||!Number.isFinite(Number(other.hd)))continue;
  if(minX<Number(other.x)+other.hw+.45&&maxX>Number(other.x)-other.hw-.45&&
     minZ<Number(other.z)+other.hd+.45&&maxZ>Number(other.z)-other.hd-.45)return true;
 }
 for(const home of HOUSE_PLOTS){
  const hw=Number(home.w)/2,hd=Number(home.d)/2;
  if(!Number.isFinite(hw)||!Number.isFinite(hd))continue;
  if(minX<Number(home.x)+hw+1&&maxX>Number(home.x)-hw-1&&
     minZ<Number(home.z)+hd+1&&maxZ>Number(home.z)-hd-1)return true;
 }
 return false;
}
function chooseApartmentEntrance(x,z,w,d,preferredAxis=null,preferredSign=null){
 const roads=apartmentRoadSegments(),candidates=[];
 for(const road of roads){
  const axis=road.axis==='h'?'z':'x';
  if(preferredAxis&&axis!==preferredAxis)continue;
  const center=road.axis==='h'?x:z;
  if(center<road.lo||center>road.hi)continue;
  const from=road.axis==='h'?z:x,extent=road.axis==='h'?d/2:w/2;
  const sign=Math.sign(road.fixed-from)||1;
  if(preferredSign!==null&&sign!==preferredSign)continue;
  const entry=from+sign*(extent+1.45),roadEdge=road.fixed-sign*road.half;
  const distance=Math.abs(roadEdge-entry);
  candidates.push({axis,sign,accessRoad:road,distance,blocked:apartmentApproachBlocked({x,z,hw:w/2,hd:d/2},road,entry,roadEdge)});
 }
 candidates.sort((a,b)=>Number(a.blocked)-Number(b.blocked)||a.distance-b.distance||Number(Boolean(b.accessRoad.main))-Number(Boolean(a.accessRoad.main)));
 if(candidates.length)return candidates[0];
 if(preferredAxis&&preferredSign!==null)return chooseApartmentEntrance(x,z,w,d,preferredAxis,null);
 if(preferredAxis)return chooseApartmentEntrance(x,z,w,d,null,preferredSign);
 return {axis:'z',sign:1,accessRoad:null,distance:Infinity,blocked:true};
}
function pushApartmentBuildingColliders(b){
 const {x,z,hw,hd}=b,gap=3.0;
 if(b.entryAxis==='x'){
  const sign=b.entrySign||1,face=x+sign*hw,other=x-sign*hw,half=Math.max(.25,(hd-gap/2)/2);
  boxes.push({x:other,z,hw:.16,hd},{x,z:z-hd,hw,hd:.16},{x,z:z+hd,hw,hd:.16},
   {x:face,z:z-(gap/2+half),hw:.16,hd:half},{x:face,z:z+(gap/2+half),hw:.16,hd:half},
   {x:face,z,hw:.16,hd:gap/2});
 }else{
  const sign=b.entrySign||1,face=z+sign*hd,other=z-sign*hd,half=Math.max(.25,(hw-gap/2)/2);
  boxes.push({x:x-hw,z,hw:.16,hd},{x:x+hw,z,hw:.16,hd},{x,z:other,hw,hd:.16},
   {x:x-(gap/2+half),z:face,hw:half,hd:.16},{x:x+(gap/2+half),z:face,hw:half,hd:.16},
   {x,z:face,hw:gap/2,hd:.16});
 }
}

const HOUSE_SIZES={hut:{w:5.6,d:6.2,h:2.65},faceme:{w:10.5,d:8.5,h:2.9},flat:{w:11.5,d:10,h:6.3},estate:{w:14,d:11.5,h:3.7},mansion:{w:17,d:14,h:6.2},palace:{w:21,d:17,h:7.2},grand:{w:26,d:22,h:8.5}};
const HOUSE_ZONE_BOUNDS={"Mile 1 Market":[-85,-12,78,112],"D-Line":[24,85,-100,-14],"Old GRA":[-240,-100,-240,-120],"Trans Amadi":[100,240,-240,-120],"Rumuola":[100,240,-100,60],"Waterlines":[-240,240,115,200]};
const HOUSE_PLANS=[{cls:"hut",zone:"Mile 1 Market",count:4,tag:"m1"},{cls:"hut",zone:"Rumuola",count:4,tag:"rum"},{cls:"faceme",zone:"Mile 1 Market",count:3,tag:"m1"},{cls:"faceme",zone:"Rumuola",count:6,tag:"rum"},{cls:"flat",zone:"D-Line",count:3,tag:"dl"},{cls:"flat",zone:"Waterlines",count:4,tag:"wl"},{cls:"estate",zone:"Trans Amadi",count:4,tag:"ta"},{cls:"grand",zone:"Trans Amadi",count:1,tag:"ta"},{cls:"mansion",zone:"Old GRA",count:3,tag:"gra"},{cls:"palace",zone:"Old GRA",count:2,tag:"gra"}];
const HOUSE_LAYOUT_OVERRIDES={"estate-ta-01":{x:128,z:-228},"estate-ta-02":{x:156,z:-228},"estate-ta-03":{x:184,z:-228},"estate-ta-04":{x:212,z:-228},"grand-ta-01":{x:220,z:-148},"palace-gra-01":{x:-228,z:-228},"mansion-gra-01":{x:-200,z:-228},"palace-gra-02":{x:-172,z:-228},"mansion-gra-02":{x:-144,z:-228},"mansion-gra-03":{x:-117,z:-228},"hut-m1-01":{x:-70,z:87},"hut-m1-02":{x:-56,z:87},"hut-m1-03":{x:-41,z:87},"hut-m1-04":{x:-27,z:87},"faceme-m1-01":{x:-67,z:101},"faceme-m1-02":{x:-48,z:101},"faceme-m1-03":{x:-30,z:101},"hut-rum-01":{x:128,z:-60},"hut-rum-02":{x:156,z:-60},"hut-rum-03":{x:184,z:-60},"hut-rum-04":{x:212,z:-60},"faceme-rum-01":{x:135,z:-34},"faceme-rum-02":{x:170,z:-34},"faceme-rum-03":{x:205,z:-34},"faceme-rum-04":{x:135,z:-8},"faceme-rum-05":{x:170,z:-8},"faceme-rum-06":{x:205,z:-8}};
function buildHousePlots(){const out=[],seen={};HOUSE_PLANS.forEach(p=>{const b=HOUSE_ZONE_BOUNDS[p.zone],sz=HOUSE_SIZES[p.cls];for(let i=0;i<p.count;i++){const key=p.cls+"-"+p.tag,n=(seen[key]=(seen[key]||0)+1),id=key+"-"+String(n).padStart(2,"0"),t=(i+1)/(p.count+1),override=HOUSE_LAYOUT_OVERRIDES[id];out.push({id,cls:p.cls,zone:p.zone,x:override?.x??Math.round(b[0]+(b[1]-b[0])*t),z:override?.z??Math.round(b[2]+(b[3]-b[2])*(.3+.4*t)),w:sz.w,d:sz.d});}});return out;}
const HOUSE_PLOTS=buildHousePlots();

const winTex=(base,lit,rx,ry)=>tex(256,512,(g,w,h)=>{
 // One complete storey per texture tile: repeat count follows the actual building height,
 // so high-rises get plausible floor counts instead of a wall covered in tiny random squares.
 g.fillStyle=base;g.fillRect(0,0,w,h);

 for(let i=0;i<900;i++){const a=Math.random()*.055,v=Math.random()>.55?255:0;g.fillStyle='rgba('+v+','+v+','+v+','+a+')';g.fillRect(Math.random()*w,Math.random()*h,1+Math.random()*4,2+Math.random()*7);}
 g.fillStyle='rgba(20,24,26,.14)';g.fillRect(0,0,w,34);g.fillRect(0,h-31,w,31);
 g.fillStyle='rgba(245,239,221,.46)';g.fillRect(0,28,w,7);g.fillRect(0,h-31,w,7);
 g.fillStyle='rgba(35,39,42,.24)';for(let x=5;x<w;x+=64)g.fillRect(x,0,3,h);
 for(let x=13;x<w-35;x+=58){
  const ww=35,wh=155,y=148+Math.floor(Math.random()*22);
  // Recess shadow, pale concrete surround, dark glazing and a top highlight.
  g.fillStyle='rgba(25,30,33,.48)';g.fillRect(x-4,y-4,ww+8,wh+9);
  g.fillStyle='rgba(225,217,201,.96)';g.fillRect(x-3,y-3,ww+6,wh+6);
  const grad=g.createLinearGradient(x,y,x+ww,y+wh);grad.addColorStop(0,'#6e8d9a');grad.addColorStop(.45,Math.random()<lit?'#f9dc9a':'#314550');grad.addColorStop(1,'#1d303a');
  g.fillStyle=grad;g.fillRect(x,y,ww,wh);
  g.fillStyle='rgba(241,249,251,.34)';g.fillRect(x+4,y+5,4,wh-10);
  g.fillStyle='rgba(20,27,31,.75)';g.fillRect(x+ww*.49,y,2,wh);
  g.fillRect(x,y+wh*.58,ww,3);
  g.fillStyle='rgba(238,231,213,.95)';g.fillRect(x-7,y+wh+3,ww+14,7);g.fillRect(x-5,y-8,ww+10,5);
  // Balconies and AC units share a facade bay without overlapping each other.
  const balcony=Math.random()<.23;
  if(balcony){
   const by=y+wh+14;g.fillStyle='#777d7c';g.fillRect(x-7,by,ww+14,4);
   g.fillStyle='#d4d1c7';g.fillRect(x-7,by+4,ww+14,3);
   for(let bx=x-4;bx<x+ww+7;bx+=7)g.fillRect(bx,by+3,2,16);
   g.fillRect(x-7,by+17,ww+14,4);
  }
  // Exterior AC condenser below selected windows, common on Nigerian apartment blocks.
  if(!balcony&&Math.random()<.18){
   const ay=y+wh+30;g.fillStyle='#777d7d';g.fillRect(x+ww*.25,ay,ww*.5,18);
   g.fillStyle='#252c30';g.fillRect(x+ww*.31,ay+4,ww*.38,9);
   g.fillStyle='#b4b6b0';g.fillRect(x+ww*.22,ay-3,ww*.56,3);
  }
 }
 // Low-profile water marks and a simple cornice edge.
 g.fillStyle='rgba(42,41,35,.09)';for(let i=0;i<9;i++){const x=Math.floor(Math.random()*w),y=40+Math.floor(Math.random()*(h-80));g.fillRect(x,y,1+Math.random()*3,12+Math.random()*48);}
 g.fillStyle='rgba(245,240,225,.38)';g.fillRect(0,40,w,3);g.fillRect(0,h-40,w,3);
},rx,ry);
function building(x,z,w,d,h,col,side,lit,doorWidth=3.2,doorAxis='x',residentialCandidate=false){const pl=M(col),fr=new THREE.MeshLambertMaterial({map:winTex('#'+col.toString(16).padStart(6,'0'),lit,Math.max(1,Math.round(d/8)),Math.max(1,Math.round(h/7)))});
 const m=[pl,pl,pl,pl,pl,pl];m[side<0?0:1]=fr;add(new THREE.BoxGeometry(w,h,d),m,x,h/2,z);
 const entrySign=doorAxis==='x'?(side<0?1:-1):1;
 const b={x,z,hw:w/2,hd:d/2,h,c:col,apartmentCandidate:residentialCandidate===true,
  entryAxis:doorAxis,entrySign,
  entryX:doorAxis==='x'?x+entrySign*w/2+entrySign*1.45:x,
  entryZ:doorAxis==='z'?z+d/2+1.45:z};
 if(doorAxis==='x'&&doorWidth>0){const sign=side<0?1:-1,faceX=x+sign*w/2,opening=Math.min(d-.8,doorWidth+.9),half=(d-opening)/4;
  boxes.push({x:x-sign*w/2,z,hw:.16,hd:d/2},{x,z:z-d/2,hw:w/2,hd:.16},{x,z:z+d/2,hw:w/2,hd:.16},
   {x:faceX,z:z-(opening/2+half),hw:.16,hd:half},{x:faceX,z:z+(opening/2+half),hw:.16,hd:half},
   {x:faceX,z,hw:.16,hd:opening/2});
 }else if(doorAxis==='z'&&doorWidth>0){const opening=Math.min(w-.8,doorWidth+.9),half=(w-opening)/4,frontZ=z+d/2;
  boxes.push({x:x-w/2,z,hw:.16,hd:d/2},{x:x+w/2,z,hw:.16,hd:d/2},{x,z:z-d/2,hw:w/2,hd:.16},
   {x:x-(opening/2+half),z:frontZ,hw:half,hd:.16},{x:x+(opening/2+half),z:frontZ,hw:half,hd:.16},
   {x,z:frontZ,hw:opening/2,hd:.16});
 }else boxes.push(b);
 bld.push(b);}
[[-17,6,12,14,6,0xb08a6a,-1,.2],[-17,32,12,16,11,0xc9ccd0,-1,.4],[-17,-52,12,18,14,0xd8d2c0,-1,.35],
 [17,2,12,14,9,0x9fb4c8,1,.4],[17,28,12,14,6,0xd6d0c4,1,.2],
 [-30,-90,16,16,34,0x8aa0b4,-1,.5],[30,-96,16,16,42,0x7f95aa,1,.5]].forEach((a,i)=>building(...a,3.2,'x',i>=5));

/* Residential exteriors are actual multi-part buildings, sized to each rental class. */
const HOUSE_VISUALS=Object.create(null),HOUSE_MATERIALS=Object.create(null);
/* ---------- NRS Homes: six redesigned house types (names, materials, shared helpers) ---------- */
const HOUSE_LABELS={hut:"VILLAGE HUT",faceme:"COMPOUND ROOMS",flat:"URBAN FLAT",estate:"ESTATE DUPLEX",mansion:"GRAND VILLA",palace:"ROYAL PALACE",grand:"GRAND BUILDING"};
const HOUSE_PALETTE={
 hut:{wall:0xb9946a,trim:0x5a3d26,roof:0x87603a,door:0x4a2f1c,accent:0xc9803f},
 faceme:{wall:0xeadfc2,trim:0x2c6aa0,roof:0x8b3c2d,door:0x2c6aa0,accent:0xd8602b},
 flat:{wall:0xe9e7e0,trim:0x3a4448,roof:0x353b3e,door:0x2b3b40,accent:0x1f8a8a},
 estate:{wall:0xf3f0e9,trim:0x2d3236,roof:0x4a4f52,door:0x3a2a20,accent:0x9a6b3f},
 mansion:{wall:0xf1e5ca,trim:0xfbf6ea,roof:0xa5512f,door:0x3b2416,accent:0xb8955a},
 palace:{wall:0xf4ecd8,trim:0xfffaf0,roof:0x2f7d6b,door:0x2b1a12,accent:0xd8b04a},
 grand:{wall:0xf5f4ee,trim:0x2d343a,roof:0x202931,door:0x111c24,accent:0x21b7c6}
};
const HSH={};
function houseShared(){
 if(HSH.ok)return HSH;
 const T=(w,h,fn,rx,ry)=>{const t=tex(w,h,fn);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(rx||1,ry||1);t.anisotropy=4;return t;};
 const L=c=>new THREE.MeshLambertMaterial({color:c});
 HSH.thatch=new THREE.MeshLambertMaterial({map:T(256,256,(g,w,h)=>{g.fillStyle='#b8974f';g.fillRect(0,0,w,h);for(let i=0;i<1500;i++){const x=Math.random()*w,y=Math.random()*h;g.strokeStyle=Math.random()<.5?'rgba(120,88,40,.55)':'rgba(236,208,128,.5)';g.lineWidth=1;g.beginPath();g.moveTo(x,y);g.lineTo(x+(Math.random()-.5)*4,y+10+Math.random()*16);g.stroke();}for(let y=0;y<h;y+=32){g.fillStyle='rgba(70,48,20,.3)';g.fillRect(0,y,w,3);}},7,3)});
 HSH.zinc=new THREE.MeshLambertMaterial({map:T(256,256,(g,w,h)=>{g.fillStyle='#98a2a5';g.fillRect(0,0,w,h);for(let x=0;x<w;x+=16){const gr=g.createLinearGradient(x,0,x+16,0);gr.addColorStop(0,'rgba(255,255,255,.28)');gr.addColorStop(.5,'rgba(0,0,0,.18)');gr.addColorStop(1,'rgba(255,255,255,.28)');g.fillStyle=gr;g.fillRect(x,0,16,h);}for(let i=0;i<26;i++){g.fillStyle='rgba(138,76,40,'+(.1+Math.random()*.2)+')';g.fillRect(Math.random()*w,Math.random()*h,6+Math.random()*30,4+Math.random()*26);}},5,2)});
 HSH.stone=new THREE.MeshLambertMaterial({map:T(256,256,(g,w,h)=>{g.fillStyle='#e6dcc4';g.fillRect(0,0,w,h);for(let y=0;y<h;y+=32){g.fillStyle='rgba(120,106,80,.32)';g.fillRect(0,y,w,2);for(let x=(y/32%2)*32;x<w;x+=64){g.fillRect(x,y,2,32);}}for(let i=0;i<500;i++){g.fillStyle='rgba(90,80,60,'+Math.random()*.08+')';g.fillRect(Math.random()*w,Math.random()*h,2,2);}},2,2)});
 HSH.paver=new THREE.MeshLambertMaterial({map:T(256,256,(g,w,h)=>{g.fillStyle='#a56d4a';g.fillRect(0,0,w,h);for(let y=0;y<h;y+=32)for(let x=(y/32%2)*32;x<w;x+=64){const v=Math.floor(Math.random()*30);g.fillStyle='rgb('+(165+v)+','+(105+v)+','+(74+v)+')';g.fillRect(x+1,y+1,62,30);}},3,3)});
 HSH.brick=new THREE.MeshLambertMaterial({map:T(256,256,(g,w,h)=>{g.fillStyle='#c9bfae';g.fillRect(0,0,w,h);for(let y=0;y<h;y+=16)for(let x=(y/16%2)*16;x<w;x+=32){const v=Math.floor(Math.random()*26);g.fillStyle='rgb('+(176+v)+','+(84+v)+','+(58+v)+')';g.fillRect(x+1,y+1,30,14);}},3,3)});
 HSH.water=new THREE.MeshPhongMaterial({color:0x3b92bd,shininess:90,transparent:true,opacity:.9});
 HSH.glassRail=new THREE.MeshPhongMaterial({color:0x9fd4e0,transparent:true,opacity:.35,shininess:90,side:THREE.DoubleSide});
 HSH.glassBlock=new THREE.MeshPhongMaterial({color:0x8fc7d6,transparent:true,opacity:.7,shininess:60});
 HSH.mud=L(0xa07e56);HSH.ochre=L(0xc98a45);HSH.clay=L(0xb5532e);HSH.black=L(0x14161a);HSH.steel=L(0x4a5156);HSH.white=L(0xf7f3ea);
 HSH.woodDark=L(0x5b3b22);HSH.woodLight=L(0xa9743f);HSH.leaf=L(0x2f7a3a);HSH.leaf2=L(0x3f9446);HSH.blue=L(0x2f6fb0);HSH.red=L(0xc9402f);
 HSH.yellow=L(0xe4b73a);HSH.flagG=L(0x0b8f4a);HSH.flagW=L(0xf4f4f0);HSH.goldB=L(0xe0b84a);HSH.copper=L(0x3f8f7a);HSH.stoneDk=L(0xa89f88);
 HSH.glow=new THREE.MeshBasicMaterial({color:0xffe2a0});HSH.cloth=[L(0xd8392f),L(0xf0c53a),L(0x3b86c9),L(0xf4f4f0)];
 HSH.ok=true;return HSH;
}
function houseMats(cls){
 if(HOUSE_MATERIALS[cls])return HOUSE_MATERIALS[cls];
 const p=HOUSE_PALETTE[cls]||HOUSE_PALETTE.flat;
 const wallMap=tex(256,256,(g,w,h)=>{g.fillStyle="#"+p.wall.toString(16).padStart(6,"0");g.fillRect(0,0,w,h);
  for(let i=0;i<1800;i++){const a=Math.random()*.1,v=Math.random()>.5?255:20;g.fillStyle="rgba("+v+","+v+","+v+","+a+")";g.fillRect(Math.random()*w,Math.random()*h,1+Math.random()*3,1+Math.random()*3);}
  if(["flat","estate","mansion","palace"].includes(cls)){for(let y=0;y<h;y+=64){g.fillStyle="rgba(60,53,43,.10)";g.fillRect(0,y,w,2);}}
  if(cls==="hut"){for(let i=0;i<40;i++){g.fillStyle="rgba(90,60,30,"+(.05+Math.random()*.08)+")";g.fillRect(Math.random()*w,Math.random()*h,10+Math.random()*30,3+Math.random()*10);}}
 });
 const roofMap=tex(256,256,(g,w,h)=>{g.fillStyle="#"+p.roof.toString(16).padStart(6,"0");g.fillRect(0,0,w,h);for(let y=0;y<h;y+=17){g.fillStyle="rgba(225,217,199,.13)";g.fillRect(0,y,w,1);for(let x=(y/17%2)*14;x<w;x+=28){g.strokeStyle="rgba(0,0,0,.32)";g.beginPath();g.moveTo(x,y);g.lineTo(x+13,y+17);g.stroke();}}});
 const sh=houseShared();
 return HOUSE_MATERIALS[cls]=Object.assign({},sh,{
  wall:new THREE.MeshLambertMaterial({map:wallMap}),roof:new THREE.MeshLambertMaterial({map:roofMap}),
  trim:M(p.trim),door:M(p.door),accent:M(p.accent),wood:M(p.door),gold:M(0xc7a75f),metal:M(0x303638),
  concrete:M(0xa9a79e),grass:M(0x4d7040),green:M(0x2d713d),
  glass:new THREE.MeshPhongMaterial({color:0x4c8193,transparent:true,opacity:.82,shininess:75,side:THREE.DoubleSide}),
  darkGlass:new THREE.MeshPhongMaterial({color:0x263841,transparent:true,opacity:.88,shininess:80,side:THREE.DoubleSide})
 });
}
function houseGable(w,d,rise){const shape=new THREE.Shape();shape.moveTo(-w/2,0);shape.lineTo(w/2,0);shape.lineTo(0,rise);shape.closePath();const geo=new THREE.ExtrudeGeometry(shape,{depth:d,bevelEnabled:false});geo.translate(0,0,-d/2);return geo;}
function houseFrontWindow(A,m,x,y,z,w,h){
 A(new THREE.BoxGeometry(w+.16,h+.16,.13),m.trim,x,y,z);
 A(new THREE.BoxGeometry(w,h,.07),m.glass,x,y,z+.075);
 A(new THREE.BoxGeometry(.055,h,.1),m.metal,x,y,z+.115);
 A(new THREE.BoxGeometry(w,.055,.1),m.metal,x,y,z+.115);
 A(new THREE.BoxGeometry(w+.3,.12,.2),m.accent,x,y+h/2+.09,z+.025);
 A(new THREE.BoxGeometry(w+.3,.12,.2),m.trim,x,y-h/2-.09,z+.04);
 A(new THREE.BoxGeometry(.1,h+.25,.18),m.trim,x-w/2-.1,y,z);
 A(new THREE.BoxGeometry(.1,h+.25,.18),m.trim,x+w/2+.1,y,z);
}
function houseSideWindow(A,m,x,y,z,w,h,side){
 A(new THREE.BoxGeometry(.13,h+.16,w+.16),m.trim,x,y,z);
 A(new THREE.BoxGeometry(.06,h,w),m.glass,x+side*.08,y,z);
 A(new THREE.BoxGeometry(.15,.05,w),m.metal,x+side*.12,y,z);
 A(new THREE.BoxGeometry(.15,h,.05),m.metal,x+side*.12,y,z);
}
function houseDoor(A,m,x,y,z,w,h,doubleDoor=false){
 A(new THREE.BoxGeometry(w+.34,h+.35,.22),m.trim,x,y,z);
 A(new THREE.BoxGeometry(w,h,.14),m.door,x,y,z+.09);
 const n=doubleDoor?2:1;
 for(let k=0;k<n;k++){const dx=x+(k-(n-1)/2)*w*.48;
  A(new THREE.BoxGeometry(w*.34,h*.48,.035),m.wood,dx,y+.28,z+.17);
  A(new THREE.BoxGeometry(w*.34,.055,.04),m.gold,dx,y+.28+h*.24,z+.17);
 }
 A(new THREE.SphereGeometry(.055,10,8),m.gold,x+w*.31,y-.05,z+.18);
}
/* every piece of a house is collected, then merged into one mesh per material (a handful of draw calls per house) */
function houseMerge(g,recs){
 const by=new Map();
 recs.forEach(r=>{r.o.updateMatrix();const geo=r.geo.index?r.geo.toNonIndexed():r.geo.clone();geo.applyMatrix4(r.o.matrix);
  let e=by.get(r.mat);if(!e){e={p:[],n:[],u:[]};by.set(r.mat,e);}
  e.p.push(geo.attributes.position.array);e.n.push(geo.attributes.normal.array);e.u.push(geo.attributes.uv?geo.attributes.uv.array:new Float32Array(geo.attributes.position.count*2));
  geo.dispose();r.geo.dispose();});
 const cat=a=>{let n=0;a.forEach(x=>n+=x.length);const o=new Float32Array(n);let i=0;a.forEach(x=>{o.set(x,i);i+=x.length;});return o;};
 by.forEach((e,mat)=>{const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.BufferAttribute(cat(e.p),3));geo.setAttribute('normal',new THREE.BufferAttribute(cat(e.n),3));geo.setAttribute('uv',new THREE.BufferAttribute(cat(e.u),2));const mesh=new THREE.Mesh(geo,mat);mesh.frustumCulled=false;mesh.visible=true;g.add(mesh);});
}
function paintHousePlaque(ctx,ww,hh,h){
 const cls=h.cls||"flat";ctx.clearRect(0,0,ww,hh);
 const gr=ctx.createLinearGradient(0,0,0,hh);gr.addColorStop(0,"#14463a");gr.addColorStop(1,"#0b2a22");ctx.fillStyle=gr;ctx.fillRect(0,0,ww,hh);
 ctx.strokeStyle="#d8b865";ctx.lineWidth=6;ctx.strokeRect(4,4,ww-8,hh-8);ctx.strokeStyle="rgba(216,184,101,.45)";ctx.lineWidth=2;ctx.strokeRect(13,13,ww-26,hh-26);
 ctx.textAlign="center";ctx.fillStyle="#d8b865";ctx.font="bold 17px system-ui";ctx.fillText("NRS HOMES",ww/2,33);
 ctx.fillStyle="#fff7e0";ctx.font="bold 34px system-ui";ctx.fillText(HOUSE_LABELS[cls]||"HOME",ww/2,69);
 ctx.fillStyle="#cfe3d8";ctx.font="bold 21px system-ui";ctx.fillText(String(h.id||"").toUpperCase()+" · ₦"+Number(h.rentPerDay||0).toLocaleString()+"/DAY",ww/2,96);
 ctx.font="bold 18px system-ui";ctx.fillStyle=h.occupiedByMe?"#8fd3ff":h.vacant?"#84efb1":"#f0b4a6";ctx.fillText(h.occupiedByMe?"YOUR HOME":h.vacant?"AVAILABLE":"OCCUPIED",ww/2,118);
}
function refreshHousePlaque(v,h){const texture=v?.plaque,image=texture?.image,ctx=image?.getContext?.("2d");if(!ctx)return;paintHousePlaque(ctx,image.width,image.height,h);texture.needsUpdate=true;}
/* ---------- House exteriors: one builder per class. Each returns where the nameplate hangs. ---------- */
const HOUSE_BUILDERS={
/* 1. VILLAGE HUT: round mud-plastered hut under a layered palm-thatch cone, timber porch, woven-stake yard */
hut(K){const {A,m,S,B,C,w,front,Y,H}=K,r=w*.45,zD=r+.1,T=S.thatch;
 C(r+.45,r+.55,.3,S.mud,0,.15,0,18);
 C(r,r+.02,H,m.wall,0,Y+H/2,0,18);
 C(r+.03,r+.06,.5,S.ochre,0,Y+.25,0,18);
 for(let i=0;i<14;i++){const a=i*Math.PI*2/14,o=B(.34,.2,.07,m.trim,Math.sin(a)*(r+.05),Y+H-.5,Math.cos(a)*(r+.05));o.rotation.y=a;}
 A(new THREE.ConeGeometry(r+1.2,2.7,20),T,0,Y+H+1.25,0);
 A(new THREE.CylinderGeometry(r+1.22,r+1.22,.16,20,1,true),T,0,Y+H-.1,0);
 for(let i=0;i<40;i++){const a=i*Math.PI*2/40;B(.07,.55,.07,T,Math.sin(a)*(r+1.15),Y+H-.35,Math.cos(a)*(r+1.15));}
 C(.1,.14,.5,S.mud,0,Y+H+2.65,0,8);K.S_(.18,S.mud,0,Y+H+3,0);
 houseDoor(A,m,0,Y+1.0,zD,1.0,2.0);
 const pz=r+1.15;[-1,1].forEach(s=>C(.09,.1,2.5,S.woodDark,s*1.2,Y+1.25,pz,8));
 [-1,1].forEach(s=>{const o=B(1.5,.12,2.0,T,s*.62,Y+2.75,pz-.15);o.rotation.z=s*-.5;});
 B(2.9,.12,.18,S.woodDark,0,Y+2.38,pz+.85);
 [-1,1].forEach(s=>{const a=s*.95,px=Math.sin(a)*(r+.04),pz2=Math.cos(a)*(r+.04),cx=Math.cos(a),sx=Math.sin(a);
  const f=B(.66,.76,.12,m.trim,px,Y+1.4,pz2);f.rotation.y=a;
  const gl=B(.5,.6,.06,m.darkGlass,Math.sin(a)*(r+.08),Y+1.4,Math.cos(a)*(r+.08));gl.rotation.y=a;
  [-1,1].forEach(q=>{const sh=B(.26,.62,.05,S.woodLight,px+cx*q*.4+sx*.06,Y+1.4,pz2-sx*q*.4+cx*.06);sh.rotation.y=a;});});
 // yard props: clay pots, firewood, stool, drying rack, banana plant
 [[-1.7,pz+.5,.26],[1.9,pz+.7,.2],[2.2,pz+.2,.16]].forEach(p=>{C(p[2],p[2]*.7,p[2]*1.6,S.clay,p[0],Y+p[2]*.8,p[1],10);K.S_(p[2]*.75,S.clay,p[0],Y+p[2]*1.7,p[1],1,.55,1);});
 for(let i=0;i<5;i++){const o=C(.1,.1,.9,S.woodDark,-2.5,Y+.1+(i>2?.17:0),pz+.2+(i%3)*.2-(i>2?.1:0),7);o.rotation.z=Math.PI/2;}
 C(.2,.2,.38,S.woodLight,1.6,Y+.19,pz+1.3,10);
 [-1,1].forEach(s=>C(.04,.05,2.2,S.woodDark,s*1.7,Y+1.1,-.2,6));B(3.4,.03,.03,S.white,0,Y+2.1,-.2);
 for(let i=0;i<4;i++)B(.4,.6,.02,S.cloth[i%4],-1.2+i*.8,Y+1.8,-.2);
 [[-2.6,pz+1.3],[2.8,pz+1.2]].forEach(p=>{B(.45,.05,.45,S.white,p[0],Y+.5,p[1]);B(.45,.5,.05,S.white,p[0],Y+.78,p[1]-.2);});
 C(.34,.34,.9,S.blue,5.0,Y+.45,pz+1.35,12);
 [[-1,-1],[1,-1],[-1,1],[1,1]].forEach(p=>C(.05,.05,1.0,S.steel,2.6+p[0]*.6,Y+H+.75,-1.0+p[1]*.6,6));
 B(1.6,.08,1.6,S.steel,2.6,Y+H+1.28,-1.0);C(.62,.62,1.2,S.black,2.6,Y+H+1.95,-1.0,12);
 C(.025,.025,2.2,m.metal,-3.5,Y+H+1.3,0,5);B(1.1,.03,.03,m.metal,-3.5,Y+H+2.0,0);B(.8,.03,.03,m.metal,-3.5,Y+H+1.65,0);
 const dish=K.S_(.4,S.white,-1.7,Y+H+.95,0,1,.35,1);dish.rotation.x=-.9;
 // shared plot gate
 [-1,1].forEach(s=>{B(.4,1.5,.4,S.stoneDk,s*1.5,.75,front+4.8);});B(2.6,.08,.06,m.trim,0,1.3,front+4.8);B(2.6,.08,.06,m.trim,0,.55,front+4.8);
 for(let i=0;i<9;i++)C(.025,.025,.8,m.trim,-1.12+i*.28,.95,front+4.8,5);
 B(5.2,.12,3.2,m.concrete,0,.13,front+3.2);
 return {x:-3.4,y:Y+3.25,z:front+.62,w:3.9};
},
/* 2. COMPOUND ROOMS (face-me-I-face-you): two rows of rooms facing a shared passage, zinc roofs, veranda */
faceme(K){const {A,m,S,B,C,w,d,H,front,Y}=K,zr=front-1.7,rr=-2.55;
 const row=[-4.2,-2.1,2.1,4.2];
 B(4.2,H,3.4,m.wall,-3.15,Y+H/2,zr);B(4.2,H,3.4,m.wall,3.15,Y+H/2,zr);B(w,H,3.4,m.wall,0,Y+H/2,rr);
