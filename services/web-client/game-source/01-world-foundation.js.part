// Add a private lane from each residential block entrance to a real street edge.
// These are additive surfaces only; HR, VR and every roundabout remain unchanged.
function addApartmentAccessLanes(){
 for(const b of bld){
  if((!b.gen&&!b.apartmentCandidate)||!Number.isFinite(Number(b.h))||b.h<5||b.hw<4||b.hd<4)continue;
  const axis=b.entryAxis||'x',sign=b.entrySign||1;
  const road=b.accessRoad||chooseApartmentEntrance(b.x,b.z,b.hw*2,b.hd*2,axis,sign).accessRoad;
  if(!road||((axis==='z')!==(road.axis==='h')))continue;
  if(axis==='z'){
   const start=b.z+sign*(b.hd+1.45),end=road.fixed-sign*road.half,len=Math.abs(end-start);
   if(len<.65)continue;
   const mid=(start+end)/2;
   flatW(3.1,len,asphalt2,b.x,.058,mid,6);
   flatW(.10,len,curb,b.x-1.62,.09,mid,4);flatW(.10,len,curb,b.x+1.62,.09,mid,4);
   flatW(.78,len,swm,b.x-2.12,.066,mid,4);flatW(.78,len,swm,b.x+2.12,.066,mid,4);
  }else{
   const start=b.x+sign*(b.hw+1.45),end=road.fixed-sign*road.half,len=Math.abs(end-start);
   if(len<.65)continue;
   const mid=(start+end)/2;
   flatW(len,3.1,asphalt2,mid,.058,b.z,6);
   flatW(len,.10,curb,mid,.09,b.z-1.62,4);flatW(len,.10,curb,mid,.09,b.z+1.62,4);
   flatW(len,.78,swm,mid,.066,b.z-2.12,4);flatW(len,.78,swm,mid,.066,b.z+2.12,4);
  }
 }
}
addApartmentAccessLanes();
