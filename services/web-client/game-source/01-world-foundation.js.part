  const label=(HOUSE_LABELS[h.cls]||"home").toLowerCase();
  POI.push({x:door.x,z:door.z,k:"Enter",
   name:h.occupiedByMe?"Enter your "+label:"Inspect "+(h.name||label),
   t:"home",housePoi:true,houseId:h.id,house:h,r:3.2});
