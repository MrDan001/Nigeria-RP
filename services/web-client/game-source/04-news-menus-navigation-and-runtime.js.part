 pos.set(Number(d.x??0),0,Number(d.z??24));vel.set(0,0,0);jv=0;face=Number.isFinite(d.yaw)?Number(d.yaw):0;camYaw=Math.PI;camPitch=.28;
 focus.set(pos.x,1.4,pos.z);player.position.copy(pos);model.rotation.y=face;shadow.position.set(pos.x,.04,pos.z);shadow.visible=true;curPoi=null;act2.style.display='none';modal.style.display='none';modal.innerHTML='';sys(d.message||'You are back outside the workplace.');routeTransitionOut();});
