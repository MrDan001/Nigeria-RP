 inside=r;pos.set(Number(d.x??r.x),0,Number(d.z??r.z+3.2));vel.set(0,0,0);jv=0;face=Math.PI;camYaw=0;camPitch=.3;
 focus.set(pos.x,1.4,pos.z);player.position.copy(pos);model.rotation.y=face;shadow.position.set(pos.x,.04,pos.z);shadow.visible=true;
 modal.style.display='none';modal.innerHTML='';curPoi=null;act2.style.display='none';if(MP.open)closeMap();plShow(false);sys(d.message||('Welcome inside '+r.name+'.'));routeTransitionOut();
});
